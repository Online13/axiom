{
	"name": "axiom-project",
	"devDependencies": {
		"eslint": "^9.0.0",
		"eslint-config-expo": "~57.0.2",
		"prettier": "^3.9.8",
		"wrangler": "^4.131.2"
	},
	"private": true,
	"scripts": {
		"web": "bun run --cwd apps/web",
		"demo:stylesheet": "bun run --cwd apps/demo-stylesheet",
		"demo:unistyles": "bun run --cwd apps/demo-unistyles",
		"demo:nativewind": "bun run --cwd apps/demo-nativewind",
		"demo:uniwind": "bun run --cwd apps/demo-uniwind",
		"example:noty": "bun run --cwd examples/noty",
		"sim:ios": "node scripts/native-sim.mjs",
		"format": "prettier --write .",
		"lint": "eslint ."
	},
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*",
			"examples/*"
		],
		"catalog": {
			"react": "19.2.3",
			"react-dom": "19.2.3",
			"@types/react": "~19.2.2",
			"@types/react-dom": "~19.2.2"
		}
	}
}
