{
	"name": "@axiom/registry",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Source of every item Axiom can copy into a project",
	"scripts": {
		"tsconfig": "bun scripts/tsconfig.ts",
		"standalone": "bun scripts/standalone.ts",
		"theme-css": "bun scripts/tsconfig.ts && bun --tsconfig-override tsconfig.stylesheet.json scripts/theme-css.ts",
		"typecheck": "bun scripts/tsconfig.ts && bun scripts/standalone.ts && bun scripts/typecheck.ts",
		"parity": "bun scripts/tsconfig.ts && bun scripts/parity.ts"
	},
	"devDependencies": {
		"@react-navigation/native": "^7.4.1",
		"nativewind": "^4.2.7",
		"react-native-unistyles": "^3.3.0",
		"tailwind-merge": "^3.7.0",
		"typescript": "~6.0.3",
		"uniwind": "^1.12.2"
	}
}
