{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "axiom-theme-builder",
	"workers_dev": false,
	"compatibility_date": "2026-09-20",
	"assets": {
		"directory": "./dist",
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true,
		},
	},
}
