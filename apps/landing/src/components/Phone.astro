---
// CSS device frame. Everything inside the screen is sized in `em`, and the
// screen font-size follows the frame width, so content scales with the phone.
interface Props {
	class?: string;
	dark?: boolean;
	label?: string;
}

const { class: className, dark = false, label } = Astro.props;
---

<div class:list={['phone', className, { 'phone--dark': dark }]} role={label ? 'img' : undefined} aria-label={label}>
	<div class="phone__screen">
		<div class="phone__status" aria-hidden="true">
			<span>9:41</span>
			<i class="phone__island"></i>
			<span class="phone__icons">
				<b></b><b></b><b></b>
				<em></em>
			</span>
		</div>
		<div class="phone__content">
			<slot />
		</div>
		<i class="phone__home" aria-hidden="true"></i>
	</div>
</div>

<style>
	.phone {
		--accent: #ff5a1f;
		--s-bg: #f4f4f2;
		--s-surface: #ffffff;
		--s-fg: #111111;
		--s-muted: #8a8a8a;
		--s-line: #ececea;

		container-type: inline-size;
		position: relative;
		height: 100%;
		aspect-ratio: 9 / 19.5;
		max-width: 100%;
		padding: 3.6%;
		border-radius: 13% / 6%;
		background: linear-gradient(135deg, #2e2e2e, #151515 50%, #262626);
		box-shadow:
			inset 0 0 0 1px #3a3a3a,
			0 40px 80px -30px rgb(0 0 0 / 0.8);
	}

	.phone--dark {
		--s-bg: #0e0e0e;
		--s-surface: #1a1a1a;
		--s-fg: #f5f5f5;
		--s-muted: #7a7a7a;
		--s-line: #262626;
	}

	.phone__screen {
		position: relative;
		height: 100%;
		overflow: hidden;
		border-radius: 10.5% / 4.9%;
		background: var(--s-bg);
		color: var(--s-fg);
		font-family: var(--font-sans);
		font-size: 4.2cqw;
		line-height: 1.3;
		display: flex;
		flex-direction: column;
		text-align: left;
	}

	.phone__status {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 3.4em;
		padding: 0 1.9em 0 2.2em;
		font-size: 0.85em;
		font-weight: 600;
	}

	.phone__island {
		width: 7.4em;
		height: 2.1em;
		border-radius: 999px;
		background: #0a0a0a;
	}

	.phone__icons {
		display: flex;
		align-items: flex-end;
		gap: 0.18em;
	}

	.phone__icons b {
		width: 0.24em;
		border-radius: 0.1em;
		background: currentColor;
	}
	.phone__icons b:nth-child(1) { height: 0.35em; }
	.phone__icons b:nth-child(2) { height: 0.55em; }
	.phone__icons b:nth-child(3) { height: 0.75em; }

	.phone__icons em {
		width: 1.6em;
		height: 0.8em;
		margin-left: 0.3em;
		border-radius: 0.25em;
		border: 1px solid color-mix(in srgb, currentColor 45%, transparent);
		box-shadow: inset 0 0 0 0.12em var(--s-bg), inset 1.1em 0 0 currentColor;
	}

	.phone__content {
		position: relative;
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	.phone__home {
		position: absolute;
		left: 50%;
		bottom: 0.6em;
		width: 9em;
		height: 0.32em;
		border-radius: 999px;
		background: var(--s-fg);
		transform: translateX(-50%);
		z-index: 5;
	}
</style>
