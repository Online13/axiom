---
import { docs, githubUrl } from '../../lib/links';

const links = [
	{ label: 'Docs', href: docs() },
	{ label: 'Registry', href: '#registry' },
];
---

<footer class="section section--solid footer">
	<div class="container footer__inner">
		<a href="/" class="footer__logo">AXIOM</a>
		<nav class="footer__links">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
			<a href={githubUrl} class="footer__github" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
				</svg>
			</a>
		</nav>
		<p class="eyebrow footer__meta">MIT License · {new Date().getFullYear()}</p>
	</div>
</footer>

<style>
	.footer {
		min-height: 260px;
		display: flex;
		align-items: flex-end;
		padding-block: 3rem;
	}

	.footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
	}

	.footer__logo {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 0.8;
	}

	.footer__links {
		display: flex;
		align-items: center;
		gap: 2rem;
		margin-left: auto;
		color: var(--muted);
	}

	.footer__github svg {
		display: block;
		width: 1.25rem;
		height: 1.25rem;
		fill: currentColor;
	}

	.footer__links a:hover {
		color: var(--fg);
	}
</style>
