---
const styling = ["StyleSheet", "Unistyles", "NativeWind", "Uniwind"];

// The same Button in every styling variant (see docs/architecture/styling.md).
// NativeWind and Uniwind share the tailwind code; only their setup differs.
const stylesheet = `import { StyleSheet } from 'react-native';
import { Text } from 'react-native';
import { Tappable } from '@/components/core/tappable';
import { useTheme } from '@/theme';

export function Button({ label, variant = 'solid', ...props }: ButtonProps) {
  const { components } = useTheme();
  return (
    <Tappable style={[styles.base, components.button[variant].container]} {...props}>
      <Text style={[styles.label, components.button[variant].label]}>{label}</Text>
    </Tappable>
  );
}

const styles = StyleSheet.create({
  base: { minHeight: 44, paddingHorizontal: 16, borderRadius: 12 },
  label: { fontSize: 16, fontWeight: '600' },
});`;

const unistyles = `import { StyleSheet } from 'react-native-unistyles';
import { Text } from 'react-native';
import { Tappable } from '@/components/core/tappable';

export function Button({ label, variant = 'solid', ...props }: ButtonProps) {
  styles.useVariants({ variant });
  return (
    <Tappable style={styles.base} {...props}>
      <Text style={styles.label}>{label}</Text>
    </Tappable>
  );
}

const styles = StyleSheet.create((theme) => ({
  base: {
    minHeight: 44, paddingHorizontal: theme.space[4], borderRadius: theme.radius.md,
    variants: { variant: theme.components.button.container },
  },
  label: { ...theme.type.label, variants: { variant: theme.components.button.label } },
}));`;

const tailwind = `import { tv } from 'tailwind-variants';
import { Text } from 'react-native';
import { Tappable } from '@/components/core/tappable';

const button = tv({
  slots: { base: 'min-h-11 rounded-xl px-4', label: 'text-base font-semibold' },
  variants: { variant: { solid: { base: 'bg-primary', label: 'text-on-primary' } } },
});

export function Button({ label, variant = 'solid', ...props }: ButtonProps) {
  const styles = button({ variant });
  return (
    <Tappable className={styles.base()} {...props}>
      <Text className={styles.label()}>{label}</Text>
    </Tappable>
  );
}`;

const variants = [
	{
		id: "stylesheet",
		label: "StyleSheet",
		code: stylesheet,
		note: "No dependency. Theme through useTheme().",
		soon: false,
	},
	{
		id: "unistyles",
		label: "Unistyles",
		code: unistyles,
		note: "Adaptive themes and native variants.",
		soon: true,
	},
	{
		id: "nativewind",
		label: "NativeWind",
		code: tailwind,
		note: "Tokens exposed to your Tailwind config.",
		soon: true,
	},
	{
		id: "uniwind",
		label: "Uniwind",
		code: tailwind,
		note: "The same classes with a different setup.",
		soon: true,
	},
] as const;

const ownership = [
	{ kind: "Package", from: "node_modules", to: "black box" },
	{ kind: "Axiom", from: "your repo", to: "your code" },
];

// A line is "shared" when every variant contains it: that is the behavior Axiom keeps identical.
const sets = [stylesheet, unistyles, tailwind].map(
	(code) => new Set(code.split("\n").map((l) => l.trim())),
);
const isShared = (line: string) =>
	line.trim() !== "" && sets.every((set) => set.has(line.trim()));
---

<article class="bento__card bento__ownership">
	<!-- <ul class="styling" aria-label="Styling options"></ul> -->
	<!-- <p class="bento__note">
		Edit the installed files like the rest of your app. There is no hidden
		package implementation.
	</p> -->

	<div class="code__container">
		<div class="code">
			<div class="code__bar">
				<span class="code__file">components/ui/button.tsx</span>
				<span class="code__legend" aria-hidden="true">
					<i class="is-shared"></i> shared <i></i> styling
				</span>
			</div>
			{
				variants.map((variant, i) => (
					<div
						class="code__panel"
						role="tabpanel"
						id={`ownership-style-panel-${variant.id}`}
						aria-labelledby={`ownership-style-tab-${variant.id}`}
						hidden={i !== 0}
					>
						<!-- prettier-ignore -->
						<pre><code>{variant.code.split('\n').map((line) => (
							<span class:list={['code__line', { 'is-shared': isShared(line), 'is-empty': line.trim() === '' }]}>{line || ' '}</span>
						))}</code></pre>
						<p class="code__note">{variant.note}</p>
					</div>
				))
			}
		</div>
	</div>
	<header>
		<p class="eyebrow">Ownership</p>
		<h3>Your code. Your styling.</h3>
		<p class="subtitle">
			Axiom copies each component into your app. The source and styling stay
			yours.
		</p>

		<dl class="styling__own">
			{
				ownership.map((row) => (
					<div class:list={{ "is-axiom": row.kind === "Axiom" }}>
						<dt>{row.kind}</dt>
						<dd>
							{row.from} <span aria-hidden="true">→</span> {row.to}
						</dd>
					</div>
				))
			}
		</dl>

		<div class="prompt">
			<p class="prompt__cmd"><span aria-hidden="true">$</span> npx axiom init</p>
			<p class="prompt__question" id="ownership-styling-question">
				<span aria-hidden="true">?</span> Styling
			</p>
			<div
				class="prompt__options"
				role="tablist"
				aria-labelledby="ownership-styling-question"
			>
				{
					variants.map((variant, i) => (
						<button
							type="button"
							role="tab"
							class="prompt__option"
							id={`ownership-style-tab-${variant.id}`}
							aria-controls={`ownership-style-panel-${variant.id}`}
							aria-selected={i === 0 ? "true" : "false"}
							tabindex={i === 0 ? 0 : -1}
						>
							<span class="prompt__cursor" aria-hidden="true">›</span>
							{variant.label}
							{variant.soon && <small>soon</small>}
						</button>
					))
				}
			</div>
		</div>
	</header>
</article>

<script>
	const root = document.querySelector<HTMLElement>(".bento__ownership");

	if (root) {
		const tabs = [
			...root.querySelectorAll<HTMLButtonElement>(".prompt__option"),
		];
		const panels = root.querySelectorAll<HTMLElement>('[role="tabpanel"]');

		function select(tab: HTMLButtonElement) {
			tabs.forEach((item) => {
				const selected = item === tab;
				item.setAttribute("aria-selected", String(selected));
				item.tabIndex = selected ? 0 : -1;
			});
			panels.forEach(
				(panel) =>
					(panel.hidden = panel.id !== tab.getAttribute("aria-controls")),
			);
		}

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => select(tab));
			tab.addEventListener("keydown", (event) => {
				const offset = {
					ArrowDown: 1,
					ArrowRight: 1,
					ArrowUp: -1,
					ArrowLeft: -1,
				}[event.key];
				const target =
					event.key === "Home"
						? 0
						: event.key === "End"
							? tabs.length - 1
							: offset
								? (index + offset + tabs.length) % tabs.length
								: -1;
				if (target < 0) return;
				event.preventDefault();
				select(tabs[target]);
				tabs[target].focus();
			});
		});
	}
</script>
<style>
	.bento__ownership {
		grid-area: ownership;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		align-content: start;
		gap: 4rem;
		padding: clamp(2rem, 4vw, 3.5rem);
	}
	.bento__ownership header {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.styling {
		margin-top: 0;
	}
	.styling {
		position: relative;
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.styling li {
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--line);
		font-size: 0.78rem;
		color: var(--muted);
	}

	.styling__own {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.styling__own div {
		display: grid;
		grid-template-columns: minmax(4rem, 5rem) minmax(0, 1fr);
		gap: 1rem;
	}

	.styling__own dd {
		margin: 0;
		overflow-wrap: anywhere;
	}

	.styling__own dd span {
		color: var(--line);
	}

	.styling__own .is-axiom {
		color: var(--fg);
	}

	.prompt {
		width: 100%;
		max-width: 22rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--line);
		background: var(--bg);
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}

	.prompt__cmd span,
	.prompt__question span {
		color: var(--muted);
	}

	.prompt__question {
		margin-top: 0.5rem;
	}

	.prompt__options {
		display: flex;
		flex-direction: column;
		margin-top: 0.25rem;
	}

	.prompt__option {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.2rem 0;
		background: none;
		border: 0;
		color: var(--muted);
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: color 0.2s;
	}

	.prompt__option:hover,
	.prompt__option[aria-selected="true"] {
		color: var(--fg);
	}

	.prompt__option:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}

	.prompt__cursor {
		width: 1ch;
		opacity: 0;
		color: #ff5a1f;
	}

	.prompt__option[aria-selected="true"] .prompt__cursor {
		opacity: 1;
	}

	.prompt__option small {
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--line);
	}

	/* Code window */
	.code__container {
		min-width: 0;
		width: 100%;
		position: relative;
		grid-column-start: 1;
		grid-column-end: 3;
	}

	.code {
		min-width: 0;
		width: 100%;
		border: 1px solid var(--line);
		background: var(--bg);
	}

	.code__bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding: 0.75rem 1.25rem;
		border-bottom: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
	}

	.code__legend {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.code__legend i {
		width: 2px;
		height: 0.8rem;
		margin-left: 0.5rem;
		background: #ff5a1f;
	}

	.code__legend i.is-shared {
		margin-left: 0;
		background: var(--line);
	}

	.code__panel {
		width: 100%;
	}

	.code__panel pre {
		margin: 0;
		padding: 1rem 0;
		overflow-x: auto;
		width: 100%;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.7;
	}

	.code__panel code {
		display: grid;
		width: 100%;
		min-width: max-content;
		counter-reset: line;
	}

	.code__line {
		width: 100%;
		padding: 0 1.25rem 0 0;
		border-left: 2px solid #ff5a1f;
		color: var(--fg);
		white-space: pre;
		counter-increment: line;
	}

	.code__line::before {
		content: counter(line);
		display: inline-block;
		width: 3rem;
		padding-right: 1.25rem;
		text-align: right;
		color: var(--line);
	}

	.code__line.is-shared {
		border-left-color: var(--line);
		color: var(--muted);
	}

	.code__line.is-empty {
		border-left-color: transparent;
	}

	.code__note {
		padding: 0.75rem 1.25rem;
		border-top: 1px solid var(--line);
		font-size: 0.85rem;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.bento__ownership {
			grid-template-columns: minmax(0, 1fr);
		}

		.bento__ownership header {
			order: -1;
			grid-column: 1;
		}

		.prompt {
			max-width: 26rem;
		}
	}

	@media (max-width: 600px) {
		.code__bar,
		.code__note {
			padding-inline: 1rem;
		}

		.code__panel pre {
			font-size: 0.72rem;
		}

		.code__line {
			padding-right: 1rem;
		}

		.code__line::before {
			width: 2.5rem;
			padding-right: 1rem;
		}
	}
</style>
