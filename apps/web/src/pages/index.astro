---
import Base from '@landing/layouts/Base.astro';
import Nav from '@landing/components/sections/Nav.astro';
import Hero from '@landing/components/sections/Hero.astro';
import Experience from '@landing/components/sections/Experience.astro';
import Principle from '@landing/components/sections/Principle.astro';
import System from '@landing/components/sections/System.astro';
import ThemeBuilder from '@landing/components/sections/ThemeBuilder.astro';
import Mobile from '@landing/components/sections/Mobile.astro';
import Platform from '@landing/components/sections/Platform.astro';
import OpenSource from '@landing/components/sections/OpenSource.astro';
import Inspirations from '@landing/components/sections/Inspirations.astro';
import Footer from '@landing/components/sections/Footer.astro';
import Bento from '@landing/components/sections/bento/Bento.astro';
import { githubUrl } from '@landing/lib/links';

const site = Astro.site!.href;
const jsonLd = {
	'@graph': [
		{ '@type': 'WebSite', name: 'Axiom', url: site },
		{
			'@type': 'SoftwareSourceCode',
			name: 'Axiom',
			description: 'A mobile-first component registry for React Native & Expo. Copy the source, own the code.',
			url: site,
			codeRepository: githubUrl,
			programmingLanguage: 'TypeScript',
			runtimePlatform: ['React Native', 'Expo'],
			license: 'https://opensource.org/licenses/MIT',
		},
	],
};
---

<Base jsonLd={jsonLd}>
	<Nav />
	<main>
		<Hero />
		<Platform />
		<Bento />
		<Experience />
		<Principle />
		<System />
		<ThemeBuilder />
		<Mobile />
		<OpenSource />
		<Inspirations />
	</main>
	<Footer />
</Base>

<script>
	// Fades each section below the hero in the first time it scrolls into view.
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const sections = document.querySelectorAll<HTMLElement>('main > section:not(.hero)');
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.setAttribute('data-reveal', 'shown');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		for (const section of sections) {
			section.setAttribute('data-reveal', 'hidden');
			observer.observe(section);
		}
	}
</script>

<style is:global>
	[data-reveal] {
		transition:
			opacity 0.8s ease,
			translate 0.8s cubic-bezier(0.22, 1, 0.36, 1);
	}

	[data-reveal='hidden'] {
		opacity: 0;
		translate: 0 24px;
	}
</style>
