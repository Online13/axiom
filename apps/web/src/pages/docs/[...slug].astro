---
import { render, type CollectionEntry } from "astro:content";
import { Docs } from "@docs/components/docs";
import defaultMdxComponents from "fumadocs-ui/mdx";
import CodeBlockTabs from "@docs/components/code-block-tabs/code-block-tabs.astro";
import CodeBlockTabsList from "@docs/components/code-block-tabs/code-block-tabs-list.astro";
import CodeBlockTabsTrigger from "@docs/components/code-block-tabs/code-block-tabs-trigger.astro";
import CodeBlockTab from "@docs/components/code-block-tabs/code-block-tab.astro";
import PaletteGrid from "@docs/components/tokens/palette-grid.astro";
import SpacingScale from "@docs/components/tokens/spacing-scale.astro";
import RadiusScale from "@docs/components/tokens/radius-scale.astro";
import TypeScale from "@docs/components/tokens/type-scale.astro";
import SizesScale from "@docs/components/tokens/sizes-scale.astro";
import MetricsPreview from "@docs/components/tokens/metrics-preview.astro";
import ColorRoleTable from "@docs/components/tokens/color-role-table.astro";
import RolePreview from "@docs/components/tokens/role-preview.astro";
import TokenChain from "@docs/components/tokens/token-chain.astro";
import ThemeLayers from "@docs/components/tokens/theme-layers.astro";
import ComponentTokenPath from "@docs/components/tokens/component-token-path.astro";
import ComponentTokenPreview from "@docs/components/tokens/component-token-preview.astro";
import ComponentTokenTable from "@docs/components/tokens/component-token-table.astro";
import OverlayPreview from "@docs/components/overlay/overlay-preview.astro";
import OverlayLayers from "@docs/components/overlay/overlay-layers.astro";
import AtomGrid from "@docs/components/atoms/atom-grid.astro";
import BehaviorGrid from "@docs/components/behaviors/behavior-grid.astro";
import BehaviorCard from "@docs/components/behaviors/behavior-card.astro";
import PatternGrid from "@docs/components/patterns/pattern-grid.astro";
import PatternCard from "@docs/components/patterns/pattern-card.astro";
import AtomCard from "@docs/components/atoms/atom-card.astro";
import ComponentGrid from "@docs/components/catalog/component-grid.astro";
import ComponentCard from "@docs/components/catalog/component-card.astro";
import TappablePreview from "@docs/components/tappable/tappable-preview.astro";
import TappableHitSlop from "@docs/components/tappable/tappable-hit-slop.astro";
import RefreshControlPreview from "@docs/components/refresh-control/refresh-control-preview.astro";
import RefreshControlStates from "@docs/components/refresh-control/refresh-control-states.astro";
import RefreshControlResistance from "@docs/components/refresh-control/refresh-control-resistance.astro";
import HideOnScrollStates from "@docs/components/hide-on-scroll/hide-on-scroll-states.astro";
import CollapsibleHeaderStates from "@docs/components/collapsible-header/collapsible-header-states.astro";
import HideOnScrollPreview from "@docs/components/hide-on-scroll/hide-on-scroll-preview.astro";
import CollapsibleHeaderPreview from "@docs/components/collapsible-header/collapsible-header-preview.astro";
import ScrollToTopPreview from "@docs/components/scroll-to-top/scroll-to-top-preview.astro";
import ScrollAwareAppBarPreview from "@docs/components/scroll-aware-app-bar/scroll-aware-app-bar-preview.astro";
import LongPressPreview from "@docs/components/long-press/long-press-preview.astro";
import LongPressTimeline from "@docs/components/long-press/long-press-timeline.astro";
import SwipeActionsPreview from "@docs/components/swipe-actions/swipe-actions-preview.astro";
import SwipeActionsStates from "@docs/components/swipe-actions/swipe-actions-states.astro";
import FullSwipePreview from "@docs/components/full-swipe/full-swipe-preview.astro";
import FullSwipeStates from "@docs/components/full-swipe/full-swipe-states.astro";
import DragToReorderPreview from "@docs/components/drag-to-reorder/drag-to-reorder-preview.astro";
import DragToReorderStates from "@docs/components/drag-to-reorder/drag-to-reorder-states.astro";
import PaginationPreview from "@docs/components/pagination/pagination-preview.astro";
import PaginationStates from "@docs/components/pagination/pagination-states.astro";
import DynamicToolbarPreview from "@docs/components/dynamic-toolbar/dynamic-toolbar-preview.astro";
import DynamicToolbarStates from "@docs/components/dynamic-toolbar/dynamic-toolbar-states.astro";
import OtpVerificationPreview from "@docs/components/otp-verification/otp-verification-preview.astro";
import OtpVerificationStates from "@docs/components/otp-verification/otp-verification-states.astro";
import UndoableActionPreview from "@docs/components/undoable-action/undoable-action-preview.astro";
import UndoableActionStates from "@docs/components/undoable-action/undoable-action-states.astro";
import SearchExperiencePreview from "@docs/components/search-experience/search-experience-preview.astro";
import SearchExperienceStates from "@docs/components/search-experience/search-experience-states.astro";
import SelectionModePreview from "@docs/components/selection-mode/selection-mode-preview.astro";
import SelectionModeStates from "@docs/components/selection-mode/selection-mode-states.astro";
import FloatingActionMenuPreview from "@docs/components/floating-action-menu/floating-action-menu-preview.astro";
import FloatingActionMenuStates from "@docs/components/floating-action-menu/floating-action-menu-states.astro";
import AsyncContentStatePreview from "@docs/components/async-content-state/async-content-state-preview.astro";
import AsyncContentStateStates from "@docs/components/async-content-state/async-content-state-states.astro";
import AsyncContentStateMachine from "@docs/components/async-content-state/async-content-state-machine.astro";
import SwipeActionsMachine from "@docs/components/swipe-actions/swipe-actions-machine.astro";
import PullToRefreshMachine from "@docs/components/refresh-control/pull-to-refresh-machine.astro";
import ScrollToTopMachine from "@docs/components/scroll-to-top/scroll-to-top-machine.astro";
import PaginationMachine from "@docs/components/pagination/pagination-machine.astro";
import UndoableActionMachine from "@docs/components/undoable-action/undoable-action-machine.astro";
import SearchExperienceMachine from "@docs/components/search-experience/search-experience-machine.astro";
import SelectionModeMachine from "@docs/components/selection-mode/selection-mode-machine.astro";
import TabSwipeFrames from "@docs/components/tab/tab-swipe-frames.astro";
import TabSwipeMachine from "@docs/components/tab/tab-swipe-machine.astro";
import PhonePreview from "@docs/components/preview/phone-preview.astro";
import Glyph from "@docs/components/preview/glyph.astro";
import BottomSheetStackFrames from "@docs/components/bottom-sheet/bottom-sheet-stack-frames.astro";
import ScaffoldAnatomy from "@docs/components/scaffold/scaffold-anatomy.astro";
import HapticMap from "@docs/components/haptics/haptic-map.astro";
import HapticKinds from "@docs/components/haptics/haptic-kinds.astro";
import HapticFlow from "@docs/components/haptics/haptic-flow.astro";
import PreviewTheme from "@docs/components/preview/preview-theme.astro";
import AxiomBanner from "@docs/components/intro/axiom-banner.astro";
import ComponentLayers from "@docs/components/intro/component-layers.astro";
import CompositionCatalog from "@docs/components/compositions/composition-catalog.astro";
import CompositionGrid from "@docs/components/compositions/composition-grid.astro";
import ShowcaseGrid from "@docs/components/showcase/showcase-grid.astro";
import ShowcaseCard from "@docs/components/showcase/showcase-card.astro";
import ShowcaseScreens from "@docs/components/showcase/showcase-screens.astro";
import PhaseTimeline from "@docs/components/roadmap/phase-timeline.astro";
import PhaseChecklist from "@docs/components/roadmap/phase-checklist.astro";
import "@docs/styles/global.css";
import "@docs/styles/preview.css";
import { source } from "@docs/lib/source";
import { getPageImageUrl } from "@docs/lib/shared";
import Layout from "@docs/components/layout.astro";
import type { TOCItemType } from "fumadocs-core/toc";

interface Props {
	page: CollectionEntry<"docs">;
}

export async function getStaticPaths() {
	return source.getPages().map((page) => ({
		params: {
			slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined,
		},
		props: { page: page.data._raw },
	}));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const slugs =
	typeof Astro.params.slug === "string" ? Astro.params.slug.split("/") : [];
const docsPage = source.getPage(slugs)!;
const image = getPageImageUrl(docsPage).url;
// Pages that only have frontmatter so far show a placeholder instead of a blank screen.
const isEmpty = !page.body?.trim();
const Callout = defaultMdxComponents.Callout;

const toc: TOCItemType[] = headings.map((heading) => ({
	depth: heading.depth,
	title: heading.text,
	url: "#" + heading.slug,
}));
const publicPathname = Astro.url.pathname;
---

<Layout>
	<PreviewTheme />
	<title>{page.data.title}</title>
	<meta name="title" content={page.data.title} />
	<meta name="description" content={page.data.description} />
	<meta property="og:image" content={image} />
	<Docs
		tree={source.getPageTree()}
		pathname={publicPathname}
		params={Astro.params}
		page={{ toc }}
		client:load
	>
		<h1 class="font-semibold text-3xl">{page.data.title}</h1>
		<p class="text-lg text-fd-muted-foreground mb-8">
			{page.data.description}
		</p>
		<div class="prose flex-1">
			{
				isEmpty && (
					<Callout title="Available soon">
						This page is still being written.
					</Callout>
				)
			}
			<Content
				components={{
					...defaultMdxComponents,
					CodeBlockTabs,
					CodeBlockTabsList,
					CodeBlockTabsTrigger,
					CodeBlockTab,
					PaletteGrid,
					SpacingScale,
					RadiusScale,
					TypeScale,
					SizesScale,
					MetricsPreview,
					ColorRoleTable,
					RolePreview,
					TokenChain,
					ThemeLayers,
					ComponentTokenPath,
					ComponentTokenPreview,
					ComponentTokenTable,
					OverlayPreview,
					OverlayLayers,
					AtomGrid,
					BehaviorGrid,
					BehaviorCard,
					PatternGrid,
					PatternCard,
					AtomCard,
					ComponentGrid,
					ComponentCard,
					TappablePreview,
					TappableHitSlop,
					HapticMap,
					HapticKinds,
					HapticFlow,
					RefreshControlPreview,
					RefreshControlStates,
					RefreshControlResistance,
					HideOnScrollPreview,
					HideOnScrollStates,
					CollapsibleHeaderPreview,
					CollapsibleHeaderStates,
					ScrollToTopPreview,
					ScrollAwareAppBarPreview,
					LongPressPreview,
					LongPressTimeline,
					SwipeActionsPreview,
					SwipeActionsStates,
					FullSwipePreview,
					FullSwipeStates,
					DragToReorderPreview,
					DragToReorderStates,
					PaginationPreview,
					PaginationStates,
					DynamicToolbarPreview,
					DynamicToolbarStates,
					OtpVerificationPreview,
					OtpVerificationStates,
					UndoableActionPreview,
					UndoableActionStates,
					SearchExperiencePreview,
					SearchExperienceStates,
					SelectionModePreview,
					SelectionModeStates,
					FloatingActionMenuPreview,
					FloatingActionMenuStates,
					AsyncContentStatePreview,
					AsyncContentStateStates,
					AsyncContentStateMachine,
					SwipeActionsMachine,
					PullToRefreshMachine,
					ScrollToTopMachine,
					PaginationMachine,
					UndoableActionMachine,
					SearchExperienceMachine,
					SelectionModeMachine,
					TabSwipeFrames,
					TabSwipeMachine,
					PhonePreview,
					Glyph,
					BottomSheetStackFrames,
					ScaffoldAnatomy,
					AxiomBanner,
					ComponentLayers,
					CompositionCatalog,
					CompositionGrid,
					PhaseTimeline,
					PhaseChecklist,
					ShowcaseGrid,
					ShowcaseCard,
					ShowcaseScreens,
				}}
			/>
		</div>
	</Docs>
</Layout>
