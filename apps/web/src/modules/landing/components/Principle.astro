---
import Title from './Title.astro';

// Editorial pattern shared by every PRINCIPLE on the landing:
// a label, one conviction, one sentence, one visual proof (default slot).
interface Props {
	index: string;
	class?: string;
}

const { index, class: className } = Astro.props;
---

<section class:list={['section', 'section--solid', 'principle', className]} aria-label={`Principle ${index}`}>
	<div class="container principle__inner">
		<div class="principle__copy">
			<p class="eyebrow principle__label">Principle <span>/</span> {index}</p>
			<Title><slot name="title" /></Title>
			<p class="principle__lede"><slot name="lede" /></p>
		</div>

		<div class="principle__proof">
			<slot />
		</div>
	</div>
</section>

<style>
	.principle {
		min-height: 50vh;
		display: flex;
		align-items: center;
		padding-block: clamp(5rem, 11vh, 8rem);
	}

	.principle__inner {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		align-items: center;
		gap: clamp(3rem, 7vw, 7rem);
	}

	.principle__copy {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 34rem;
	}

	.principle__label span {
		padding-inline: 0.35em;
		color: var(--line);
	}

	.principle__lede {
		max-width: 22rem;
		color: var(--muted);
		font-size: 0.975rem;
		line-height: 1.6;
	}

	@media (max-width: 1100px) {
		.principle__inner {
			grid-template-columns: 1fr;
		}
	}
</style>
