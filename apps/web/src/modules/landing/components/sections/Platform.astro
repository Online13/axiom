---
const rows = [
	{ label: 'Platform', items: ['Expo', 'React Native', 'iOS', 'Android', 'TypeScript', 'New Architecture'] },
	{ label: 'Styling', items: ['StyleSheet', 'Unistyles', 'NativeWind', 'Uniwind'] },
];
---

<section class="section platform">
	<div class="container platform__inner">
		{
			rows.map((row, i) => (
				<div class="platform__row">
					<p class="eyebrow">{i === 0 ? '02 / ' : ''}{row.label}</p>
					<ul class="platform__list">
						{row.items.map((name) => <li>{name}</li>)}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.platform {
		padding-block: 2.5rem;
	}

	.platform__inner {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 1rem 3rem;
	}

	/* Rows share the parent grid so both lists start on the same column. */
	.platform__row {
		display: grid;
		grid-template-columns: subgrid;
		grid-column: 1 / -1;
		align-items: baseline;
	}

	.platform__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 3rem;
		font-size: clamp(1rem, 1.6vw, 1.25rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.platform__inner {
			grid-template-columns: 1fr;
		}

		.platform__row {
			gap: 0.5rem;
		}
	}
</style>
