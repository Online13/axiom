---
import Title from '../Title.astro';
import CopyCommand from '../CopyCommand.astro';
import Button from '../Button.astro';
import { docs } from '../../lib/links';
const components = [
	'button', 'icon-button', 'tappable', 'text', 'icon', 'avatar',
	'badge', 'chip', 'divider', 'item', 'list', 'section-header',
	'app-bar', 'bottom-tab-bar', 'search-bar', 'text-field', 'textarea', 'checkbox',
	'radio', 'switch', 'slider', 'stepper', 'segmented-control', 'select',
	'date-picker', 'otp-input', 'progress', 'spinner', 'skeleton', 'toast',
	'alert', 'dialog', 'bottom-sheet', 'action-sheet', 'menu', 'popover',
	'tooltip', 'tabs', 'carousel', 'pull-to-refresh', 'swipeable', 'empty-state',
];

const initial = ['button', 'bottom-sheet'];

// Two ways to take a component: with the system behind it, or on its own.
const modes = [
	{ id: 'system', name: 'With the theme', flag: '', note: 'the component and everything it rests on, light / dark included' },
	{ id: 'standalone', name: 'Standalone', flag: ' --standalone', note: 'one self-contained file, no theme, yours to restyle', soon: true },
];
---

<section class="section section--solid registry" id="registry">
	<div class="container registry__inner">
		<div class="registry__copy">
			<p class="eyebrow">06 / Registry</p>
			<Title>Use only<br />what you need.</Title>
			<p class="registry__lede">
				Pick the pieces you want. Axiom resolves their dependencies and copies exactly what they
				need, in your styling, nothing more.
			</p>
			<CopyCommand class="registry__cli" command={`npx axiom add ${initial.join(' ')}`} />

			<div class="modes" role="radiogroup" aria-label="Install mode">
				{
					modes.map((mode, i) => (
						<button
							type="button"
							role="radio"
							class="mode"
							aria-checked={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1}
							data-flag={mode.flag}
						>
							<span class="mode__dot" aria-hidden="true" />
							<span class="mode__body">
								<span class="mode__name">
									{mode.name}
									{mode.soon && <small>soon</small>}
								</span>
								<span class="mode__note">{mode.note}</span>
							</span>
						</button>
					))
				}
			</div>
		</div>

		<div class="registry__browse">
			<div class="picker" role="group" aria-label="Registry components">
				{
					components.map((name) => (
						<button
							type="button"
							class="picker__item"
							aria-pressed={initial.includes(name) ? 'true' : 'false'}
							data-name={name}
						>
							<span class="picker__check" aria-hidden="true">
								<svg viewBox="0 0 12 12">
									<path d="M2.5 6.2 5 8.5l4.5-5" />
								</svg>
							</span>
							<span class="picker__name">{name}</span>
						</button>
					))
				}
			</div>
			<Button href={docs('/components')} variant="ghost" class="registry__all">View all components</Button>
		</div>
	</div>
</section>

<script>
	const items = document.querySelectorAll<HTMLButtonElement>('.picker__item');
	const modes = [...document.querySelectorAll<HTMLButtonElement>('.mode')];
	const cmd = document.querySelector('.registry__cli .copy-cmd__text');

	function update() {
		const names = [...items]
			.filter((i) => i.getAttribute('aria-pressed') === 'true')
			.map((i) => i.dataset.name);
		const flag = modes.find((m) => m.getAttribute('aria-checked') === 'true')?.dataset.flag ?? '';
		if (cmd) cmd.textContent = `npx axiom add ${names.length ? names.join(' ') : '…'}${flag}`;
	}

	items.forEach((item) => {
		item.addEventListener('click', () => {
			item.setAttribute('aria-pressed', String(item.getAttribute('aria-pressed') !== 'true'));
			update();
		});
	});

	function select(mode: HTMLButtonElement) {
		modes.forEach((m) => {
			const on = m === mode;
			m.setAttribute('aria-checked', String(on));
			m.tabIndex = on ? 0 : -1;
		});
		update();
	}

	modes.forEach((mode, i) => {
		mode.addEventListener('click', () => select(mode));
		// Arrow keys move between the two modes, as a radio group should.
		mode.addEventListener('keydown', (event) => {
			const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[event.key];
			if (!step) return;
			event.preventDefault();
			const next = modes[(i + step + modes.length) % modes.length];
			select(next);
			next.focus();
		});
	});
</script>

<style>
	.registry__inner {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		align-items: center;
		gap: 4rem;
	}

	.registry__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
	}

	.registry__lede {
		color: var(--muted);
		font-size: 1.125rem;
		max-width: 26rem;
	}

	.registry {
		padding-block: 5rem;
	}

	/* Install mode: the same picks, with or without the system behind them. */
	.modes {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		width: 100%;
		max-width: 26rem;
		margin-top: -0.75rem;
	}

	.mode {
		display: flex;
		align-items: flex-start;
		gap: 0.625rem;
		padding: 0.4rem 0;
		background: none;
		border: 0;
		color: var(--muted);
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: color 0.2s;
	}

	.mode:hover,
	.mode[aria-checked='true'] {
		color: var(--fg);
	}

	.mode:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}

	.mode__dot {
		flex: none;
		width: 0.875rem;
		height: 0.875rem;
		margin-top: 0.2rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		transition:
			border-color 0.2s,
			box-shadow 0.2s;
	}

	.mode[aria-checked='true'] .mode__dot {
		border-color: var(--fg);
		box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 0.875rem var(--fg);
	}

	.mode__body {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.1rem;
	}

	.mode__name {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.mode__name small {
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--line);
	}

	.mode__note {
		font-size: 0.85rem;
		color: var(--muted);
	}

	.registry__browse {
		position: relative;
		min-width: 0;
	}

	.picker {
		/* Clipped on purpose: the grid hints at the catalog, the button opens it. */
		max-height: 17rem;
		overflow: hidden;
		mask-image: linear-gradient(to bottom, #000 55%, transparent);
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: 0.5rem;
	}

	.picker__item {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		padding: 0.55rem 0.75rem;
		background: none;
		border: 1px solid var(--line);
		color: var(--muted);
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition:
			border-color 0.2s,
			background-color 0.2s,
			color 0.2s;
	}

	.picker__item:hover {
		border-color: color-mix(in srgb, var(--fg) 30%, var(--line));
		color: var(--fg);
	}

	.picker__item:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}

	.picker__item[aria-pressed='true'] {
		border-color: var(--fg);
		background: color-mix(in srgb, var(--fg) 6%, transparent);
		color: var(--fg);
	}

	.picker__name {
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.picker__check {
		flex: none;
		display: grid;
		place-items: center;
		width: 0.875rem;
		height: 0.875rem;
		border: 1px solid var(--line);
		transition:
			background-color 0.2s,
			border-color 0.2s;
	}

	.picker__check svg {
		width: 0.625rem;
		height: 0.625rem;
		fill: none;
		stroke: var(--bg);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0;
	}

	.picker__item[aria-pressed='true'] .picker__check {
		background: var(--fg);
		border-color: var(--fg);
	}

	.picker__item[aria-pressed='true'] .picker__check svg {
		opacity: 1;
	}

	.registry__all {
		position: absolute;
		left: 50%;
		bottom: 0.5rem;
		transform: translateX(-50%);
		background: var(--bg);
		white-space: nowrap;
	}

	.registry__all:is(:hover, :focus-visible) {
		border-color: var(--btn-hover-bg);
	}

	@media (max-width: 900px) {
		.registry__inner {
			grid-template-columns: 1fr;
		}
	}
</style>
