---
import Principle from '../Principle.astro';

// One real chain: three primitives converge into a composition, which becomes
// part of a block. Each stage reuses the shapes of the previous one.
const primitives = ['Button', 'Avatar', 'Item'];
const stages = [
	{ name: 'Primitive', note: 'Solves one local problem' },
	{ name: 'Composition', note: 'Profile Item, ready-made UI' },
	{ name: 'Block', note: 'Profile Header, a whole section' },
];
---

<Principle index="004" class="principle--composition">
	<Fragment slot="title">From primitives<br />to real interfaces.</Fragment>
	<Fragment slot="lede">
		A primitive solves a local problem. Compositions assemble primitives into ready-made UI, and blocks assemble
		them into whole sections of an app.
	</Fragment>

	<figure
		class="composition"
		aria-label="Button, Avatar and Item compose a Profile Item, which is part of a Profile Header: primitive, composition, block"
	>
		<figcaption class="eyebrow composition__caption">Fig. 004 — Primitive → Composition → Block</figcaption>

		<div class="composition__track">
			<div class="composition__stage" style="--i: 0">
				<span class="composition__glyph composition__glyph--primitives" aria-hidden="true">
					{
						primitives.map((name) => (
							<span class="composition__primitive">
								<small>{name}</small>
								{name === 'Button' && (
									<svg viewBox="0 0 40 16">
										<rect x="0.5" y="0.5" width="39" height="15" rx="7.5" pathLength="1" />
										<line x1="13" y1="8" x2="27" y2="8" pathLength="1" />
									</svg>
								)}
								{name === 'Avatar' && (
									<svg viewBox="0 0 16 16">
										<circle cx="8" cy="8" r="7.5" pathLength="1" />
										<circle cx="8" cy="6.5" r="2.5" pathLength="1" />
										<path d="M3.8 13.2a5 4 0 0 1 8.4 0" pathLength="1" />
									</svg>
								)}
								{name === 'Item' && (
									<svg viewBox="0 0 40 16">
										<rect x="0.5" y="0.5" width="39" height="15" rx="3" pathLength="1" />
										<circle cx="7" cy="8" r="3" pathLength="1" />
										<line x1="14" y1="8" x2="28" y2="8" pathLength="1" />
										<path d="M33 5.5 35.5 8 33 10.5" pathLength="1" />
									</svg>
								)}
							</span>
						))
					}
				</span>
				<span class="composition__text">
					<span class="composition__index">01</span>
					<h3 class="composition__name">{stages[0].name}</h3>
					<span class="composition__note">{stages[0].note}</span>
				</span>
			</div>

			<span class="composition__link" style="--i: 1" aria-hidden="true">
				<svg class="composition__link-h" viewBox="0 0 100 60" preserveAspectRatio="none">
					<path d="M0 10C50 10 50 30 100 30" pathLength="1" />
					<path d="M0 30H100" pathLength="1" />
					<path d="M0 50C50 50 50 30 100 30" pathLength="1" />
				</svg>
				<svg class="composition__link-v" viewBox="0 0 10 100" preserveAspectRatio="none">
					<path d="M5 0V100" pathLength="1" />
				</svg>
				<svg class="composition__arrow" viewBox="0 0 6 8">
					<path d="M0.5 0.5 5 4 0.5 7.5" />
				</svg>
			</span>

			<div class="composition__stage" style="--i: 2">
				<span class="composition__glyph" aria-hidden="true">
					<svg viewBox="0 0 120 40">
						<rect x="0.5" y="0.5" width="119" height="39" rx="8" pathLength="1" />
						<circle cx="20" cy="20" r="10" pathLength="1" />
						<line x1="38" y1="15" x2="72" y2="15" pathLength="1" />
						<line x1="38" y1="25" x2="58" y2="25" pathLength="1" class="is-soft" />
						<rect x="84" y="12" width="26" height="16" rx="8" pathLength="1" />
					</svg>
				</span>
				<span class="composition__text">
					<span class="composition__index">02</span>
					<h3 class="composition__name">{stages[1].name}</h3>
					<span class="composition__note">{stages[1].note}</span>
				</span>
			</div>

			<span class="composition__link" style="--i: 3" aria-hidden="true">
				<svg class="composition__link-h" viewBox="0 0 100 60" preserveAspectRatio="none">
					<path d="M0 30H100" pathLength="1" />
				</svg>
				<svg class="composition__link-v" viewBox="0 0 10 100" preserveAspectRatio="none">
					<path d="M5 0V100" pathLength="1" />
				</svg>
				<svg class="composition__arrow" viewBox="0 0 6 8">
					<path d="M0.5 0.5 5 4 0.5 7.5" />
				</svg>
			</span>

			<div class="composition__stage is-last" style="--i: 4">
				<span class="composition__glyph" aria-hidden="true">
					<svg viewBox="0 0 120 96">
						<rect x="0.5" y="0.5" width="119" height="95" rx="10" pathLength="1" />
						<circle cx="60" cy="24" r="12" pathLength="1" />
						<line x1="44" y1="45" x2="76" y2="45" pathLength="1" />
						<line x1="50" y1="53" x2="70" y2="53" pathLength="1" class="is-soft" />
						<rect x="8" y="64" width="104" height="24" rx="6" pathLength="1" />
						<circle cx="19" cy="76" r="5" pathLength="1" />
						<line x1="29" y1="76" x2="62" y2="76" pathLength="1" />
						<rect x="86" y="70" width="20" height="12" rx="6" class="is-fill" />
					</svg>
				</span>
				<span class="composition__text">
					<span class="composition__index">03</span>
					<h3 class="composition__name">{stages[2].name}</h3>
					<span class="composition__note">{stages[2].note}</span>
				</span>
			</div>
		</div>

		<p class="composition__hint" style="--i: 5">
			<i aria-hidden="true"></i>
			Behaviors and patterns turn blocks into complete experiences.
		</p>
	</figure>
</Principle>

<script>
	// The chain builds once, left to right: primitives, then the composition, then the block.
	const figure = document.querySelector<HTMLElement>('.composition');
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (figure && !reduced && 'IntersectionObserver' in window) {
		figure.dataset.state = 'idle';
		const observer = new IntersectionObserver(
			([entry]) => {
				if (!entry.isIntersecting) return;
				figure.dataset.state = 'play';
				observer.disconnect();
			},
			{ threshold: 0.45 },
		);
		observer.observe(figure);
	}
</script>

<style>
	.composition {
		--glyph-h: 7.5rem;
		--link: clamp(2rem, 4.5vw, 4rem);
		--step: 0.45s;
		--start: 0.15s;

		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
	}

	.composition__caption {
		font-size: 0.6875rem;
	}

	/* Stages and links share one row of glyphs; the text sits under each stage. */
	.composition__track {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) var(--link) minmax(0, 1fr) var(--link) minmax(0, 1fr);
		align-items: start;
	}

	.composition__stage {
		display: grid;
		grid-template-rows: var(--glyph-h) auto;
		row-gap: 1.75rem;
		min-width: 0;
	}

	.composition__glyph {
		display: flex;
		align-items: center;
		height: 100%;
		min-width: 0;
		color: var(--muted);
	}

	.composition__stage.is-last .composition__glyph {
		color: var(--fg);
	}

	.composition__glyph svg,
	.composition__link svg {
		display: block;
		overflow: visible;
	}

	.composition__glyph > svg {
		width: 100%;
		height: auto;
	}

	/* The block is the tallest glyph: fit it to the row, flush left against its link. */
	.composition__stage.is-last .composition__glyph > svg {
		width: auto;
		height: 100%;
		max-width: 100%;
	}

	.composition__glyph :is(rect, circle, line, path),
	.composition__link path {
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	.composition__glyph .is-fill {
		fill: currentColor;
		stroke: none;
	}

	.composition__glyph .is-soft {
		opacity: 0.4;
	}

	/* Primitives: three rows, each ending where its connector starts. */
	.composition__glyph--primitives {
		display: grid;
		grid-template-rows: repeat(3, 1fr);
	}

	.composition__primitive {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
	}

	.composition__primitive small {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--muted);
	}

	.composition__primitive svg {
		height: 1.1rem;
		width: auto;
	}

	/* Links: converge on the composition, then carry it into the block. */
	.composition__link {
		position: relative;
		height: var(--glyph-h);
		color: var(--line);
	}

	.composition__link .composition__link-h {
		width: 100%;
		height: 100%;
	}

	.composition__link .composition__link-v {
		display: none;
	}

	.composition__arrow {
		position: absolute;
		top: 50%;
		right: 0.2rem;
		width: 0.4rem;
		height: 0.55rem;
		transform: translateY(-50%);
		color: var(--muted);
	}

	.composition__arrow path {
		stroke-dasharray: none;
	}

	.composition__text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.composition__index {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--muted);
		margin-bottom: 0.35rem;
	}

	.composition__name {
		font-size: clamp(1rem, 1.35vw, 1.1875rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.composition__note {
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--muted);
	}

	/* Behaviors and patterns are a separate axis: a quiet note, not a fourth level. */
	.composition__hint {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.composition__hint i {
		flex: none;
		width: 1.5rem;
		height: 1px;
		background: color-mix(in srgb, var(--muted) 45%, transparent);
	}

	/* Motion: idle is the unbuilt state, play builds the chain in order. */
	.composition[data-state='idle'] :is(.composition__glyph, .composition__link) :is(rect, circle, line, path) {
		stroke-dashoffset: 1;
	}

	.composition[data-state='idle'] .composition__glyph .is-fill,
	.composition[data-state='idle'] .composition__arrow,
	.composition[data-state='idle'] .composition__hint {
		opacity: 0;
	}

	.composition[data-state='idle'] .composition__primitive small,
	.composition[data-state='idle'] .composition__text {
		opacity: 0.3;
	}

	.composition[data-state='play'] :is(.composition__stage, .composition__link, .composition__hint) {
		--at: calc(var(--start) + var(--i) * var(--step));
	}

	.composition[data-state='play'] .composition__glyph :is(rect, circle, line, path) {
		transition: stroke-dashoffset 0.9s cubic-bezier(0.65, 0, 0.35, 1) var(--at);
	}

	.composition[data-state='play'] .composition__link path {
		transition: stroke-dashoffset 0.6s cubic-bezier(0.65, 0, 0.35, 1) var(--at);
	}

	.composition[data-state='play'] .composition__arrow {
		transition: opacity 0.3s ease calc(var(--at) + 0.45s);
	}

	.composition[data-state='play'] .composition__glyph .is-fill {
		transition: opacity 0.4s ease calc(var(--at) + 0.6s);
	}

	.composition[data-state='play'] :is(.composition__primitive small, .composition__text, .composition__hint) {
		transition: opacity 0.5s ease var(--at);
	}

	/* Narrow screens: the chain reads top to bottom, text beside each glyph. */
	@media (max-width: 700px) {
		.composition {
			--glyph-h: 6.5rem;
			--glyph-w: 9.5rem;
			--link: 2.5rem;
		}

		.composition__track {
			grid-template-columns: 1fr;
		}

		.composition__stage {
			grid-template-columns: var(--glyph-w) minmax(0, 1fr);
			grid-template-rows: auto;
			column-gap: 1.5rem;
			align-items: center;
		}

		.composition__glyph {
			height: auto;
		}

		.composition__glyph--primitives {
			height: var(--glyph-h);
		}

		.composition__primitive {
			justify-content: center;
		}

		.composition__stage.is-last .composition__glyph > svg {
			width: 100%;
			height: auto;
		}

		.composition__link {
			width: var(--glyph-w);
			height: var(--link);
			padding-block: 0.4rem;
		}

		.composition__link .composition__link-h {
			display: none;
		}

		.composition__link .composition__link-v {
			display: block;
			width: 100%;
			height: 100%;
		}

		.composition__arrow {
			top: auto;
			right: auto;
			bottom: 0.2rem;
			left: 50%;
			transform: translateX(-50%) rotate(90deg);
		}
	}
</style>
