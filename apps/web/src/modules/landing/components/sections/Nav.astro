---
import { Logo } from '../../../brand/Logo';
import { docs, githubUrl } from '../../lib/links';
import Button from '../Button.astro';

const links = [
	{ label: 'Docs', href: docs() },
	{ label: 'Registry', href: '#registry' },
	{ label: 'Theme builder', href: '/theme-builder' },
];
---

<header class="nav">
	<div class="container nav__inner">
		<a href="/" class="nav__logo" aria-label="Axiom home"><Logo /></a>
		<div class="nav__right">
			<nav class="nav__links">
				{links.map((link) => <a href={link.href}>{link.label}</a>)}
			</nav>
			<div class="nav__actions">
				<Button href={githubUrl} variant="ghost" hoverColor="white" class="nav__btn" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
					</svg>
					<span class="nav__label">GitHub</span>
				</Button>
				<Button href={docs()} class="nav__btn">Get started</Button>
			</div>
		</div>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--nav-h);
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		backdrop-filter: blur(12px);
	}

	.nav__inner {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.nav__logo {
		font-size: 1.375rem;
	}

	.nav__right {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav__links {
		display: flex;
		gap: 2rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.nav__links a:hover {
		color: var(--fg);
	}

	.nav__actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav__btn {
		gap: 0.5rem;
		padding: 0.6rem 1.1rem;
		font-size: 0.875rem;
	}

	.nav__btn:not(.btn--ghost) {
		border: 1px solid var(--fg);
	}

	.nav__btn:not(.btn--ghost):is(:hover, :focus-visible) {
		border-color: var(--btn-hover-bg);
	}

	.nav__btn svg {
		width: 1rem;
		height: 1rem;
		fill: currentColor;
	}

	@media (max-width: 640px) {
		.nav__links {
			display: none;
		}

		.nav__label {
			display: none;
		}

		.nav__btn[aria-label='GitHub'] {
			padding-inline: 0.7rem;
		}
	}
</style>
