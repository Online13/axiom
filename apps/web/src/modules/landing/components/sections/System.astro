---
import Title from '../Title.astro';
import { docs } from '../../lib/links';

// Each layer opens the matching section of the docs. Primitives keep Atomic
// Design as their internal organization; compositions and blocks sit on top.
const layers = [
	{ name: 'Foundations', href: docs('/foundations'), detail: 'Tokens · color · type · spacing · radius' },
	{
		name: 'Primitives',
		href: docs('/components'),
		detail: 'Button · Avatar · Item · Card · AppBar · Scaffold',
		sub: 'Atoms · Molecules · Organisms · Templates',
	},
	{ name: 'Compositions', href: docs('/compositions'), detail: 'Product Card · Settings Item · Profile Item' },
	{ name: 'Blocks', href: docs('/blocks'), detail: 'Settings Section · Profile Header · Checkout · Paywall · Login' },
];

const swatches = ['#f5f5f5', '#8a8a8a', '#262626', '#0a0a0a', '#ff5a1f'];
const blocks = ['Settings', 'Profile', 'Checkout', 'Paywall', 'Login'];
---

<section class="section section--full system" id="system">
	<div class="container system__inner">
		<header class="system__header">
			<p class="eyebrow">05 / System</p>
			<Title>Start with a system.</Title>
		</header>

		<ol class="system__stack">
			{
				layers.map((layer, i) => (
					<li class="system__layer" style={`--i: ${i}`}>
						<div class="system__label">
							<span class="eyebrow">0{i + 1}</span>
							<h3>
								<a href={layer.href}>{layer.name}</a>
							</h3>
							<p>{layer.detail}</p>
							{layer.sub && <small>{layer.sub}</small>}
						</div>
						<div class="system__block" aria-hidden="true">
							{i === 0 && (
								<>
									<span class="swatches">
										{swatches.map((c) => (
											<i style={`--c:${c}`} />
										))}
									</span>
									<span class="type">
										<b>Aa</b>
										<span>Inter · 600</span>
									</span>
									<span class="spacing">
										{[4, 8, 12, 16, 24].map((s) => (
											<i style={`--s:${s}`} />
										))}
									</span>
									<code>radius.lg = 16</code>
								</>
							)}
							{i === 1 && (
								<>
									<span class="s-btn">Continue</span>
									<span class="s-switch" />
									<span class="s-check">
										<svg viewBox="0 0 24 24">
											<path d="m5 12 4.5 4.5L19 7" />
										</svg>
									</span>
									<span class="s-badge">New</span>
									<span class="s-avatar">AC</span>
									<span class="s-appbar">
										<i>‹</i>
										<b>Settings</b>
										<i>⋯</i>
									</span>
								</>
							)}
							{i === 2 && (
								<>
									<span class="s-card">
										<i class="s-card__img" />
										<span class="s-card__text">
											<b>Linen shirt</b>
											<span>$48</span>
										</span>
										<span class="s-card__add">Add</span>
									</span>
									<span class="s-item">
										<span class="s-item__icon">
											<svg viewBox="0 0 24 24">
												<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
												<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
											</svg>
										</span>
										Notifications
										<span class="s-switch" />
									</span>
								</>
							)}
							{i === 3 &&
								blocks.map((b) => (
									<span class="s-screen">
										<i />
										<i />
										<i />
										<b>{b}</b>
									</span>
								))}
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.system__inner {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.system__header {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.system__stack {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.system__layer {
		display: grid;
		grid-template-columns: 17rem 1fr;
		align-items: center;
		gap: 2rem;
	}

	.system__label {
		display: grid;
		grid-template-columns: 2rem 1fr;
		column-gap: 0.75rem;
		align-items: baseline;
	}

	.system__label h3 {
		font-size: 1.25rem;
		font-weight: 500;
	}

	.system__label h3 a:hover {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.system__label p {
		grid-column: 2;
		color: var(--muted);
		font-size: 0.85rem;
	}

	/* Atomic Design stays the internal organization of primitives. */
	.system__label small {
		grid-column: 2;
		margin-top: 0.3rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: color-mix(in srgb, var(--muted) 70%, transparent);
	}

	/* Each layer grows wider as it builds on the previous one. */
	.system__block {
		--accent: #ff5a1f;
		height: 3.75rem;
		width: calc(40% + var(--i) * 20%);
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0 1rem;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 10px;
		font-size: 0.8rem;
		white-space: nowrap;
	}

	.system__block svg {
		width: 1rem;
		height: 1rem;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Foundations */
	.swatches {
		display: flex;
	}
	.swatches i {
		width: 1.5rem;
		height: 1.5rem;
		margin-right: -0.35rem;
		border-radius: 50%;
		background: var(--c);
		box-shadow: 0 0 0 2px var(--bg);
	}
	.type {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		color: var(--muted);
	}
	.type b {
		color: var(--fg);
		font-size: 1.4rem;
		font-weight: 600;
		letter-spacing: -0.03em;
	}
	.spacing {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 1.5rem;
	}
	.spacing i {
		width: 4px;
		height: calc(var(--s) * 1px);
		background: var(--accent);
	}
	.system__block code {
		font-family: var(--font-mono);
		color: var(--muted);
	}

	/* Primitives */
	.s-btn {
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
	}
	.s-switch {
		position: relative;
		flex: none;
		width: 2.4rem;
		height: 1.4rem;
		border-radius: 999px;
		background: var(--accent);
	}
	.s-switch::after {
		content: '';
		position: absolute;
		top: 0.15rem;
		right: 0.15rem;
		width: 1.1rem;
		height: 1.1rem;
		border-radius: 50%;
		background: #fff;
	}
	.s-check {
		display: grid;
		place-items: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 6px;
		background: var(--fg);
		color: var(--bg);
	}
	.s-badge {
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--accent);
		color: var(--accent);
		font-weight: 600;
	}
	.s-avatar {
		display: grid;
		place-items: center;
		flex: none;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--fg);
		color: var(--bg);
		font-weight: 600;
	}
	.s-appbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-width: 12rem;
		padding: 0.45rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.s-appbar i {
		font-style: normal;
		color: var(--muted);
	}

	/* Compositions: primitives assembled into ready-made pieces. */
	.s-card,
	.s-item {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		height: 2.6rem;
		padding: 0 0.35rem;
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.s-card {
		min-width: 13rem;
	}
	.s-card__img {
		flex: none;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 5px;
		background: linear-gradient(135deg, var(--line), color-mix(in srgb, var(--accent) 35%, transparent));
	}
	.s-card__text {
		flex: 1;
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}
	.s-card__text b {
		font-weight: 500;
	}
	.s-card__text span {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
	}
	.s-card__add {
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
	}
	.s-item {
		min-width: 14rem;
		padding-left: 0.5rem;
		padding-right: 0.6rem;
	}
	.s-item__icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 6px;
		background: var(--fg);
		color: var(--bg);
	}
	.s-item__icon svg {
		width: 0.85rem;
		height: 0.85rem;
	}
	.s-item .s-switch {
		margin-left: auto;
	}

	/* Blocks */
	.system__layer:last-child .system__block {
		border-color: var(--fg);
		gap: 0.5rem;
	}
	.s-screen {
		position: relative;
		flex: 1;
		min-width: 5.5rem;
		height: 2.6rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2rem;
		padding: 0 0.5rem;
		border: 1px solid var(--line);
		border-radius: 6px;
	}
	.s-screen i {
		height: 2px;
		width: 40%;
		background: var(--line);
	}
	.s-screen i:first-child {
		width: 25%;
		background: var(--accent);
	}
	.s-screen b {
		position: absolute;
		right: 0.5rem;
		bottom: 0.3rem;
		font-size: 0.7rem;
		font-weight: 500;
	}

	@media (max-width: 900px) {
		.system__layer {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.system__block {
			width: 100%;
		}
	}
</style>
