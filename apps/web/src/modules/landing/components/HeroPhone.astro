---
// Pure SVG hero visual: an iOS device running an Axiom screen, with floating
// callouts naming the primitive behind each part of the UI.

type Side = "left" | "right";
interface Legend {
	name: string;
	desc: [string, string];
	x: number;
	y: number;
	side: Side;
	/** Region of the screen this callout describes: x, y, width, height, radius. */
	area: [number, number, number, number, number];
}

const legends: Legend[] = [
	{
		name: "AppBar",
		desc: ["Navigation,", "title, actions"],
		x: 241,
		y: 158,
		side: "left",
		area: [238, 142, 284, 32, 10],
	},
	{
		name: "Item",
		desc: ["Composable", "list item"],
		x: 248,
		y: 298,
		side: "left",
		area: [248, 276, 264, 44, 14],
	},
	{
		name: "Button",
		desc: ["Variants,", "states, loading"],
		x: 248,
		y: 702,
		side: "left",
		area: [243, 675, 274, 54, 16],
	},
	{
		name: "Scaffold",
		desc: ["Full-screen", "layout system"],
		x: 540,
		y: 124,
		side: "right",
		area: [234, 104, 292, 652, 40],
	},
	{
		name: "Switch",
		desc: ["Cross-platform", "behavior"],
		x: 508,
		y: 342,
		side: "right",
		area: [466, 327, 46, 30, 15],
	},
	{
		name: "Tappable",
		desc: ["44pt target,", "gesture handling"],
		x: 512,
		y: 508,
		side: "right",
		area: [248, 486, 264, 44, 14],
	},
];

const LEFT_END = 172;
const RIGHT_END = 588;

interface Row {
	label: string;
	icon: "user" | "bell" | "theme" | "lock" | "data";
	cy: number;
	toggle: boolean;
	value?: string;
	pressed: boolean;
}

const rows1: Row[] = [
	{ label: "Profile", icon: "user", cy: 298, toggle: false, pressed: false },
	{
		label: "Notifications",
		icon: "bell",
		cy: 342,
		toggle: true,
		pressed: false,
	},
	{
		label: "Appearance",
		icon: "theme",
		cy: 386,
		value: "System",
		toggle: false,
		pressed: false,
	},
];
const rows2: Row[] = [
	{ label: "Privacy", icon: "lock", cy: 464, toggle: true, pressed: false },
	{
		label: "Data & Storage",
		icon: "data",
		cy: 508,
		toggle: false,
		pressed: true,
	},
];
---

<svg
	class="hero-phone"
	viewBox="40 86 690 690"
	role="img"
	aria-label="An iOS account screen built with Axiom, annotated with the components it uses: AppBar, Item, Button, Scaffold, Switch and Tappable."
>
	<defs>
		<clipPath id="hp-screen">
			<rect x="232" y="102" width="296" height="656" rx="42"></rect>
		</clipPath>
		<!-- Brushed titanium band, brighter where it curves toward the light. -->
		<linearGradient id="hp-frame" x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#6b6b6f"></stop>
			<stop offset="0.025" stop-color="#2b2b2e"></stop>
			<stop offset="0.12" stop-color="#44444a"></stop>
			<stop offset="0.5" stop-color="#26262a"></stop>
			<stop offset="0.88" stop-color="#3e3e44"></stop>
			<stop offset="0.975" stop-color="#2b2b2e"></stop>
			<stop offset="1" stop-color="#636367"></stop>
		</linearGradient>
		<linearGradient id="hp-sheen" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#fff" stop-opacity="0.14"></stop>
			<stop offset="0.08" stop-color="#fff" stop-opacity="0"></stop>
			<stop offset="0.92" stop-color="#000" stop-opacity="0"></stop>
			<stop offset="1" stop-color="#000" stop-opacity="0.3"></stop>
		</linearGradient>
		<linearGradient id="hp-key" x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#232326"></stop>
			<stop offset="0.45" stop-color="#55555a"></stop>
			<stop offset="1" stop-color="#2e2e32"></stop>
		</linearGradient>
		<radialGradient id="hp-lens">
			<stop offset="0.38" stop-color="#1a2238"></stop>
			<stop offset="0.55" stop-color="#0b0e17"></stop>
			<stop offset="0.72" stop-color="#121212"></stop>
			<stop offset="1" stop-color="#050505"></stop>
		</radialGradient>
		<linearGradient id="hp-glare" x1="0" y1="0" x2="1" y2="0.55">
			<stop offset="0" stop-color="#fff" stop-opacity="0.1"></stop>
			<stop offset="0.32" stop-color="#fff" stop-opacity="0.03"></stop>
			<stop offset="0.322" stop-color="#fff" stop-opacity="0"></stop>
		</linearGradient>
	</defs>

	<!-- Device -->
	<g class="hero-phone__device" aria-hidden="true">
		<!-- Side keys: action, volume up, volume down, power. -->
		<g fill="url(#hp-key)">
			<rect x="216.5" y="202" width="4.5" height="31" rx="1.6"></rect>
			<rect x="216.5" y="253" width="4.5" height="58" rx="1.6"></rect>
			<rect x="216.5" y="323" width="4.5" height="58" rx="1.6"></rect>
			<rect x="539" y="274" width="4.5" height="88" rx="1.6"></rect>
		</g>
		<rect x="219.5" y="89.5" width="321" height="681" rx="54.5" fill="none" stroke="#000" stroke-opacity="0.55"></rect>
		<rect x="220" y="90" width="320" height="680" rx="54" fill="url(#hp-frame)"></rect>
		<rect x="220" y="90" width="320" height="680" rx="54" fill="url(#hp-sheen)"></rect>
		<rect x="220.5" y="90.5" width="319" height="679" rx="53.5" fill="none" stroke="#fff" stroke-opacity="0.22"></rect>
		<!-- Antenna lines across the band. -->
		<g fill="#000" fill-opacity="0.5">
			<rect x="220" y="140" width="4" height="2.4"></rect>
			<rect x="536" y="140" width="4" height="2.4"></rect>
			<rect x="220" y="718" width="4" height="2.4"></rect>
			<rect x="536" y="718" width="4" height="2.4"></rect>
			<rect x="290" y="90" width="2.4" height="4"></rect>
			<rect x="468" y="766" width="2.4" height="4"></rect>
		</g>
		<!-- Black glass bezel. -->
		<rect x="224" y="94" width="312" height="672" rx="50" fill="#050506" stroke="#fff" stroke-opacity="0.07"></rect>

		<g clip-path="url(#hp-screen)">
			<rect x="232" y="102" width="296" height="656" fill="#f4f4f2"></rect>

			<!-- Status bar -->
			<text x="266" y="129" class="t t--status">9:41</text>
			<rect x="332" y="112" width="96" height="28" rx="14" fill="#000"></rect>
			<circle cx="414" cy="126" r="6" fill="url(#hp-lens)"></circle>
			<circle cx="412" cy="124" r="1.4" fill="#8caae6" fill-opacity="0.55"></circle>
			<!-- Signal, Wi-Fi, battery. -->
			<g fill="#111">
				<rect x="449" y="124.5" width="2.6" height="3.8" rx="0.8"></rect>
				<rect x="453" y="122.5" width="2.6" height="5.8" rx="0.8"></rect>
				<rect x="457" y="120.5" width="2.6" height="7.8" rx="0.8"></rect>
				<rect x="461" y="118.5" width="2.6" height="9.8" rx="0.8"></rect>
				<g transform="translate(467 118.3) scale(0.8)">
					<path d="M8 0.6C5.1 0.6 2.5 1.7 0.6 3.6l1.4 1.4A8.4 8.4 0 0 1 8 2.6c2.3 0 4.4 0.9 6 2.4l1.4-1.4A10.4 10.4 0 0 0 8 0.6Z"></path>
					<path d="M8 4.6c-1.8 0-3.4 0.7-4.6 1.8l1.4 1.4A4.5 4.5 0 0 1 8 6.6c1.2 0 2.3 0.5 3.2 1.2l1.4-1.4A6.5 6.5 0 0 0 8 4.6Z"></path>
					<path d="M8 8.6c-0.7 0-1.3 0.3-1.8 0.7L8 11.2l1.8-1.9A2.6 2.6 0 0 0 8 8.6Z"></path>
				</g>
				<rect x="481.5" y="118.5" width="19" height="10" rx="3" fill="none" stroke="#111" stroke-opacity="0.38"></rect>
				<rect x="483" y="120" width="13.5" height="7" rx="1.8"></rect>
				<path d="M502 121.8c0.8 0.3 1.3 0.9 1.3 1.7s-0.5 1.4-1.3 1.7Z" fill-opacity="0.4"></path>
			</g>

			<!-- AppBar -->
			<path d="M258 151 L251 158 L258 165" class="ico" stroke-width="1.8"
			></path>
			<text x="380" y="163" text-anchor="middle" class="t t--title"
				>Account</text
			>
			<g fill="#111">
				<circle cx="506" cy="152" r="1.5"></circle>
				<circle cx="506" cy="158" r="1.5"></circle>
				<circle cx="506" cy="164" r="1.5"></circle>
			</g>

			<!-- Profile -->
			<rect x="248" y="196" width="264" height="60" rx="14" fill="#fff"
			></rect>
			<circle cx="276" cy="226" r="18" fill="#111"></circle>
			<text x="276" y="231" text-anchor="middle" class="t t--avatar">A</text>
			<text x="304" y="222" class="t t--name">Alex Chen</text>
			<text x="304" y="238" class="t t--sub">alex@axiom.dev</text>
			<path d="M497 221 L502 226 L497 231" class="ico ico--muted"></path>

			<!-- Groups -->
			<text x="256" y="268" class="t t--section">PREFERENCES</text>
			<rect x="248" y="276" width="264" height="132" rx="14" fill="#fff"
			></rect>
			<text x="256" y="434" class="t t--section">SECURITY</text>
			<rect x="248" y="442" width="264" height="88" rx="14" fill="#fff"
			></rect>

			{
				[...rows1, ...rows2].map((row, i, all) => (
					<g>
						{row.pressed && (
							<>
								<path
									d="M248 486 H512 V516 A14 14 0 0 1 498 530 H262 A14 14 0 0 1 248 516 Z"
									fill="#ececea"
								/>
								<rect
									x="244"
									y="482"
									width="272"
									height="52"
									rx="16"
									class="target"
								/>
							</>
						)}
						<g transform={`translate(272 ${row.cy})`} class="ico">
							{row.icon === "user" && (
								<>
									<circle cx="0" cy="-3" r="3.2" />
									<path d="M-5.5 6 C-5 1.5 5 1.5 5.5 6" />
								</>
							)}
							{row.icon === "bell" && (
								<>
									<path d="M-5 3.5 V-1 A5 5 0 0 1 5 -1 V3.5 L6 5 H-6 Z" />
									<path d="M-1.6 7 H1.6" />
								</>
							)}
							{row.icon === "theme" && (
								<>
									<circle cx="0" cy="0" r="6" />
									<path d="M0 -6 A6 6 0 0 1 0 6 Z" fill="#111" />
								</>
							)}
							{row.icon === "lock" && (
								<>
									<rect x="-5.5" y="-1" width="11" height="8" rx="2" />
									<path d="M-3 -1 V-3.5 A3 3 0 0 1 3 -3.5 V-1" />
								</>
							)}
							{row.icon === "data" && (
								<>
									<ellipse cx="0" cy="-4" rx="5.5" ry="2.2" />
									<path d="M-5.5 -4 V4.5 C-5.5 7.4 5.5 7.4 5.5 4.5 V-4" />
									<path d="M-5.5 0.3 C-5.5 3.2 5.5 3.2 5.5 0.3" />
								</>
							)}
						</g>
						<text x="294" y={row.cy + 4.5} class="t t--row">
							{row.label}
						</text>
						{row.toggle ? (
							<>
								<rect
									x="470"
									y={row.cy - 11}
									width="38"
									height="22"
									rx="11"
									class="accent-fill"
								/>
								<circle cx="497" cy={row.cy} r="9" fill="#fff" />
							</>
						) : (
							<path
								d={`M497 ${row.cy - 5} L502 ${row.cy} L497 ${row.cy + 5}`}
								class="ico ico--muted"
							/>
						)}
						{row.value && (
							<text
								x="488"
								y={row.cy + 4}
								text-anchor="end"
								class="t t--sub"
							>
								{row.value}
							</text>
						)}
						{all[i + 1] && all[i + 1].cy - row.cy === 44 && (
							<line
								x1="294"
								y1={row.cy + 22}
								x2="512"
								y2={row.cy + 22}
								stroke="#ececea"
							/>
						)}
					</g>
				))
			}

			<!-- Storage -->
			<rect x="248" y="550" width="264" height="74" rx="14" fill="#fff"
			></rect>
			<text x="264" y="576" class="t t--row">Storage</text>
			<text x="496" y="576" text-anchor="end" class="t t--sub"
				>2.4 of 5 GB</text
			>
			<rect x="264" y="592" width="232" height="6" rx="3" fill="#ececea"
			></rect>
			<rect x="264" y="592" width="112" height="6" rx="3" fill="#111"></rect>
			<text x="264" y="614" class="t t--hint">Synced 2 min ago</text>

			<!-- Button -->
			<rect
				x="248"
				y="680"
				width="264"
				height="44"
				rx="12"
				class="accent-fill"></rect>
			<text x="380" y="706.5" text-anchor="middle" class="t t--button"
				>Sign out</text
			>

			<rect x="325" y="744" width="110" height="4" rx="2" fill="#111"></rect>
		</g>
		<!-- The glass catching the light. -->
		<rect x="232" y="102" width="296" height="656" rx="42" fill="url(#hp-glare)"></rect>
	</g>

	<!-- Callouts -->
	{
		legends.map((l, i) => {
			const end = l.side === "left" ? LEFT_END : RIGHT_END;
			const tx = l.side === "left" ? end - 12 : end + 12;
			const anchor = l.side === "left" ? "end" : "start";
			const [ax, ay, aw, ah, ar] = l.area;
			const hitX = l.side === "left" ? 40 : l.x;
			const hitW = l.side === "left" ? l.x - 40 : 730 - l.x;
			return (
				<g
					class="legend"
					style={`--i:${i}`}
					tabindex="0"
					aria-label={`${l.name}: ${l.desc.join(" ")}`}
				>
					<rect
						x={ax}
						y={ay}
						width={aw}
						height={ah}
						rx={ar}
						class="legend__area"
					/>
					<rect
						x={hitX}
						y={l.y - 20}
						width={hitW}
						height={64}
						class="legend__hit"
					/>
					<line x1={l.x} y1={l.y} x2={end} y2={l.y} class="legend__line" />
					<circle cx={end} cy={l.y} r="2" class="legend__tick" />
					<g class="legend__label">
						<text
							x={tx}
							y={l.y + 4}
							text-anchor={anchor}
							class="legend__name"
						>
							{l.name}
						</text>
						<text
							x={tx}
							y={l.y + 22}
							text-anchor={anchor}
							class="legend__desc"
						>
							{l.desc[0]}
						</text>
						<text
							x={tx}
							y={l.y + 36}
							text-anchor={anchor}
							class="legend__desc"
						>
							{l.desc[1]}
						</text>
					</g>
					<circle cx={l.x} cy={l.y} r="8" class="legend__halo" />
					<circle cx={l.x} cy={l.y} r="3.5" class="legend__dot" />
				</g>
			);
		})
	}
</svg>

<style>
	.hero-phone {
		--accent: #61dafb;
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.hero-phone__device {
		filter: drop-shadow(0 28px 32px rgb(0 0 0 / 0.32));
	}

	.t {
		font-family: var(--font-sans);
		fill: #111;
	}
	.t--status {
		font-size: 12px;
		font-weight: 600;
	}
	.t--title {
		font-size: 14px;
		font-weight: 600;
	}
	.t--avatar {
		font-size: 15px;
		font-weight: 600;
		fill: #fff;
	}
	.t--name {
		font-size: 13px;
		font-weight: 600;
	}
	.t--row {
		font-size: 12.5px;
		font-weight: 500;
	}
	.t--sub {
		font-size: 11px;
		fill: #8a8a8a;
	}
	.t--hint {
		font-size: 10px;
		fill: #a3a3a3;
	}
	.t--section {
		font-family: var(--font-mono);
		font-size: 8.5px;
		letter-spacing: 0.08em;
		fill: #9a9a9a;
	}
	.t--button {
		font-size: 13px;
		font-weight: 600;
		fill: #000000;
	}

	.ico {
		fill: none;
		stroke: #111;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ico--muted {
		stroke: #b5b5b5;
		stroke-width: 1.6;
	}

	.accent-fill {
		fill: var(--accent);
	}

	.target {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}

	.legend {
		outline: none;
		cursor: default;
	}
	.legend__hit {
		fill: transparent;
	}
	.legend__area {
		fill: var(--accent);
		fill-opacity: 0;
		stroke: var(--accent);
		stroke-width: 1.5;
		stroke-opacity: 0;
		pointer-events: none;
		transition:
			fill-opacity 0.25s ease,
			stroke-opacity 0.25s ease;
	}
	.legend__line,
	.legend__tick,
	.legend__label,
	.legend__dot,
	.legend__halo,
	.legend__name {
		transition:
			opacity 0.25s ease,
			fill 0.25s ease,
			stroke 0.25s ease;
	}
	.legend:is(:hover, :focus-visible) .legend__area {
		fill-opacity: 0.1;
		stroke-opacity: 1;
	}
	.legend:is(:hover, :focus-visible) .legend__line {
		stroke: var(--accent);
		stroke-opacity: 1;
	}
	.legend:is(:hover, :focus-visible) .legend__tick,
	.legend:is(:hover, :focus-visible) .legend__name {
		fill: var(--accent);
	}
	.hero-phone:has(.legend:is(:hover, :focus-visible))
		.legend:not(:hover, :focus-visible)
		:is(
			.legend__line,
			.legend__tick,
			.legend__label,
			.legend__dot,
			.legend__halo
		) {
		opacity: 0.3;
	}

	.legend__line {
		stroke: var(--muted);
		stroke-opacity: 0.55;
		stroke-width: 1;
	}
	.legend__tick {
		fill: var(--muted);
	}
	.legend__dot {
		fill: var(--accent);
		stroke: #fff;
		stroke-width: 1.5;
	}
	.legend__halo {
		fill: var(--accent);
		opacity: 0.22;
		transform-box: fill-box;
		transform-origin: center;
	}
	.legend__name {
		font-family: var(--font-sans);
		font-size: 15px;
		font-weight: 600;
		fill: var(--fg);
	}
	.legend__desc {
		font-family: var(--font-mono);
		font-size: 10.5px;
		fill: var(--muted);
	}

	@media (prefers-reduced-motion: no-preference) {
		.legend {
			animation: legend-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
			animation-delay: calc(0.4s + var(--i) * 0.09s);
		}
		.legend__label {
			animation: legend-float 5s ease-in-out infinite;
			animation-delay: calc(var(--i) * -0.7s);
		}
		.legend__halo {
			animation: legend-pulse 2.8s ease-out infinite;
			animation-delay: calc(var(--i) * 0.4s);
		}
	}

	@keyframes legend-in {
		from {
			opacity: 0;
		}
	}
	@keyframes legend-float {
		50% {
			transform: translateY(-4px);
		}
	}
	@keyframes legend-pulse {
		0% {
			transform: scale(0.6);
			opacity: 0.35;
		}
		100% {
			transform: scale(1.9);
			opacity: 0;
		}
	}
</style>
