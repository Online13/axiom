---
// Lucide outlines used by the theme builder preview.
interface Props {
	name:
		| "bell"
		| "heart"
		| "home"
		| "search"
		| "library"
		| "user"
		| "chevron"
		| "download"
		| "save"
		| "folder"
		| "panel"
		| "smartphone"
		| "tablet"
		| "grid"
		| "sun"
		| "moon"
		| "minus"
		| "plus"
		| "focus";
}

const { name } = Astro.props;
---

<svg class="builder-icon" viewBox="0 0 24 24" aria-hidden="true">
	{
		name === "bell" && (
			<>
				<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
				<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
			</>
		)
	}
	{
		name === "heart" && (
			<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
		)
	}
	{
		name === "home" && (
			<path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
		)
	}
	{
		name === "search" && (
			<>
				<circle cx="11" cy="11" r="8" />
				<path d="m21 21-4.3-4.3" />
			</>
		)
	}
	{
		name === "library" && (
			<>
				<path d="M12 7v14" />
				<path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
			</>
		)
	}
	{
		name === "user" && (
			<>
				<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
				<circle cx="12" cy="7" r="4" />
			</>
		)
	}
	{name === "chevron" && <path d="m9 18 6-6-6-6" />}
	{
		name === "download" && (
			<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
		)
	}
	{
		name === "save" && (
			<>
				<path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
				<path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7M7 3v4a1 1 0 0 0 1 1h7" />
			</>
		)
	}
	{
		name === "folder" && (
			<path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2" />
		)
	}
	{
		name === "panel" && (
			<>
				<rect width="18" height="18" x="3" y="3" rx="2" />
				<path d="M9 3v18m7-6-3-3 3-3" />
			</>
		)
	}
	{
		name === "smartphone" && (
			<>
				<rect width="14" height="20" x="5" y="2" rx="2" />
				<path d="M12 18h.01" />
			</>
		)
	}
	{
		name === "tablet" && (
			<>
				<rect width="16" height="20" x="4" y="2" rx="2" />
				<path d="M12 18h.01" />
			</>
		)
	}
	{
		name === "grid" && (
			<>
				<rect width="7" height="7" x="3" y="3" rx="1" />
				<rect width="7" height="7" x="14" y="3" rx="1" />
				<rect width="7" height="7" x="14" y="14" rx="1" />
				<rect width="7" height="7" x="3" y="14" rx="1" />
			</>
		)
	}
	{
		name === "sun" && (
			<>
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
			</>
		)
	}
	{name === "moon" && <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />}
	{name === "minus" && <path d="M5 12h14" />}
	{name === "plus" && <path d="M5 12h14M12 5v14" />}
	{
		name === "focus" && (
			<>
				<circle cx="12" cy="12" r="3" />
				<path d="M3 7V5a2 2 0 0 1 2-2h2m10 0h2a2 2 0 0 1 2 2v2m0 10v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2" />
			</>
		)
	}
</svg>

<style>
	.builder-icon {
		width: 1em;
		height: 1em;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
