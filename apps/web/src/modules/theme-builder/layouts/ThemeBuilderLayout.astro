---
// The builder loads the real component stylesheet: the phones are drawn by the
// same `.ax-*` primitives as the documentation previews, only their `--ax-*`
// variables come from the seeds instead of the shipped tokens.
import "@docs/styles/preview.css";
import "../styles/theme-builder.css";
import ThemeScript from "../../brand/ThemeScript.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Theme builder — Axiom",
	description = "Pick five seed colors and watch a real Axiom app take the theme. Export the tokens when it looks right.",
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<ThemeScript />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- The builder's own chrome. Preview typefaces are loaded on demand by
		     the font picker. -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
