---
/*
 * Draws brand ribbons (see ribbons.ts) into one SVG: a faint body lit from the bright edge,
 * the faint edge, and a glowing bright edge with a white-hot core. Light mode swaps the glow
 * for plain lines that fade across and along each ribbon. Extra attributes (class, width,
 * viewBox…) go on the <svg>; `id` prefixes its gradients, clips and filters so several
 * scenes can share a page.
 */
import type { HTMLAttributes } from 'astro/types';
import { bounds, edge, faintEdge, gradientStops, rounded, shape, width, type Ribbon } from './ribbons';

interface Props extends HTMLAttributes<'svg'> {
	id: string;
	ribbons: Ribbon[];
}

const { id, ribbons: source, class: className, ...attrs } = Astro.props;
const ribbons = rounded(source);
const ref = (name: string, i?: number) => `${id}-${name}${i === undefined ? '' : `-${i}`}`;
---

<svg class:list={['ribbons', className]} fill="none" aria-hidden="true" {...attrs}>
	<defs>
		<filter id={ref('soft')} x="-20%" y="-20%" width="140%" height="140%">
			<feGaussianBlur stdDeviation="36" />
		</filter>
		<!-- Neon glow: the line itself over a tight and a wide blurred copy of it. -->
		<filter id={ref('neon')} x="-20%" y="-20%" width="140%" height="140%">
			<feGaussianBlur in="SourceGraphic" stdDeviation="4" result="tight" />
			<feGaussianBlur in="SourceGraphic" stdDeviation="14" result="wide" />
			<feMerge>
				<feMergeNode in="wide" />
				<feMergeNode in="wide" />
				<feMergeNode in="tight" />
				<feMergeNode in="tight" />
				<feMergeNode in="SourceGraphic" />
			</feMerge>
		</filter>
		<filter id={ref('bloom')} x="-20%" y="-20%" width="140%" height="140%">
			<feGaussianBlur stdDeviation="28" />
		</filter>
		{
			ribbons.map((r, i) => (
				<>
					<linearGradient
						id={ref('ribbon', i)}
						gradientUnits="userSpaceOnUse"
						x1={r.points[0][0]}
						y1={r.points[0][1]}
						x2={r.points.at(-1)![0]}
						y2={r.points.at(-1)![1]}
					>
						{gradientStops(r.colors).map(({ offset, color }) => (
							<stop offset={offset} stop-color={color} />
						))}
					</linearGradient>
					<clipPath id={ref('clip', i)}>
						<path d={shape(r)} />
					</clipPath>
					{/* Light mode, across the width: a blur as wide as the ribbon, fading over all of it. */}
					<filter id={ref('shade', i)} x="-50%" y="-50%" width="200%" height="200%">
						<feGaussianBlur stdDeviation={Math.round(width(r) / 4)} />
					</filter>
					{/* Light mode, along the length: full strength at the first point, faint at the last. */}
					<linearGradient
						id={ref('fade-gradient', i)}
						gradientUnits="userSpaceOnUse"
						x1={r.points[0][0]}
						y1={r.points[0][1]}
						x2={r.points.at(-1)![0]}
						y2={r.points.at(-1)![1]}
					>
						<stop offset="0" stop-color="#ffffff" />
						<stop offset="1" stop-color="#ffffff" stop-opacity="0.4" />
					</linearGradient>
					<mask id={ref('fade', i)} maskUnits="userSpaceOnUse" {...bounds(r)}>
						<rect {...bounds(r)} fill={`url(#${ref('fade-gradient', i)})`} />
					</mask>
				</>
			))
		}
	</defs>
	{
		ribbons.map((r, i) => {
			const paint = `url(#${ref('ribbon', i)})`;
			return (
				<g class="ribbons__ribbon" opacity={r.opacity ?? 1} style={`--fade: url(#${ref('fade', i)})`}>
					{/* Body: a faint tint, lit from the bright edge by a soft inner glow. */}
					<path class="ribbons__body" d={shape(r)} fill={paint} fill-opacity="0.1" />
					<g clip-path={`url(#${ref('clip', i)})`}>
						<path class="ribbons__inner" d={edge(r)} stroke={paint} stroke-width="140" stroke-opacity="0.45" filter={`url(#${ref('soft')})`} />
						<path class="ribbons__shade" d={edge(r)} stroke={paint} stroke-width={width(r)} filter={`url(#${ref('shade', i)})`} />
					</g>
					{/* Edges: the faint one, then the glowing one with a white-hot core. */}
					<path d={faintEdge(r)} stroke={paint} stroke-width="1" stroke-opacity="0.3" />
					<path class="ribbons__glow" d={edge(r)} stroke={paint} stroke-width="36" stroke-opacity="0.35" filter={`url(#${ref('bloom')})`} />
					<path class="ribbons__edge" d={edge(r)} stroke={paint} stroke-width="3" filter={`url(#${ref('neon')})`} />
					<path class="ribbons__glow" d={edge(r)} stroke="#ffffff" stroke-width="1" stroke-opacity="0.8" />
				</g>
			);
		})
	}
</svg>

<!-- Global: scoped styles would tag every one of a scene's ~1000 elements with an attribute. -->
<style is:global>
	:root {
		--ribbon-indigo: #8b5cf6;
		--ribbon-blue: #3b6cff;
		--ribbon-accent: #61dafb;
		--ribbon-teal: #14b8a6;
		--ribbon-magenta: #c026d3;
		--ribbon-pink: #ec4899;
		--ribbon-coral: #ff8a65;
		/* Colour space the ribbon gradients blend in. */
		--ribbon-mix: srgb;
	}

	:root[data-theme="light"] {
		/*
		 * Bright, saturated ribbons, all at the same high lightness (OKLCH L) so none reads dark:
		 * pale tints wash out on a near-white page, deep ones sink into the text.
		 */
		--ribbon-indigo: oklch(0.72 0.2 300);
		--ribbon-blue: oklch(0.72 0.16 260);
		--ribbon-accent: oklch(0.78 0.15 230);
		--ribbon-teal: oklch(0.8 0.15 180);
		--ribbon-magenta: oklch(0.74 0.24 325);
		--ribbon-pink: oklch(0.74 0.2 0);
		--ribbon-coral: oklch(0.77 0.17 40);
		/* Blend round the hue wheel so mixed colours stay vivid instead of turning grey. */
		--ribbon-mix: oklch;
	}

	/* Its own stacking context: ribbons blend with each other, never with the page behind. */
	.ribbons {
		isolation: isolate;
	}

	/*
	 * Light mode: a glow can't read on a near-white page, so the bright edge is a plain line in
	 * the ribbon's colours, with no bloom, neon blur or white core. The ribbon then fades from
	 * high contrast to low both across its width (the shade) and along its length (the mask).
	 */
	:root[data-theme="light"] .ribbons__glow,
	:root[data-theme="light"] .ribbons__inner {
		display: none;
	}
	:root[data-theme="light"] .ribbons__edge {
		filter: none;
	}
	/*
	 * Every ribbon at full strength. Overlapping ribbons of different hues mix into a muddy
	 * grey on white, so they blend with `lighten`: each channel keeps its brightest value and
	 * an overlap never darkens.
	 */
	:root[data-theme="light"] .ribbons__ribbon {
		opacity: 1;
		mix-blend-mode: lighten;
		mask: var(--fade);
	}
	:root[data-theme="light"] .ribbons__body {
		fill-opacity: 0.2;
	}
	.ribbons__shade {
		display: none;
	}
	:root[data-theme="light"] .ribbons__shade {
		display: inline;
	}
</style>
