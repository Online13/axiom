---
// When the button is on screen. `showOn: 'scroll-up'` adds the direction to the threshold.
import StateMachine, { type StateEdge, type StateNode } from '@docs/components/state-machine/state-machine.astro';

const nodes: StateNode[] = [
  { id: 'hidden', label: 'hidden', x: 180, y: 120, caption: "The top of the list is within reach. With showOn: 'scroll-up', the button also stays hidden while the user scrolls down." },
  { id: 'shown', label: 'shown', x: 540, y: 120, caption: 'The offset is past the threshold (one screen by default). A tap brings the list back to 0.' },
];

const edges: StateEdge[] = [
  { from: 'hidden', to: 'shown', label: "offset ≥ threshold ('scroll-up': and scrolling up)", via: [360, 30] },
  { from: 'shown', to: 'hidden', label: 'offset < threshold', via: [360, 200] },
  { from: 'shown', to: 'hidden', label: "scroll down ('scroll-up' only)", via: [360, 290], labelOffset: [0, 4] },
];
---

<StateMachine nodes={nodes} edges={edges} initial="hidden" width={720} height={250} />
