---
// A phone with a photo grid and an Overlay behind a sheet, a menu or a dialog.
// "Open" plays the enter animation, pressing the backdrop plays the exit animation.
// The same backdrop is used by the three components: only the content above it changes.
// `mode="progress"` replaces the open button with a slider that drives the backdrop from the sheet position.
import TokenFrame from '@docs/components/tokens/token-frame.astro';
import { roleColor, type ColorScheme } from '@docs/lib/tokens';

interface Props {
  mode?: 'demo' | 'progress';
}

const { mode = 'demo' } = Astro.props;

const schemeVars = (scheme: ColorScheme) => ({
  '--screen': roleColor(scheme, 'background', 'default'),
  '--subtle': roleColor(scheme, 'background', 'subtle'),
  '--elevated': roleColor(scheme, 'background', 'elevated'),
  '--text': roleColor(scheme, 'content', 'default'),
  '--muted': roleColor(scheme, 'content', 'muted'),
  '--link': roleColor(scheme, 'content', 'link'),
  '--error': roleColor(scheme, 'feedback', 'error'),
  '--border': roleColor(scheme, 'border', 'default'),
  '--divider': roleColor(scheme, 'border', 'subtle'),
});

const colors = { light: schemeVars('light'), dark: schemeVars('dark') };
const initialStyle = Object.entries(colors.light)
  .map(([name, value]) => `${name}:${value}`)
  .join(';');

const consumers = [
  { key: 'sheet', label: 'BottomSheet' },
  { key: 'menu', label: 'Menu' },
  { key: 'dialog', label: 'Dialog' },
];
const tiles = Array.from({ length: 12 });
const actions = ['Share', 'Duplicate', 'Add to album'];
---

<TokenFrame>
  <div
    class="overlay-preview"
    data-mode={mode}
    data-consumer={mode === 'progress' ? 'sheet' : 'dialog'}
    data-open={mode === 'progress' ? 'true' : 'false'}
    data-colors={JSON.stringify(colors)}
    style={initialStyle}
  >
    <div class="flex flex-wrap items-center justify-between gap-2 border-b px-4 py-3">
      {
        mode === 'demo' ? (
          <div class="inline-flex border p-0.5 text-xs" role="group" aria-label="Component">
            {consumers.map(({ key, label }) => (
              <button type="button" class="toggle-button px-3 py-1" data-consumer-button={key} aria-pressed={key === 'dialog' ? 'true' : 'false'}>
                {label}
              </button>
            ))}
          </div>
        ) : (
          <label class="flex items-center gap-3 text-xs">
            <span class="text-fd-muted-foreground">Drag the sheet</span>
            <input type="range" min="0" max="100" value="100" class="progress-input w-40" aria-label="Sheet position" />
          </label>
        )
      }
      <div class="inline-flex border p-0.5 text-xs" role="group" aria-label="Color scheme">
        <button type="button" class="toggle-button px-3 py-1" data-scheme="light" aria-pressed="true">Light</button>
        <button type="button" class="toggle-button px-3 py-1" data-scheme="dark" aria-pressed="false">Dark</button>
      </div>
    </div>

    <div class="stage">
      <div class="phone">
        <div class="screen" style="background:var(--screen)">
          <div class="flex justify-center pt-3">
            <div class="island" />
          </div>
          <div class="flex items-baseline justify-between px-4 pt-5">
            <span style="color:var(--text);font-size:26px;font-weight:700;line-height:1.1">Photos</span>
            {mode === 'demo' && (
              <button type="button" class="open-button" style="color:var(--link);font-size:15px">Open</button>
            )}
          </div>
          <div class="grid grid-cols-3 gap-1 px-4 pt-4">
            {tiles.map((_, i) => (
              <div class="tile" style={`background:var(--subtle);border:1px solid var(--border);opacity:${1 - (i % 4) * 0.12}`} />
            ))}
          </div>

          <button type="button" class="backdrop" aria-label="Close" tabindex="-1" />

          <div class="sheet" style="background:var(--elevated)">
            <div class="mx-auto mt-2 h-[5px] w-9 rounded-full" style="background:var(--border)" />
            <div class="px-4 pb-2 pt-3" style="color:var(--text);font-size:17px;font-weight:600">IMG_0142</div>
            {actions.map((action) => (
              <div class="px-4 py-3" style="color:var(--text);font-size:15px;border-top:1px solid var(--divider)">{action}</div>
            ))}
            <div class="px-4 py-3" style="color:var(--error);font-size:15px;border-top:1px solid var(--divider)">Delete</div>
          </div>

          <div class="menu" style="background:var(--elevated)">
            {actions.map((action, i) => (
              <div class="px-3 py-2.5" style={`color:var(--text);font-size:14px;${i > 0 ? 'border-top:1px solid var(--divider)' : ''}`}>{action}</div>
            ))}
            <div class="px-3 py-2.5" style="color:var(--error);font-size:14px;border-top:1px solid var(--divider)">Delete</div>
          </div>

          <div class="dialog" style="background:var(--elevated)">
            <div class="px-4 pt-4 text-center" style="color:var(--text);font-size:16px;font-weight:600">Delete this photo?</div>
            <div class="px-4 pb-4 pt-1 text-center" style="color:var(--muted);font-size:13px">It will be removed from all your devices.</div>
            <div class="grid grid-cols-2" style="border-top:1px solid var(--divider)">
              <div class="py-2.5 text-center" style="color:var(--link);font-size:15px">Cancel</div>
              <div class="py-2.5 text-center" style="color:var(--error);font-size:15px;font-weight:600;border-left:1px solid var(--divider)">Delete</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t px-4 py-3 font-mono text-xs">
      {
        mode === 'demo' ? (
          <>
            <span class="text-fd-muted-foreground">{'<Overlay '}</span>
            <span>visible=&#123;<span data-visible>false</span>&#125;</span>
            <span class="text-fd-muted-foreground">{' onPress={close} />'}</span>
          </>
        ) : (
          <>
            <span class="text-fd-muted-foreground">progress </span>
            <span data-progress>1.00</span>
            <span class="text-fd-muted-foreground"> → opacity </span>
            <span data-opacity>0.40</span>
          </>
        )
      }
    </div>
  </div>
</TokenFrame>

<style>
  .toggle-button[aria-pressed='true'] {
    background: var(--color-fd-foreground);
    color: var(--color-fd-background);
  }

  .toggle-button[aria-pressed='false'] {
    color: var(--color-fd-muted-foreground);
  }

  .stage {
    display: flex;
    justify-content: center;
    padding-block: 32px;
  }

  .phone {
    width: 280px;
    height: 560px;
    flex-shrink: 0;
    padding: 10px;
    border-radius: 50px;
    background: #1c1c1e;
    box-shadow: 0 0 0 1.5px #3a3a3c;
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 40px;
    font-family: system-ui, sans-serif;
    text-align: left;
    transition: background-color 250ms ease;
  }

  .island {
    width: 90px;
    height: 26px;
    border-radius: 999px;
    background: #000;
  }

  .tile {
    aspect-ratio: 1;
    border-radius: 4px;
  }

  /* --progress goes from 0 (closed) to 1 (open). The backdrop and the content read the same value. */
  .overlay-preview {
    --progress: 0;
    --duration: 250ms;
  }

  .overlay-preview[data-open='true'] {
    --progress: 1;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: calc(var(--progress) * 0.4);
    pointer-events: none;
    transition: opacity var(--duration) ease;
  }

  /* Touches reach the screen again as soon as closing starts, not when the fade ends. */
  .overlay-preview[data-open='true'] .backdrop {
    pointer-events: auto;
    cursor: pointer;
  }

  .sheet,
  .menu,
  .dialog {
    position: absolute;
    visibility: hidden;
    transition:
      transform var(--duration) ease,
      opacity var(--duration) ease,
      background-color 250ms ease;
  }

  .sheet {
    right: 0;
    bottom: 0;
    left: 0;
    padding-bottom: 24px;
    border-radius: 20px 20px 0 0;
    transform: translateY(calc((1 - var(--progress)) * 100%));
  }

  .menu {
    top: 118px;
    right: 16px;
    width: 170px;
    border-radius: 14px;
    transform-origin: top right;
    transform: scale(calc(0.6 + var(--progress) * 0.4));
    opacity: var(--progress);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }

  .dialog {
    top: 50%;
    left: 50%;
    width: 220px;
    border-radius: 16px;
    transform: translate(-50%, -50%) scale(calc(0.9 + var(--progress) * 0.1));
    opacity: var(--progress);
  }

  .overlay-preview[data-consumer='sheet'] .sheet,
  .overlay-preview[data-consumer='menu'] .menu,
  .overlay-preview[data-consumer='dialog'] .dialog {
    visibility: visible;
  }

  /* While the slider moves, nothing animates: the position follows the finger. */
  .overlay-preview[data-mode='progress'] {
    --duration: 0ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay-preview {
      --duration: 0ms;
    }
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('.overlay-preview').forEach((preview) => {
      const colors = JSON.parse(preview.dataset.colors ?? '{}') as Record<string, Record<string, string>>;
      const schemeButtons = preview.querySelectorAll<HTMLButtonElement>('[data-scheme]');
      const consumerButtons = preview.querySelectorAll<HTMLButtonElement>('[data-consumer-button]');
      const visibleLabel = preview.querySelector<HTMLElement>('[data-visible]');

      const setOpen = (open: boolean) => {
        preview.dataset.open = String(open);
        if (visibleLabel) visibleLabel.textContent = String(open);
      };

      schemeButtons.forEach((button) =>
        button.addEventListener('click', () => {
          for (const [name, value] of Object.entries(colors[button.dataset.scheme ?? 'light'])) preview.style.setProperty(name, value);
          schemeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        }),
      );

      consumerButtons.forEach((button) =>
        button.addEventListener('click', () => {
          preview.dataset.consumer = button.dataset.consumerButton;
          consumerButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
          setOpen(true);
        }),
      );

      preview.querySelector('.open-button')?.addEventListener('click', () => setOpen(true));

      const slider = preview.querySelector<HTMLInputElement>('.progress-input');
      if (slider) {
        const update = () => {
          const progress = Number(slider.value) / 100;
          preview.style.setProperty('--progress', String(progress));
          preview.querySelector('[data-progress]')!.textContent = progress.toFixed(2);
          preview.querySelector('[data-opacity]')!.textContent = (progress * 0.4).toFixed(2);
        };
        slider.addEventListener('input', update);
        preview.querySelector('.backdrop')?.addEventListener('click', () => ((slider.value = '0'), update()));
      } else {
        preview.querySelector('.backdrop')?.addEventListener('click', () => setOpen(false));
      }
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
