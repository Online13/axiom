---
// A files list driven by the same rules as Tappable's long press.
// Press a row: it highlights at once and sinks slowly. Release before `delayLongPress` (500ms) and it's a tap.
// Hold until the delay and the row lifts above a blurred screen with its menu. Move more than 10pt first and the press cancels.
// The footer mirrors the gesture: status and elapsed time.
import PhonePreview from '@docs/components/preview/phone-preview.astro';
import Glyph from '@docs/components/preview/glyph.astro';

const files = [
  { name: 'Roadmap.pdf', meta: 'PDF · 1.2 MB', icon: 'file', color: 'red' },
  { name: 'Moodboard.png', meta: 'Image · 4.2 MB', icon: 'image', color: 'green' },
  { name: 'Interview.m4a', meta: 'Audio · 18 MB', icon: 'mic', color: 'orange' },
  { name: 'Contract.pdf', meta: 'PDF · 320 KB', icon: 'lock', color: 'indigo' },
  { name: 'Invoices', meta: 'Folder · 14 items', icon: 'archive', color: 'blue' },
  { name: 'Launch video.mp4', meta: 'Video · 96 MB', icon: 'play', color: 'purple' },
] as const;
---

<PhonePreview>
  <div class="lp" data-long-press>
    <div class="ax-appbar" data-border>
      <span class="ax-appbar-slot" />
      <span class="ax-appbar-title">Files</span>
      <span class="ax-appbar-slot" data-side="end"><span class="ax-icon-btn"><Glyph name="more" /></span></span>
    </div>

    <div class="ax-list" data-variant="plain">
      {
        files.map(({ name, meta, icon, color }) => (
          <div class="ax-item lp-row" data-row data-name={name}>
            <span class="ax-tile" data-color={color}><Glyph name={icon} size={18} /></span>
            <div class="ax-item-content">
              <span class="ax-item-title">{name}</span>
              <span class="ax-item-desc">{meta}</span>
            </div>
          </div>
        ))
      }
    </div>

    <div class="lp-overlay" data-overlay>
      <div class="lp-scrim" data-scrim />
      <div class="lp-lifted" data-lifted>
        <div class="lp-clone" data-clone />
        <div class="ax-menu">
          <span class="ax-menu-item" data-menu-item>Share<Glyph name="share" size={20} /></span>
          <span class="ax-menu-item" data-menu-item>Rename<Glyph name="edit" size={20} /></span>
          <span class="ax-menu-item" data-menu-item>Duplicate<Glyph name="copy" size={20} /></span>
          <span class="ax-menu-item" data-menu-item data-destructive>Delete<Glyph name="trash" size={20} /></span>
        </div>
      </div>
    </div>
  </div>

  <div slot="footer" class="flex flex-col gap-2 border-t px-4 py-3 font-mono text-xs" data-lp-readout>
    <div>
      <span class="text-fd-muted-foreground">status </span><span data-out="status">idle</span>
      <span class="text-fd-muted-foreground"> · elapsed </span><span data-out="elapsed">0</span><span class="text-fd-muted-foreground">/500ms</span>
      <span class="text-fd-muted-foreground"> · </span><span data-out="event" class="text-fd-muted-foreground">press and hold a row</span>
    </div>
    <div class="h-1 overflow-hidden rounded-full bg-fd-muted"><div class="h-full w-0 bg-blue-500" data-out="bar" /></div>
  </div>
</PhonePreview>

<style is:global>
  .lp {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .lp-row {
    cursor: pointer;
    user-select: none;
    touch-action: pan-y;
    -webkit-touch-callout: none;
    transition:
      transform 150ms ease,
      background-color 100ms ease;
  }

  /* Sinks for the whole delay, so the user feels the long press coming. */
  .lp-row[data-pressing] {
    background: var(--ax-background-subtle);
    transform: scale(0.97);
    transition:
      transform 500ms linear,
      background-color 60ms ease;
  }

  .lp-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    visibility: hidden;
  }

  .lp-overlay[data-open] {
    visibility: visible;
  }

  .lp-scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.2);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .lp-overlay[data-open] .lp-scrim {
    opacity: 1;
  }

  .lp-lifted {
    position: absolute;
    inset-inline: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transform: scale(0.97);
    transition: transform 260ms cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  .lp-lifted[data-above] {
    flex-direction: column-reverse;
  }

  .lp-overlay[data-open] .lp-lifted {
    transform: scale(1);
  }

  .lp-clone .ax-item {
    border-radius: 12px;
    background: var(--ax-background-elevated);
    box-shadow: var(--ax-shadow);
  }

  .lp-lifted .ax-menu {
    opacity: 0;
    transform: scale(0.85);
    transform-origin: top left;
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lp-lifted[data-above] .ax-menu {
    transform-origin: bottom left;
  }

  .lp-overlay[data-open] .ax-menu {
    opacity: 1;
    transform: none;
  }

  .lp-lifted [data-menu-item] {
    cursor: pointer;
  }

  .lp-lifted [data-menu-item]:hover {
    background: var(--ax-background-subtle);
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-row,
    .lp-row[data-pressing],
    .lp-lifted,
    .lp-lifted .ax-menu {
      transform: none !important;
      transition: none;
    }
  }
</style>

<script>
  const DELAY = 500;
  const SLOP = 10;

  function init() {
    document.querySelectorAll<HTMLElement>('[data-long-press]:not([data-ready])').forEach((root) => {
      root.dataset.ready = '';
      const overlay = root.querySelector<HTMLElement>('[data-overlay]')!;
      const lifted = root.querySelector<HTMLElement>('[data-lifted]')!;
      const clone = root.querySelector<HTMLElement>('[data-clone]')!;
      const readout = root.closest('[data-ax-preview]')!.querySelector<HTMLElement>('[data-lp-readout]')!;
      const out = (key: string) => readout.querySelector<HTMLElement>(`[data-out="${key}"]`)!;

      let row: HTMLElement | null = null;
      let startX = 0;
      let startY = 0;
      let startTime = 0;
      let timer = 0;
      let frame = 0;

      const report = (status: string, event: string, elapsed = 0) => {
        out('status').textContent = status;
        out('event').textContent = event;
        out('elapsed').textContent = String(Math.round(elapsed));
        out('bar').style.width = `${Math.min(elapsed / DELAY, 1) * 100}%`;
      };

      const tick = () => {
        const elapsed = performance.now() - startTime;
        out('elapsed').textContent = String(Math.round(Math.min(elapsed, DELAY)));
        out('bar').style.width = `${Math.min(elapsed / DELAY, 1) * 100}%`;
        if (row && elapsed < DELAY) frame = requestAnimationFrame(tick);
      };

      const reset = () => {
        clearTimeout(timer);
        cancelAnimationFrame(frame);
        row?.removeAttribute('data-pressing');
        row = null;
      };

      const open = (target: HTMLElement) => {
        navigator.vibrate?.(10);
        clone.replaceChildren(target.cloneNode(true));
        const copy = clone.firstElementChild as HTMLElement;
        copy.removeAttribute('data-pressing');
        copy.removeAttribute('data-row');

        // Lift the row where it is. Near the bottom, the menu opens above it.
        const above = target.offsetTop > root.offsetHeight * 0.55;
        lifted.toggleAttribute('data-above', above);
        lifted.style.top = above ? '' : `${target.offsetTop}px`;
        lifted.style.bottom = above ? `${root.offsetHeight - target.offsetTop - target.offsetHeight}px` : '';
        target.style.visibility = 'hidden';
        overlay.dataset.open = '';
        overlay.dataset.source = target.dataset.name;
      };

      const close = (event: string) => {
        delete overlay.dataset.open;
        root.querySelectorAll<HTMLElement>('[data-row]').forEach((r) => (r.style.visibility = ''));
        report('idle', event);
      };

      root.querySelectorAll<HTMLElement>('[data-row]').forEach((target) => {
        target.addEventListener('contextmenu', (event) => event.preventDefault());

        target.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          reset();
          row = target;
          startX = event.clientX;
          startY = event.clientY;
          startTime = performance.now();
          target.dataset.pressing = '';
          report('pressing', 'onPressIn');
          frame = requestAnimationFrame(tick);
          timer = window.setTimeout(() => {
            if (row !== target) return;
            reset();
            report('recognized', 'onLongPress', DELAY);
            open(target);
          }, DELAY);
        });

        target.addEventListener('pointermove', (event) => {
          if (row !== target) return;
          const zoom = target.getBoundingClientRect().width / target.offsetWidth || 1;
          const moved = Math.hypot(event.clientX - startX, event.clientY - startY) / zoom;
          if (moved > SLOP) {
            const elapsed = performance.now() - startTime;
            reset();
            report('cancelled', `moved ${Math.round(moved)}pt > ${SLOP}pt, no event`, elapsed);
          }
        });

        const release = (event: PointerEvent) => {
          if (row !== target) return;
          const elapsed = performance.now() - startTime;
          reset();
          if (event.type === 'pointerup') report('idle', `onPress: open ${target.dataset.name}`, elapsed);
          else report('cancelled', 'pointer cancelled', elapsed);
        };
        target.addEventListener('pointerup', release);
        target.addEventListener('pointercancel', release);
        target.addEventListener('pointerleave', (event) => {
          if (row === target && event.pointerType === 'mouse') {
            const elapsed = performance.now() - startTime;
            reset();
            report('cancelled', 'left the row, no event', elapsed);
          }
        });
      });

      root.querySelector('[data-scrim]')!.addEventListener('click', () => close('menu dismissed'));
      root.querySelectorAll<HTMLElement>('[data-menu-item]').forEach((item) =>
        item.addEventListener('click', () => close(`${item.textContent?.trim()} ${overlay.dataset.source}`)),
      );
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
