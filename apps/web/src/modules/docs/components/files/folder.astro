---
// A folder of <Files>. Open by default; `open={false}` starts it folded. Without children it's a
// plain row: there's nothing to unfold.
interface Props {
  name: string;
  note?: string;
  open?: boolean;
}

const { name, note, open = true } = Astro.props;
const hasChildren = Astro.slots.has("default");
---

{
  hasChildren ? (
    <details open={open}>
      <summary class="flex cursor-pointer flex-wrap items-center gap-x-3 rounded-md px-2 hover:bg-fd-accent">
        <span class="flex items-center gap-1.5">
          <svg
            class="file-tree-chevron size-3.5 shrink-0 text-fd-muted-foreground transition-transform"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <svg
            class="size-4 shrink-0 text-fd-primary"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
          </svg>
          <span>{name}</span>
        </span>
        {note && <span class="text-fd-muted-foreground"># {note}</span>}
      </summary>
      <div class="ml-[0.9rem] border-l pl-2">
        <slot />
      </div>
    </details>
  ) : (
    <div class="flex flex-wrap items-center gap-x-3 rounded-md px-2">
      <span class="flex items-center gap-1.5">
        {/* The width of the chevron, so names line up. */}
        <span class="size-3.5 shrink-0" aria-hidden="true" />
        <svg
          class="size-4 shrink-0 text-fd-primary"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
        </svg>
        <span>{name}</span>
      </span>
      {note && <span class="text-fd-muted-foreground"># {note}</span>}
    </div>
  )
}
