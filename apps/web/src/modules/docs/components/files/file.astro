---
// A file of <Files>, with an optional note shown like a comment.
interface Props {
  name: string;
  note?: string;
}

const { name, note } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-3 rounded-md px-2">
  <span class="flex items-center gap-1.5">
    {/* The width of a folder's chevron, so names line up. */}
    <span class="size-3.5 shrink-0" aria-hidden="true"></span>
    <svg
      class="size-4 shrink-0 text-fd-muted-foreground"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
      <path d="M14 2v4a2 2 0 0 0 2 2h4" />
    </svg>
    <span>{name}</span>
  </span>
  {note && <span class="text-fd-muted-foreground"># {note}</span>}
</div>
