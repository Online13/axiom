---
// Grid of CompositionCard, read from the compositions data module.
// With `primitive`, only the compositions built with that primitive, the ones derived from it first.
import CompositionCard from './composition-card.astro';
import { compositions, compositionsBuiltWith, type PrimitiveName } from '@docs/data/compositions';

interface Props {
  primitive?: PrimitiveName;
}

const { primitive } = Astro.props;
const items = primitive ? compositionsBuiltWith(primitive) : compositions;
---

<div class="not-prose my-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" data-composition-grid>
  {items.map((composition) => <CompositionCard composition={composition} />)}
</div>
