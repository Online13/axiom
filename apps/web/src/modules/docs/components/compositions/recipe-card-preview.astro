---
// A Recipe Card drawn with the `.ax-*` classes of preview.css, at real iOS sizes. Mirrors registry/compositions/recipe-card.
// It always takes the full width of its list: the card is designed for a vertical feed.
import Spec, { type SpecData } from './spec-item.astro';

interface Props {
  image: string;
  title: string;
  description?: string;
  badge?: string;
  stats?: SpecData[];
  ingredients?: string[];
  maxIngredients?: number;
  action?: string;
}

const {
  image,
  title,
  description,
  badge,
  stats = [],
  ingredients = [],
  maxIngredients = 2,
  action,
} = Astro.props;
const shown = ingredients.slice(0, maxIngredients);
const hidden = ingredients.length - shown.length;
---

<div class="ax-card" style={{ alignSelf: 'stretch' }}>
  <div class="ax-media" style={{ height: 'auto', aspectRatio: '4 / 3', position: 'relative' }}>
    <img src={`/images/recipes/${image}.webp`} alt="" loading="lazy" />
    {
      badge && (
        <span class="ax-badge" data-variant="highlight" style={{ position: 'absolute', top: '12px', left: '12px' }}>
          {badge}
        </span>
      )
    }
  </div>
  <div class="ax-stack" data-gap="4" style={{ padding: '16px 16px 0' }}>
    <span class="ax-headline">{title}</span>
    {description && <span class="ax-subhead ax-muted clamp">{description}</span>}
  </div>
  {
    stats.length > 0 && (
      <div class="ax-stack" data-gap="12" style={{ padding: '16px 16px 0' }}>
        <span class="ax-separator" data-variant="subtle" />
        <div class="ax-row" style={{ gap: '12px', justifyContent: 'space-between' }}>
          {stats.map((stat, index) => (
            <>
              {index > 0 && <span class="ax-separator" data-orientation="vertical" data-variant="subtle" />}
              <Spec spec={stat} />
            </>
          ))}
        </div>
        <span class="ax-separator" data-variant="subtle" />
      </div>
    )
  }
  {
    shown.length > 0 && (
      <div class="ax-row" style={{ gap: '8px', flexWrap: 'wrap', padding: '16px 16px 0' }}>
        {shown.map((ingredient) => (
          <span class="ax-chip chip" data-variant="filled">{ingredient}</span>
        ))}
        {hidden > 0 && <span class="ax-chip chip" data-variant="filled">+{hidden}</span>}
      </div>
    )
  }
  {
    action && (
      <div style={{ padding: '16px 16px 0' }}>
        <span class="ax-btn" data-block>{action}</span>
      </div>
    )
  }
  <div style={{ height: '16px' }}></div>
</div>

<style>
  .clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .chip {
    height: 28px;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 500;
  }
</style>
