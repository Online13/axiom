const { name, size = 22, class: className, strokeWidth = 1.9, style } = Astro.props;
const filled = name === 'play';
---

<svg
  class:list={['ax-glyph', className]}
  style={style}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={paths[name]} /></svg>
