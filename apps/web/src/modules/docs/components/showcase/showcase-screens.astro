---
// Three schematic screens for a showcase app, side by side with a caption each.
// Same drawing language as ShowcaseCard: docs palette only, so it follows the light / dark theme.

import Glyph from '@docs/components/preview/glyph.astro';

interface Props {
  app: 'demo' | 'tempo' | 'tally' | 'atlas' | 'chapter' | 'corner';
}

const { app } = Astro.props;

const frame =
  'relative flex h-[168px] w-[96px] shrink-0 flex-col overflow-hidden rounded-[12px] border border-fd-border bg-fd-background leading-none text-fd-muted-foreground';
const line = 'block h-1 rounded-full bg-fd-muted-foreground/30';
const strong = 'block h-1 rounded-full bg-fd-foreground/70';
const dot = 'size-3 shrink-0 rounded-full bg-fd-muted-foreground/30';
const box = 'border border-fd-border bg-fd-background';
const accent = 'text-fd-foreground';
const bar = 'flex h-6 items-center justify-around border-t border-fd-border bg-fd-background';
const caption = 'text-xs text-fd-muted-foreground';

const captions: Record<Props['app'], [string, string, string]> = {
  demo: ['Catalog', 'Component screen', 'Foundations'],
  tempo: ['Today', 'Reorder', 'Streaks'],
  tally: ['Balances', 'Add expense', 'Settle up'],
  atlas: ['Map', 'Place sheet', 'Search'],
  chapter: ['Reader', 'Highlight', 'Notes'],
  corner: ['Storefront', 'Product', 'Checkout'],
};

const [first, second, third] = captions[app];
---

<div class="not-prose my-6 flex flex-wrap justify-center gap-4 sm:gap-6" aria-hidden="true">
  <div class="flex flex-col items-center gap-2">
    <div class={frame}>
      {app === 'demo' && (
        <>
          <span class={`flex h-7 items-center px-2 text-[9px] font-semibold ${accent}`}>Components</span>
          <span class="flex flex-col gap-1 px-2">
            {['Atoms', 'Molecules', 'Organisms', 'Templates'].map((group) => (
              <span class={`flex h-6 items-center justify-between rounded-[5px] ${box} px-1.5 text-[8px] ${accent}`}>
                <span>{group}</span>
                <Glyph name="chevron-right" size={8} strokeWidth={2.4} />
              </span>
            ))}
          </span>
          <span class={`absolute inset-x-0 bottom-0 ${bar} ${accent}`}>
            <Glyph name="grid" size={10} strokeWidth={2.4} />
            <Glyph name="sliders" size={10} strokeWidth={2.4} />
            <Glyph name="sun" size={10} strokeWidth={2.4} />
          </span>
        </>
      )}

      {app === 'tempo' && (
        <>
          <span class="flex items-baseline justify-between px-2 pt-4">
            <span class={`text-[10px] font-semibold ${accent}`}>Today</span>
            <span class="text-[8px]">6 of 8</span>
          </span>
          <span class="mt-2 flex flex-col gap-2 px-2">
            {[true, true, false, false].map((done) => (
              <span class="flex items-center gap-2">
                {done ? (
                  <span class="flex size-3.5 shrink-0 items-center justify-center rounded-full bg-fd-foreground text-fd-background"><Glyph name="check" size={8} strokeWidth={3} /></span>
                ) : (
                  <span class="size-3.5 shrink-0 rounded-full border border-fd-muted-foreground/50" />
                )}
                <span class={`${done ? strong : line} flex-1`} />
              </span>
            ))}
          </span>
          <span class="absolute bottom-8 right-2 flex size-7 items-center justify-center rounded-full bg-fd-foreground text-fd-background"><Glyph name="plus" size={12} strokeWidth={2.8} /></span>
          <span class={`absolute inset-x-0 bottom-0 ${bar} ${accent}`}>
            <Glyph name="check" size={10} strokeWidth={2.4} />
            <Glyph name="calendar" size={10} strokeWidth={2.4} />
            <Glyph name="user" size={10} strokeWidth={2.4} />
          </span>
        </>
      )}

      {app === 'tally' && (
        <>
          <span class={`mx-2 mt-4 flex flex-col gap-1 rounded-[6px] ${box} p-2`}>
            <span class="text-[8px]">You are owed</span>
            <span class={`text-[13px] font-semibold ${accent}`}>42.50</span>
          </span>
          <span class="mt-2 flex flex-col gap-2 px-2">
            {['+12.00', '-8.40', '+5.25'].map((amount) => (
              <span class="flex items-center gap-2">
                <span class={dot} />
                <span class={`${line} flex-1`} />
                <span class={`text-[8px] font-semibold ${accent}`}>{amount}</span>
              </span>
            ))}
          </span>
          <span class={`absolute inset-x-0 bottom-0 ${bar} ${accent}`}>
            <Glyph name="wallet" size={10} strokeWidth={2.4} />
            <Glyph name="users" size={10} strokeWidth={2.4} />
            <Glyph name="user" size={10} strokeWidth={2.4} />
          </span>
        </>
      )}

      {app === 'atlas' && (
        <>
          <span class="absolute inset-0 bg-fd-muted/70" />
          <span class="absolute inset-0">
            <span class="absolute left-0 top-10 h-px w-full bg-fd-border" />
            <span class="absolute left-0 top-24 h-px w-full bg-fd-border" />
            <span class="absolute left-8 top-0 h-full w-px bg-fd-border" />
            <span class="absolute left-20 top-0 h-full w-px bg-fd-border" />
          </span>
          <span class={`absolute left-4 top-12 ${accent}`}><Glyph name="pin" size={13} strokeWidth={2.4} /></span>
          <span class={`absolute left-14 top-20 ${accent}`}><Glyph name="pin" size={13} strokeWidth={2.4} /></span>
          <span class={`absolute left-6 top-24 ${accent}`}><Glyph name="pin" size={13} strokeWidth={2.4} /></span>
          <span class={`absolute inset-x-2 top-4 flex h-6 items-center gap-1.5 rounded-full ${box} px-2`}>
            <Glyph name="search" size={9} strokeWidth={2.6} class={accent} />
            <span class={`${line} w-2/3`} />
          </span>
          <span class="absolute inset-x-0 bottom-0 rounded-t-[10px] border-t border-fd-border bg-fd-background p-2">
            <span class="mx-auto mb-2 block h-1 w-7 rounded-full bg-fd-muted-foreground/40" />
            <span class="flex flex-col gap-1.5">
              <span class={`${strong} w-2/3`} />
              <span class={`${line} w-full`} />
            </span>
          </span>
        </>
      )}

      {app === 'chapter' && (
        <>
          <span class={`flex h-7 items-center justify-between px-2 text-[8px] ${accent}`}>
            <Glyph name="chevron-left" size={9} strokeWidth={2.4} />
            <span>Chapter 4</span>
            <Glyph name="more" size={9} strokeWidth={2.8} />
          </span>
          <span class="flex flex-col gap-2 px-2">
            {[1, 0.95, 0.9, 1, 0.7, 1, 0.85].map((width) => (
              <span class={line} style={{ width: `${width * 100}%` }} />
            ))}
          </span>
          <span class="absolute inset-x-2 bottom-3 flex items-center gap-1.5">
            <span class="h-1 flex-1 rounded-full bg-fd-muted-foreground/20">
              <span class="block h-1 w-2/3 rounded-full bg-fd-foreground/60" />
            </span>
            <span class="text-[8px]">62%</span>
          </span>
        </>
      )}

      {app === 'corner' && (
        <>
          <span class="flex items-center justify-between px-2 pt-4">
            <span class={`text-[10px] font-semibold ${accent}`}>Corner</span>
            <span class={`relative ${accent}`}>
              <Glyph name="bag" size={12} strokeWidth={2.4} />
              <span class="absolute -right-1 -top-1 flex size-2.5 items-center justify-center rounded-full bg-fd-foreground text-[5px] font-semibold text-fd-background">2</span>
            </span>
          </span>
          <span class="mt-2 flex gap-1 px-2">
            {['All', 'Bread', 'Wine'].map((chip, index) => (
              <span class:list={[`rounded-full px-1 py-0.5 text-[6px] font-medium`, index === 0 ? 'bg-fd-foreground text-fd-background' : `${box} ${accent}`]}>{chip}</span>
            ))}
          </span>
          <span class="mt-2 grid grid-cols-2 gap-1.5 px-2">
            {[0, 1, 2, 3].map(() => (
              <span class={`flex h-12 flex-col justify-end rounded-[5px] ${box} p-1`}>
                <span class={`${line} w-full`} />
                <span class={`mt-1 text-[7px] font-semibold ${accent}`}>$18</span>
              </span>
            ))}
          </span>
        </>
      )}
    </div>
    <span class={caption}>{first}</span>
  </div>

  <div class="flex flex-col items-center gap-2">
    <div class={frame}>
      {app === 'demo' && (
        <>
          <span class={`flex h-7 items-center gap-1.5 px-2 text-[9px] font-semibold ${accent}`}>
            <Glyph name="chevron-left" size={9} strokeWidth={2.4} />
            <span>Button</span>
          </span>
          <span class="flex flex-col gap-1.5 px-2">
            <span class="flex h-6 items-center justify-center rounded-[5px] bg-fd-foreground text-[8px] font-semibold text-fd-background">Solid</span>
            <span class={`flex h-6 items-center justify-center rounded-[5px] border-2 border-fd-foreground/70 text-[8px] font-semibold ${accent}`}>Outline</span>
            <span class={`flex h-6 items-center justify-center rounded-[5px] text-[8px] font-semibold ${accent}`}>Ghost</span>
            <span class="flex h-6 items-center justify-center rounded-[5px] bg-fd-muted text-[8px] font-semibold opacity-50">Disabled</span>
          </span>
          <span class={`absolute inset-x-2 bottom-2 flex items-center justify-between rounded-[5px] ${box} px-1.5 py-1 text-[7px] ${accent}`}>
            <span>stylesheet</span>
            <span class="opacity-40">unistyles</span>
          </span>
        </>
      )}

      {app === 'tempo' && (
        <>
          <span class={`flex h-7 items-center justify-between px-2 text-[8px] font-semibold ${accent}`}>
            <span>Reorder</span>
            <span>Done</span>
          </span>
          <span class="flex flex-col gap-2 px-2">
            {[0, 1, 2].map((index) => (
              <span
                class:list={[
                  'flex items-center gap-2 rounded-[5px] px-1.5 py-1.5',
                  index === 1 ? `${box} shadow-sm` : '',
                ]}
                style={index === 1 ? { transform: 'translateY(6px) scale(1.04)' } : undefined}
              >
                <span class={`${index === 1 ? strong : line} flex-1`} />
                <Glyph name="menu" size={9} strokeWidth={2.4} class={index === 1 ? accent : ''} />
              </span>
            ))}
          </span>
          <span class="mx-2 mt-1 border-t border-dashed border-fd-foreground/40" />
          <span class="flex flex-col gap-2 px-2 pt-2">
            <span class="flex items-center gap-2"><span class={`${line} flex-1`} /><Glyph name="menu" size={9} strokeWidth={2.4} /></span>
          </span>
        </>
      )}

      {app === 'tally' && (
        <>
          <span class={`flex h-7 items-center justify-between px-2 text-[8px] font-semibold ${accent}`}>
            <Glyph name="close" size={9} strokeWidth={2.6} />
            <span>New expense</span>
            <span>Save</span>
          </span>
          <span class={`mx-2 flex h-9 items-center justify-center rounded-[6px] ${box} text-[15px] font-semibold ${accent}`}>24.00</span>
          <span class="mt-2 flex flex-col gap-2 px-2">
            <span class={`flex h-6 items-center gap-1.5 rounded-[5px] ${box} px-1.5`}><Glyph name="file" size={9} strokeWidth={2.2} /><span class={`${line} flex-1`} /></span>
            <span class={`flex h-6 items-center gap-1.5 rounded-[5px] ${box} px-1.5`}><Glyph name="users" size={9} strokeWidth={2.2} /><span class={`${line} w-1/2`} /></span>
          </span>
          <span class="absolute inset-x-0 bottom-0 flex h-9 items-center justify-around border-t border-fd-border bg-fd-muted/60 text-[9px]">
            {['1', '2', '3'].map((key) => (
              <span class={`flex size-6 items-center justify-center rounded-[4px] ${box} ${accent}`}>{key}</span>
            ))}
          </span>
        </>
      )}

      {app === 'atlas' && (
        <>
          <span class="h-20 bg-fd-muted/70" />
          <span class="absolute inset-x-0 top-14 bottom-0 rounded-t-[10px] border-t border-fd-border bg-fd-background p-2">
            <span class="mx-auto mb-2 block h-1 w-7 rounded-full bg-fd-muted-foreground/40" />
            <span class={`block text-[9px] font-semibold ${accent}`}>Café Lumière</span>
            <span class="mt-1 flex items-center gap-1">
              {[0, 1, 2, 3].map(() => <Glyph name="star" size={7} strokeWidth={2.4} class={accent} />)}
              <span class="text-[7px]">4.2</span>
            </span>
            <span class="mt-2 flex gap-1.5">
              <span class={`h-8 flex-1 rounded-[4px] ${box}`} />
              <span class={`h-8 flex-1 rounded-[4px] ${box}`} />
              <span class={`h-8 w-4 rounded-[4px] ${box} opacity-50`} />
            </span>
            <span class="mt-2 flex h-6 items-center justify-center rounded-[5px] bg-fd-foreground text-[8px] font-semibold text-fd-background">Directions</span>
          </span>
        </>
      )}

      {app === 'chapter' && (
        <>
          <span class="flex flex-col gap-2 px-2 pt-7">
            <span class={line} />
            <span class="flex gap-1">
              <span class="block h-1 w-1/3 rounded-full bg-fd-foreground/70" />
              <span class="block h-1 flex-1 rounded-full bg-fd-foreground/70" />
            </span>
            <span class="flex gap-1">
              <span class="block h-1 w-1/2 rounded-full bg-fd-foreground/70" />
              <span class={`${line} flex-1`} />
            </span>
            <span class={line} />
          </span>
          <span class="absolute inset-x-3 top-11 flex items-center justify-around rounded-[5px] bg-fd-foreground px-1.5 py-1.5 text-fd-background">
            <Glyph name="edit" size={9} strokeWidth={2.6} />
            <Glyph name="copy" size={9} strokeWidth={2.6} />
            <Glyph name="share" size={9} strokeWidth={2.6} />
            <Glyph name="more" size={9} strokeWidth={2.8} />
          </span>
        </>
      )}

      {app === 'corner' && (
        <>
          <span class="h-16 bg-fd-muted/70" />
          <span class="flex flex-col gap-1.5 px-2 pt-2">
            <span class={`text-[9px] font-semibold ${accent}`}>Sourdough</span>
            <span class={`text-[11px] font-semibold ${accent}`}>$18</span>
            <span class={line} />
            <span class={`${line} w-2/3`} />
          </span>
          <span class="absolute inset-x-2 bottom-3 flex items-center gap-1.5">
            <span class={`flex h-7 w-12 items-center justify-between rounded-[5px] ${box} px-1.5 ${accent}`}>
              <Glyph name="minus" size={9} strokeWidth={2.6} />
              <span class="text-[8px] font-semibold">1</span>
              <Glyph name="plus" size={9} strokeWidth={2.6} />
            </span>
            <span class="flex h-7 flex-1 items-center justify-center rounded-[5px] bg-fd-foreground text-[8px] font-semibold text-fd-background">Add</span>
          </span>
        </>
      )}
    </div>
    <span class={caption}>{second}</span>
  </div>

  <div class="flex flex-col items-center gap-2">
    <div class={frame}>
      {app === 'demo' && (
        <>
          <span class={`flex h-7 items-center px-2 text-[9px] font-semibold ${accent}`}>Foundations</span>
          <span class="flex gap-1 px-2">
            {['bg-fd-foreground', 'bg-fd-foreground/70', 'bg-fd-foreground/40', 'bg-fd-muted-foreground/30'].map((tone) => (
              <span class:list={['h-6 flex-1 rounded-[4px]', tone]} />
            ))}
          </span>
          <span class="mt-2 flex flex-col gap-1.5 px-2">
            <span class={`text-[11px] font-semibold ${accent}`}>Title</span>
            <span class={`text-[8px] ${accent}`}>Body</span>
            <span class="text-[7px]">Caption</span>
          </span>
          <span class="mt-2 flex items-end gap-1 px-2">
            {[4, 8, 12, 16, 20].map((size) => (
              <span class="w-2 rounded-[2px] bg-fd-foreground/40" style={{ height: `${size}px` }} />
            ))}
          </span>
        </>
      )}

      {app === 'tempo' && (
        <>
          <span class={`flex h-7 items-center px-2 text-[9px] font-semibold ${accent}`}>Streaks</span>
          <span class="grid grid-cols-7 gap-1 px-2">
            {[1, 1, 0.5, 1, 0.2, 1, 1, 0.5, 1, 1, 1, 0.2, 1, 0.5, 1, 1, 0.5, 0.2, 1, 1, 1].map((level) => (
              <span class="aspect-square rounded-[2px] bg-fd-foreground" style={{ opacity: level * 0.8 }} />
            ))}
          </span>
          <span class="mt-3 flex items-end justify-between px-2">
            {[8, 14, 6, 18, 12, 20, 15].map((height) => (
              <span class="w-2 rounded-t-[2px] bg-fd-foreground/40" style={{ height: `${height}px` }} />
            ))}
          </span>
          <span class={`absolute inset-x-0 bottom-0 ${bar} ${accent}`}>
            <Glyph name="check" size={10} strokeWidth={2.4} />
            <Glyph name="calendar" size={10} strokeWidth={2.4} />
            <Glyph name="user" size={10} strokeWidth={2.4} />
          </span>
        </>
      )}

      {app === 'tally' && (
        <>
          <span class={`flex h-7 items-center px-2 text-[9px] font-semibold ${accent}`}>Settle up</span>
          <span class="flex flex-col gap-2 px-2">
            {['Ana', 'Ravo', 'Sam'].map((name, index) => (
              <span class={`flex items-center gap-1.5 rounded-[5px] ${box} p-1.5`}>
                <span class={dot} />
                <span class={`flex-1 text-[8px] ${accent}`}>{name}</span>
                <span class={`text-[8px] font-semibold ${accent}`}>{index === 1 ? '-8.40' : '+12.00'}</span>
              </span>
            ))}
          </span>
          <span class="absolute inset-x-2 bottom-8 rounded-[5px] bg-fd-foreground px-2 py-1.5 text-fd-background">
            <span class="flex items-center justify-between text-[8px] font-semibold"><span>Marked as paid</span><span>Undo</span></span>
            <span class="mt-1 block h-0.5 w-2/3 rounded-full bg-fd-background/60" />
          </span>
        </>
      )}

      {app === 'atlas' && (
        <>
          <span class={`mx-2 mt-4 flex h-6 items-center gap-1.5 rounded-full ${box} px-2`}>
            <Glyph name="search" size={9} strokeWidth={2.6} class={accent} />
            <span class={`${strong} w-1/2`} />
            <Glyph name="close" size={8} strokeWidth={2.6} />
          </span>
          <span class="mt-2 flex flex-col gap-2 px-2">
            {[0, 1].map(() => (
              <span class="flex items-center gap-1.5"><Glyph name="clock" size={9} strokeWidth={2.2} /><span class={`${line} flex-1`} /></span>
            ))}
          </span>
          <span class="mx-2 my-2 border-t border-dashed border-fd-border" />
          <span class="flex flex-col gap-2 px-2">
            {[0, 1, 2].map(() => (
              <span class="flex items-center gap-1.5"><Glyph name="pin" size={9} strokeWidth={2.2} class={accent} /><span class={`${strong} flex-1`} /></span>
            ))}
          </span>
        </>
      )}

      {app === 'chapter' && (
        <>
          <span class={`flex h-7 items-center justify-between px-2 text-[9px] font-semibold ${accent}`}>
            <span>Notes</span>
            <Glyph name="filter" size={9} strokeWidth={2.4} />
          </span>
          <span class="flex flex-col gap-2 px-2">
            {[0, 1, 2].map(() => (
              <span class={`flex flex-col gap-1 rounded-[5px] ${box} p-1.5`}>
                <span class="flex gap-1"><span class="block h-1 w-1/3 rounded-full bg-fd-foreground/70" /><span class={`${line} flex-1`} /></span>
                <span class={`${line} w-2/3`} />
              </span>
            ))}
          </span>
          <span class={`absolute inset-x-0 bottom-0 ${bar} ${accent}`}>
            <Glyph name="file" size={10} strokeWidth={2.4} />
            <Glyph name="edit" size={10} strokeWidth={2.4} />
            <Glyph name="search" size={10} strokeWidth={2.4} />
          </span>
        </>
      )}

      {app === 'corner' && (
        <>
          <span class={`flex h-7 items-center justify-between px-2 text-[9px] font-semibold ${accent}`}>
            <Glyph name="chevron-left" size={9} strokeWidth={2.4} />
            <span>Checkout</span>
            <span />
          </span>
          <span class="flex flex-col gap-2 px-2">
            <span class={`flex items-center justify-between rounded-[5px] ${box} p-1.5 text-[8px] ${accent}`}><span>Delivery</span><Glyph name="chevron-right" size={8} strokeWidth={2.4} /></span>
            <span class={`flex items-center justify-between rounded-[5px] ${box} p-1.5 text-[8px] ${accent}`}><span>Card ••42</span><Glyph name="card" size={9} strokeWidth={2.2} /></span>
          </span>
          <span class="mx-2 mt-2 flex items-center justify-between border-t border-fd-border pt-2">
            <span class="text-[8px]">Total</span>
            <span class={`text-[10px] font-semibold ${accent}`}>$36</span>
          </span>
          <span class="absolute inset-x-2 bottom-3 flex h-7 items-center justify-center rounded-[5px] bg-fd-foreground text-[8px] font-semibold text-fd-background">Pay</span>
        </>
      )}
    </div>
    <span class={caption}>{third}</span>
  </div>
</div>
