---
// Every component that can play a haptic, grouped by who decides: the component itself, an option, or the app.
// Each tile draws a small schematic of the component; the pulsing ring marks where and when the haptic plays.
// Illustrations use the docs palette only, so they follow the light / dark theme.

import Glyph from '@docs/components/preview/glyph.astro';

type Kind = 'light' | 'medium' | 'heavy' | 'selection' | 'success' | 'warning' | 'error';

interface Tile {
  name: string;
  moment: string;
  kind: Kind;
  preview: string;
  // Position of the pulse inside the schematic, in %.
  at: [number, number];
}

const groups: { title: string; note: [string, string, string]; mode: 'built-in' | 'optional' | 'opt-in'; tiles: Tile[] }[] = [
  {
    title: 'Built in',
    note: ['The haptic is part of the interaction. On by default, ', 'haptic={false}', ' turns it off.'],
    mode: 'built-in',
    tiles: [
      { name: 'Switch', moment: 'The value flips', kind: 'light', preview: 'switch', at: [66, 50] },
      { name: 'SegmentedControl', moment: 'The segment changes', kind: 'selection', preview: 'segmented', at: [50, 50] },
      { name: 'Slider', moment: 'Each step, and at min / max', kind: 'selection', preview: 'slider', at: [60, 50] },
      { name: 'DatePicker', moment: 'A day or a preset is picked', kind: 'selection', preview: 'calendar', at: [62, 56] },
      { name: 'Menu', moment: 'Opens on long press', kind: 'medium', preview: 'menu', at: [30, 26] },
      { name: 'Pull to refresh', moment: 'The pull reaches the threshold', kind: 'light', preview: 'refresh', at: [50, 22] },
      { name: 'Passcode · InputOTP', moment: 'The code is wrong', kind: 'error', preview: 'passcode', at: [50, 50] },
    ],
  },
  {
    title: 'Optional',
    note: ['Useful, but not a platform standard. Off by default, ', 'haptic="selection"', ' turns it on.'],
    mode: 'optional',
    tiles: [
      { name: 'Checkbox · Radio', moment: 'The value changes', kind: 'selection', preview: 'check', at: [30, 36] },
      { name: 'Tab · BottomTabBar', moment: 'The tab changes', kind: 'selection', preview: 'tabs', at: [38, 78] },
      { name: 'BottomSheet', moment: 'Settles on a snap point after a drag', kind: 'light', preview: 'sheet', at: [50, 40] },
      { name: 'Carousel', moment: 'A swipe lands on another item', kind: 'selection', preview: 'carousel', at: [50, 50] },
    ],
  },
  {
    title: 'Left to the app',
    note: ['Only the app knows if the moment deserves one. Pass ', 'haptic', ' where it does.'],
    mode: 'opt-in',
    tiles: [
      { name: 'Button · IconButton · FloatingButton', moment: 'An important action, like Pay', kind: 'light', preview: 'button', at: [56, 50] },
      { name: 'Chip · Item', moment: 'Rarely: a tap on a row is not an event', kind: 'light', preview: 'rows', at: [60, 30] },
      { name: 'Toast · Snackbar', moment: 'The result of an action the user just made', kind: 'success', preview: 'toast', at: [50, 70] },
    ],
  },
];

const line = 'block h-1 rounded-full bg-fd-muted-foreground/30';
const strong = 'block h-1 rounded-full bg-fd-foreground/70';
const box = 'border border-fd-border bg-fd-background';
const modeClass = {
  'built-in': 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400',
  optional: 'bg-sky-500/15 text-sky-700 dark:text-sky-400',
  'opt-in': 'bg-fd-muted-foreground/15 text-fd-muted-foreground',
};
---

<div class="not-prose my-6 flex flex-col gap-6">
  {
    groups.map((group) => (
      <section class="flex flex-col gap-3">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class={`px-2 py-0.5 text-xs font-medium ${modeClass[group.mode]}`}>{group.title}</span>
          <span class="text-sm text-fd-muted-foreground">{group.note[0]}<code>{group.note[1]}</code>{group.note[2]}</span>
        </div>
        <div class="grid gap-px border bg-fd-border sm:grid-cols-2 lg:grid-cols-3">
          {group.tiles.map((tile) => (
            <div class="flex flex-col bg-fd-card">
              <div class="flex h-28 items-center justify-center bg-fd-muted/60" aria-hidden="true">
                <div class="hm-stage relative flex h-[72px] w-[112px] items-center justify-center text-fd-muted-foreground">
                  {tile.preview === 'switch' && (
                    <span class="relative block h-7 w-12 rounded-full bg-fd-foreground/80">
                      <span class="absolute right-0.5 top-0.5 size-6 rounded-full bg-fd-background" />
                    </span>
                  )}
                  {tile.preview === 'segmented' && (
                    <span class={`flex h-7 w-full gap-0.5 rounded-md p-0.5 ${box}`}>
                      <span class="flex-1" />
                      <span class="flex-1 rounded-[5px] bg-fd-foreground/80" />
                      <span class="flex-1" />
                    </span>
                  )}
                  {tile.preview === 'slider' && (
                    <span class="relative flex h-6 w-full items-center">
                      <span class="absolute inset-x-0 h-1 rounded-full bg-fd-muted-foreground/30" />
                      <span class="absolute left-0 h-1 w-[60%] rounded-full bg-fd-foreground/80" />
                      {[0, 20, 40, 60, 80, 100].map((x) => (
                        <span class="absolute top-full mt-1 h-1.5 w-px bg-fd-muted-foreground/50" style={`left:${x}%`} />
                      ))}
                      <span class="absolute left-[60%] size-5 -translate-x-1/2 rounded-full border border-fd-border bg-fd-background shadow-sm" />
                    </span>
                  )}
                  {tile.preview === 'calendar' && (
                    <span class="grid grid-cols-5 gap-1">
                      {Array.from({ length: 15 }, (_, i) => (
                        <span class:list={['size-3.5 rounded-full', i === 8 ? 'bg-fd-foreground/80' : 'bg-fd-muted-foreground/25']} />
                      ))}
                    </span>
                  )}
                  {tile.preview === 'menu' && (
                    <span class="relative h-full w-full">
                      <span class={`absolute left-0 top-1 flex h-5 w-3/5 items-center rounded-md px-1.5 ${box}`}><span class={`${strong} w-full`} /></span>
                      <span class={`absolute right-0 top-8 flex w-3/5 flex-col gap-1.5 rounded-md p-1.5 shadow-md ${box}`}>
                        <span class={line} /><span class={`${line} w-2/3`} /><span class={`${line} w-3/4`} />
                      </span>
                    </span>
                  )}
                  {tile.preview === 'refresh' && (
                    <span class={`flex h-full w-4/5 flex-col overflow-hidden rounded-md ${box}`}>
                      <span class="flex h-7 items-center justify-center"><Glyph name="refresh" size={13} class="text-fd-foreground" strokeWidth={2.4} /></span>
                      <span class="flex flex-col gap-1.5 border-t border-fd-border p-1.5"><span class={`${strong} w-3/4`} /><span class={line} /><span class={`${line} w-2/3`} /></span>
                    </span>
                  )}
                  {tile.preview === 'passcode' && (
                    <span class="hm-shake flex gap-2">
                      {[0, 1, 2, 3].map(() => <span class="size-3 rounded-full bg-red-500/80" />)}
                    </span>
                  )}
                  {tile.preview === 'check' && (
                    <span class="flex flex-col gap-3">
                      <span class="flex items-center gap-2">
                        <span class="flex size-5 items-center justify-center rounded-[5px] bg-fd-foreground/80 text-fd-background"><Glyph name="check" size={13} strokeWidth={3} /></span>
                        <span class={`${line} w-12`} />
                      </span>
                      <span class="flex items-center gap-2">
                        <span class="flex size-5 items-center justify-center rounded-full border-2 border-fd-muted-foreground/40" />
                        <span class={`${line} w-10`} />
                      </span>
                    </span>
                  )}
                  {tile.preview === 'tabs' && (
                    <span class={`flex h-full w-4/5 flex-col overflow-hidden rounded-md ${box}`}>
                      <span class="flex flex-1 flex-col gap-1.5 p-1.5"><span class={`${line} w-2/3`} /><span class={line} /></span>
                      <span class="flex h-6 items-center justify-around border-t border-fd-border">
                        <Glyph name="home" size={11} />
                        <Glyph name="search" size={11} class="text-fd-foreground" strokeWidth={2.4} />
                        <Glyph name="bell" size={11} />
                        <Glyph name="user" size={11} />
                      </span>
                    </span>
                  )}
                  {tile.preview === 'sheet' && (
                    <span class={`relative flex h-full w-4/5 flex-col overflow-hidden rounded-md ${box}`}>
                      <span class="absolute inset-x-0 top-[40%] border-t border-dashed border-fd-muted-foreground/50" />
                      <span class="absolute inset-x-0 bottom-0 top-[40%] flex flex-col items-center gap-1.5 rounded-t-md border-t border-fd-border bg-fd-card p-1.5">
                        <span class="h-1 w-5 rounded-full bg-fd-muted-foreground/40" />
                        <span class={`${line} w-3/4`} />
                      </span>
                    </span>
                  )}
                  {tile.preview === 'carousel' && (
                    <span class="flex w-full flex-col items-center gap-2">
                      <span class="flex w-full items-center gap-1.5">
                        <span class={`h-10 w-3 rounded-r-md opacity-50 ${box}`} />
                        <span class={`h-12 flex-1 rounded-md ${box}`} />
                        <span class={`h-10 w-3 rounded-l-md opacity-50 ${box}`} />
                      </span>
                      <span class="flex gap-1">
                        <span class="size-1.5 rounded-full bg-fd-muted-foreground/40" />
                        <span class="size-1.5 rounded-full bg-fd-foreground/80" />
                        <span class="size-1.5 rounded-full bg-fd-muted-foreground/40" />
                      </span>
                    </span>
                  )}
                  {tile.preview === 'button' && (
                    <span class="flex h-8 w-full items-center justify-center rounded-md bg-fd-foreground/80"><span class="block h-1 w-10 rounded-full bg-fd-background/80" /></span>
                  )}
                  {tile.preview === 'rows' && (
                    <span class="flex w-full flex-col gap-2">
                      <span class="flex gap-1.5">
                        <span class={`h-5 w-12 rounded-full ${box}`} />
                        <span class={`h-5 w-10 rounded-full ${box}`} />
                      </span>
                      <span class={`flex h-7 items-center gap-1.5 rounded-md px-1.5 ${box}`}><span class="size-3.5 rounded-full bg-fd-muted-foreground/30" /><span class={`${line} flex-1`} /></span>
                    </span>
                  )}
                  {tile.preview === 'toast' && (
                    <span class={`flex h-8 w-full items-center gap-1.5 rounded-md px-2 shadow-md ${box}`}>
                      <Glyph name="circle-check" size={13} class="text-emerald-600 dark:text-emerald-400" strokeWidth={2.2} />
                      <span class={`${line} flex-1`} />
                    </span>
                  )}

                  <span
                    class:list={['hm-pulse', group.mode === 'opt-in' && 'hm-pulse--idle', tile.kind === 'error' && 'hm-pulse--error']}
                    style={`left:${tile.at[0]}%;top:${tile.at[1]}%`}
                  />
                </div>
              </div>
              <div class="flex flex-1 flex-col gap-1 border-t p-3">
                <div class="flex items-start justify-between gap-2">
                  <span class="text-sm font-medium">{tile.name}</span>
                  <code class="shrink-0 text-xs text-fd-muted-foreground">{tile.kind}</code>
                </div>
                <span class="text-xs text-fd-muted-foreground">{tile.moment}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</div>

<style>
  .hm-pulse {
    position: absolute;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 999px;
    border: 1.5px solid rgb(59 130 246);
    background: rgb(59 130 246 / 0.15);
    pointer-events: none;
    animation: hm-pulse 1.8s ease-out infinite;
  }
  .hm-pulse--error {
    border-color: rgb(239 68 68);
    background: rgb(239 68 68 / 0.12);
  }
  /* Left to the app: the ring is drawn dashed and still, the haptic only plays if the app asks. */
  .hm-pulse--idle {
    border-style: dashed;
    background: transparent;
    animation: none;
    opacity: 0.8;
  }
  .hm-shake {
    animation: hm-shake 1.8s ease-in-out infinite;
  }

  @keyframes hm-pulse {
    0% { opacity: 0; transform: scale(0.6); }
    15% { opacity: 1; transform: scale(1); }
    60%, 100% { opacity: 0; transform: scale(1.7); }
  }
  @keyframes hm-shake {
    0%, 30%, 100% { transform: translateX(0); }
    5%, 15%, 25% { transform: translateX(-3px); }
    10%, 20% { transform: translateX(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-pulse,
    .hm-shake {
      animation: none;
    }
  }
</style>
