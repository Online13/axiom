---
// The four moments of the stack animation. Opening and closing are not symmetric:
// the sheet underneath only ever scales, the sheet on top only ever slides.
import Glyph from '@docs/components/preview/glyph.astro';

// metrics.stackScale, at the size of these frames.
const SCALE = 0.915;

const frames = [
  {
    label: 'alone',
    under: 1,
    over: null,
    caption: 'One sheet. Nothing about it differs from a sheet with no stack behind it.',
  },
  {
    label: 'opening',
    under: SCALE,
    over: 46,
    moving: 'up',
    caption: 'Both springs start together: the one underneath shrinks, the new one rises.',
  },
  {
    label: 'stacked',
    under: SCALE,
    over: 0,
    caption: 'Settled. The sheet underneath is narrower, dimmed by the new overlay, and inert.',
  },
  {
    label: 'closing',
    under: 0.97,
    over: 34,
    moving: 'down',
    growing: true,
    caption: 'The top sheet slides out without scaling, while the one underneath grows back.',
  },
] as const;
---

<div class="not-prose my-6 overflow-x-auto border bg-fd-card">
  <div class="grid min-w-[36rem] grid-cols-4 gap-px bg-fd-border">
    {
      frames.map(({ label, under, over, moving, growing, caption }) => (
        <div class="flex flex-col gap-3 bg-fd-card p-3">
          <div class="relative mx-auto h-[9.5rem] w-[104px] overflow-hidden rounded-md border bg-fd-card">
            <div class="flex flex-col p-1.5">
              {[0, 1, 2].map(() => (
                <div class="flex h-5 items-center">
                  <span class="h-1.5 w-2/3 rounded-full bg-fd-muted" />
                </div>
              ))}
            </div>

            <div class="absolute inset-0 bg-black/30" />

            <div
              class="absolute inset-x-0 bottom-0 h-[78px] rounded-t-lg border-t border-fd-border bg-fd-card"
              style={`transform:scale(${under})`}
            >
              <span class="mx-auto mt-1.5 block h-1 w-6 rounded-full bg-fd-muted" />
              <div class="flex flex-col gap-1.5 px-2.5 pt-2">
                <span class="h-1.5 w-1/2 rounded-full bg-fd-foreground/60" />
                <span class="h-1.5 w-3/4 rounded-full bg-fd-muted" />
              </div>
              {growing && (
                <>
                  <Glyph name="chevron-left" size={10} class="absolute -left-2.5 top-1/2 text-blue-500" />
                  <Glyph name="chevron-right" size={10} class="absolute -right-2.5 top-1/2 text-blue-500" />
                </>
              )}
            </div>

            {over !== null && (
              <>
                <div class="absolute inset-0 bg-black/30" style={`transform:translateY(${over}px)`} />
                <div
                  class="absolute inset-x-0 bottom-0 h-[54px] rounded-t-lg border-t border-fd-border bg-fd-card"
                  style={`transform:translateY(${over}px)`}
                >
                  <span class="mx-auto mt-1.5 block h-1 w-6 rounded-full bg-fd-muted" />
                  {moving && (
                    <Glyph
                      name={moving === 'up' ? 'arrow-up' : 'arrow-down'}
                      size={12}
                      class="absolute inset-x-0 top-5 mx-auto text-blue-500"
                    />
                  )}
                </div>
              </>
            )}
          </div>
          <div class="font-mono text-xs">{label}</div>
          <p class="text-xs text-fd-muted-foreground">{caption}</p>
        </div>
      ))
    }
  </div>
</div>
