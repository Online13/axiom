---
// The workstreams of the phase in progress, each item as a checkbox with its own state.
// A shipped item is checked, one in progress is half-checked, the rest are empty.
// "Next up" marks where the work resumes, so the reader sees the current position
// down to the item, not only down to the phase.

import StateTag from './state-tag.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;

const groups = [
  {
    name: 'Styling variants',
    items: [
      { name: 'stylesheet', detail: 'behavior / style split in place', status: 'shipped' },
      { name: 'unistyles', detail: '75 entries, same API, other engine', status: 'shipped' },
      { name: 'nativewind', detail: '75 entries, the theme as a Tailwind preset', status: 'shipped' },
      { name: 'uniwind', detail: '75 entries, the theme as a Tailwind 4 file', status: 'shipped' },
    ],
  },
  {
    name: 'Components',
    items: [
      { name: 'Foundations', detail: 'tokens, ThemeColors, Theme, light / dark', status: 'shipped' },
      { name: 'Core', detail: 'Slot, Portal, Overlay, OverlayStack, Tappable, Haptics', status: 'shipped' },
      { name: 'Hooks', detail: 'useRefreshControl, useControllableState, useOverlayBackHandler', status: 'shipped' },
      { name: 'Primitives', detail: 'typography, 34 atoms, 3 molecules, Passcode, 5 templates', status: 'shipped' },
      { name: 'Compositions', detail: '30 entries: cards, items, app bars', status: 'progress' },
      { name: 'Blocks', detail: 'SettingsSection', status: 'progress' },
    ],
  },
  {
    name: 'Tooling',
    items: [
      { name: 'registry.json', detail: 'component manifest, 88 entries', status: 'shipped' },
      { name: 'CLI', detail: 'add, init and sync ship', status: 'shipped' },
      { name: 'Standalone mode', detail: 'add --standalone: one file, no theme; portal-based entries later', status: 'shipped' },
      { name: 'Demo apps', detail: 'one per styling tool: StyleSheet, Unistyles, NativeWind, Uniwind', status: 'shipped' },
      { name: 'Theme builder', detail: 'public: overrides, presets, previews, agent export', status: 'shipped' },
      { name: 'Foundations screen', detail: 'colors, typography, spacing, radius, icons, targets, states', status: 'shipped' },
      { name: 'CI', detail: 'CLI tests, typecheck per variant, props parity, lint and app bundles run', status: 'shipped' },
    ],
  },
];

const box = {
  shipped: 'border-emerald-600 bg-emerald-600 text-white dark:border-emerald-500 dark:bg-emerald-500',
  progress: 'border-amber-500 bg-amber-500/15 text-amber-600 dark:text-amber-400',
  next: 'border-sky-500 text-sky-500',
  planned: 'border-fd-muted-foreground/40',
};
---

<div class="not-prose my-6 grid gap-3 md:grid-cols-3" aria-label={title ?? 'Phase 1 workstreams'}>
  {groups.map((group) => (
    <section class="flex flex-col gap-3 rounded-lg border bg-fd-card p-4">
      <h3 class="text-[11px] font-semibold uppercase tracking-wide text-fd-muted-foreground">{group.name}</h3>
      <ol class="flex flex-col gap-2.5">
        {group.items.map((item) => (
          <li class="flex gap-2.5">
            <span class={`mt-0.5 flex size-4 shrink-0 items-center justify-center rounded border-[1.5px] ${box[item.status]}`} aria-hidden="true">
              {item.status === 'shipped' && (
                <svg viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3.5 8.5l3 3 6-7" />
                </svg>
              )}
              {item.status === 'progress' && <span class="h-0.5 w-2 rounded-full bg-current" />}
            </span>
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="flex flex-wrap items-center gap-1.5">
                <span class={`text-sm leading-5 ${item.status === 'planned' ? 'text-fd-muted-foreground' : 'font-medium'}`}>
                  <span class="sr-only">{item.status === 'shipped' ? 'Done: ' : item.status === 'progress' ? 'In progress: ' : 'To do: '}</span>
                  {item.name}
                </span>
                {(item.status === 'progress' || item.status === 'next') && <StateTag state={item.status} />}
              </span>
              <span class="text-xs leading-5 text-fd-muted-foreground">{item.detail}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
