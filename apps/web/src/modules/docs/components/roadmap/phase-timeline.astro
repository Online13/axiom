---
// The phases as one horizontal track where every step is a tab. Each phase's content lives in a
// VariantPanel of group "roadmap" in the page, so only the selected phase is shown below the track.
// The phase in progress is selected by default and keeps its "You are here" marker.
// Status drives the dots and the connectors: a shipped phase is filled, the current one is outlined
// and highlighted, a future one stays muted.

const phases = [
  { value: 'phase-0', label: 'Phase 0', name: 'Specification', status: 'done' },
  { value: 'phase-1', label: 'Phase 1', name: 'Foundation', status: 'current' },
  { value: 'phase-2', label: 'Phase 2', name: 'Blocks', status: 'next' },
  { value: 'later', label: 'Later', name: 'Depth', status: 'next' },
];

const statusLabel = {
  done: 'Done',
  current: 'In progress',
  next: 'Planned',
};

const dot = {
  done: 'bg-fd-foreground border-fd-foreground',
  current: 'bg-fd-background border-fd-foreground ring-4 ring-fd-foreground/15',
  next: 'bg-fd-background border-fd-muted-foreground/40',
};

const selected = phases.find((phase) => phase.status === 'current')?.value ?? phases[0].value;
---

<div
  class="not-prose my-6 grid grid-cols-4 border-b border-fd-border"
  role="tablist"
  aria-label="Roadmap phases"
  data-variant-tabs="roadmap"
>
  {phases.map((phase, index) => (
    <button
      type="button"
      role="tab"
      data-value={phase.value}
      aria-selected={String(phase.value === selected)}
      data-selected={phase.value === selected ? '' : undefined}
      class="group -mb-px flex flex-col items-center gap-1.5 border-b-2 border-transparent px-1 pb-3 text-fd-muted-foreground outline-none transition-colors hover:text-fd-foreground focus-visible:ring-2 focus-visible:ring-fd-ring data-selected:border-fd-foreground data-selected:text-fd-foreground"
    >
      <span class="flex h-5 items-center">
        {phase.status === 'current' && (
          <span class="rounded-full bg-fd-foreground px-2 py-0.5 text-[10px] font-semibold uppercase leading-none tracking-wide text-fd-background">
            You are here
          </span>
        )}
      </span>
      <span class="relative flex w-full items-center" aria-hidden="true">
        <span class={`h-px flex-1 ${index === 0 ? 'bg-transparent' : phase.status === 'next' ? 'bg-fd-border' : 'bg-fd-foreground/40'}`} />
        <span class={`size-3 shrink-0 rounded-full border-2 transition-transform group-data-selected:scale-125 ${dot[phase.status]}`} />
        <span class={`h-px flex-1 ${index === phases.length - 1 ? 'bg-transparent' : phase.status === 'done' ? 'bg-fd-foreground/40' : 'bg-fd-border'}`} />
      </span>
      <span class="text-[11px] font-semibold uppercase tracking-wide">{phase.label}</span>
      <span class="hidden text-sm font-medium leading-5 sm:block">{phase.name}</span>
      <span class="text-[11px] leading-4 text-fd-muted-foreground">{statusLabel[phase.status]}</span>
    </button>
  ))}
</div>

<script>
  import '../variant-tabs/variant-tabs';
</script>
