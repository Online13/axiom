---
// A full-height order history that loads in pages of 24, up to 3 pages.
// When the list gets within one screen of the bottom (dashed line), the next page loads: spinner footer, then rows appended.
// "Fail next" makes the next request fail: the footer turns into a retry, and scrolling alone never retries.
// After the last page, the footer becomes "You're all caught up" and nothing else is requested.
import PhonePreview from '@docs/components/preview/phone-preview.astro';
import Glyph from '@docs/components/preview/glyph.astro';

const pageSize = 24;
const firstPage = Array.from({ length: pageSize }, (_, index) => index);
---

<PhonePreview full>
  <div class="pgn" data-pagination data-page-size={pageSize} data-pages="3">
    <div class="ax-appbar" data-border>
      <span class="ax-appbar-slot" />
      <span class="ax-appbar-title">Orders</span>
      <span class="ax-appbar-slot" data-side="end"><span class="ax-icon-btn"><Glyph name="filter" /></span></span>
    </div>

    <div class="pgn-body">
      <div class="pgn-scroller" data-scroller>
        <div class="ax-list" data-variant="plain" data-inset data-list>
          {
            firstPage.map((index) => (
              <div class="ax-item">
                <span class="pgn-icon"><Glyph name="bag" size={18} /></span>
                <div class="ax-item-content">
                  <span class="ax-item-title">Order #{4820 - index}</span>
                  <span class="ax-item-desc">Page 1 · {(index % 5) + 1} items</span>
                </div>
              </div>
            ))
          }
        </div>

        <div class="pgn-footer" data-footer data-state="idle">
          <span class="ax-spinner" data-size="sm" data-when="loading" />
          <span class="pgn-error" data-when="error">
            <span class="ax-muted">Couldn't load more orders.</span>
            <button type="button" class="ax-btn" data-variant="ghost" data-size="sm" data-retry>Retry</button>
          </span>
          <span class="pgn-end" data-when="end">
            <span class="pgn-rule" /><span class="ax-muted">You're all caught up</span><span class="pgn-rule" />
          </span>
        </div>
      </div>

      <div class="pgn-guide" data-guide aria-hidden="true"><span>one screen before the end</span></div>
    </div>
  </div>

  <div slot="footer" class="flex flex-wrap items-center justify-between gap-2 border-t px-4 py-3 font-mono text-xs" data-pgn-readout>
    <span>
      <span class="text-fd-muted-foreground">page </span><span data-out="page">1</span><span class="text-fd-muted-foreground">/3 · </span><span data-out="state">idle</span>
    </span>
    <span class="flex gap-2 font-sans">
      <button type="button" class="ax-toggle border px-2.5 py-0.5" data-fail aria-pressed="false">Fail next</button>
      <button type="button" class="ax-toggle border px-2.5 py-0.5" data-reset aria-pressed="false">Reset</button>
    </span>
  </div>
</PhonePreview>

<style is:global>
  .pgn {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
  }

  .pgn-body {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .pgn-scroller {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    cursor: grab;
    padding-bottom: 34px;
  }

  .pgn-scroller::-webkit-scrollbar {
    display: none;
  }

  .pgn-scroller[data-dragging] {
    cursor: grabbing;
    user-select: none;
  }

  .pgn-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--ax-background-subtle);
    color: var(--ax-content-muted);
  }

  .pgn-item-new {
    animation: pgn-in 260ms ease-out both;
  }

  @keyframes pgn-in {
    from { opacity: 0; transform: translateY(8px); }
  }

  .pgn-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 12px 16px;
    color: var(--ax-content-muted);
    font-size: 15px;
  }

  .pgn-footer [data-when] {
    display: none;
  }

  .pgn-footer[data-state='loading'] [data-when='loading'],
  .pgn-footer[data-state='error'] [data-when='error'],
  .pgn-footer[data-state='end'] [data-when='end'] {
    display: flex;
  }

  .pgn-error {
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .pgn-end {
    flex: 1;
    align-items: center;
    gap: 12px;
  }

  .pgn-rule {
    flex: 1;
    height: 1px;
    background: var(--ax-border-default);
  }

  /* The trigger line sits one screen above the end of the content and scrolls with it. */
  .pgn-guide {
    position: absolute;
    inset-inline: 0;
    top: var(--pgn-guide, -100px);
    border-top: 1.5px dashed #3b82f6;
    pointer-events: none;
  }

  .pgn-guide span {
    position: absolute;
    right: 8px;
    top: 2px;
    font: 11px ui-monospace, monospace;
    color: #3b82f6;
  }

  .pgn[data-done] .pgn-guide {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pgn-item-new { animation: none; }
    .pgn-footer .ax-spinner { animation-duration: 2s; }
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-pagination]:not([data-ready])').forEach((root) => {
      root.dataset.ready = '';
      const scroller = root.querySelector<HTMLElement>('[data-scroller]')!;
      const list = root.querySelector<HTMLElement>('[data-list]')!;
      const footer = root.querySelector<HTMLElement>('[data-footer]')!;
      const readout = root.closest('[data-ax-preview]')!.querySelector<HTMLElement>('[data-pgn-readout]')!;
      const out = (key: string) => readout.querySelector<HTMLElement>(`[data-out="${key}"]`)!;
      const failButton = readout.querySelector<HTMLButtonElement>('[data-fail]')!;
      const resetButton = readout.querySelector<HTMLButtonElement>('[data-reset]')!;
      const pageSize = Number(root.dataset.pageSize);
      const pages = Number(root.dataset.pages);
      const firstPage = list.innerHTML;

      let page = 1;
      let state: 'idle' | 'loading' | 'error' | 'end' = 'idle';
      let failNext = false;
      let timer = 0;

      const setState = (next: typeof state) => {
        state = next;
        footer.dataset.state = next;
        out('state').textContent = next;
        out('page').textContent = String(page);
        root.toggleAttribute('data-done', next === 'end');
      };

      const row = (index: number, pageNumber: number) => {
        const item = document.createElement('div');
        item.className = 'ax-item pgn-item-new';
        item.innerHTML = list.querySelector('.ax-item')!.innerHTML;
        item.querySelector('.ax-item-title')!.textContent = `Order #${4820 - index}`;
        item.querySelector('.ax-item-desc')!.textContent = `Page ${pageNumber} · ${(index % 5) + 1} items`;
        return item;
      };

      // One screen before the end of the content: the point where the next page starts loading.
      const distanceToEnd = () => scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight;
      const updateGuide = () => {
        const guide = scroller.scrollHeight - scroller.clientHeight - scroller.scrollTop;
        root.style.setProperty('--pgn-guide', `${guide}px`);
      };

      const load = () => {
        if (state !== 'idle') return;
        setState('loading');
        timer = window.setTimeout(() => {
          if (failNext) {
            failNext = false;
            failButton.setAttribute('aria-pressed', 'false');
            setState('error');
            return;
          }
          page += 1;
          for (let i = 0; i < pageSize; i++) list.append(row((page - 1) * pageSize + i, page));
          setState(page >= pages ? 'end' : 'idle');
          updateGuide();
          check();
        }, 1100);
      };

      const check = () => {
        updateGuide();
        if (distanceToEnd() < scroller.clientHeight) load();
      };

      scroller.addEventListener('scroll', check, { passive: true });

      // Retry is the only way out of the error: scrolling back to the bottom doesn't send a new request.
      root.querySelector('[data-retry]')!.addEventListener('click', () => {
        setState('idle');
        load();
      });

      failButton.addEventListener('click', () => {
        failNext = !failNext;
        failButton.setAttribute('aria-pressed', String(failNext));
      });

      resetButton.addEventListener('click', () => {
        clearTimeout(timer);
        list.innerHTML = firstPage;
        page = 1;
        scroller.scrollTop = 0;
        setState('idle');
        updateGuide();
      });

      updateGuide();

      // Mouse drag scrolls like a finger. Touch and wheel already scroll natively.
      let startY = 0;
      let startScroll = 0;
      scroller.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || (event.target as HTMLElement).closest('button')) return;
        startY = event.clientY;
        startScroll = scroller.scrollTop;
        scroller.dataset.dragging = '';
        scroller.setPointerCapture(event.pointerId);
      });
      scroller.addEventListener('pointermove', (event) => {
        if (scroller.dataset.dragging === undefined) return;
        const zoom = scroller.getBoundingClientRect().height / scroller.clientHeight || 1;
        scroller.scrollTop = startScroll - (event.clientY - startY) / zoom;
      });
      const release = () => delete scroller.dataset.dragging;
      scroller.addEventListener('pointerup', release);
      scroller.addEventListener('pointercancel', release);
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
