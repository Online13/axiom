---
// Four frozen frames of the list footer, from a list with more to load to its end.
// Each frame shows the last loaded rows and the footer below them.
import TokenFrame from '@docs/components/tokens/token-frame.astro';

const states = [
  { label: 'idle', footer: 'none', caption: 'More pages exist, but the user is still over a screen away from the end.' },
  { label: 'loading', footer: 'spinner', caption: 'One screen from the end: one request, a spinner as the last row.' },
  { label: 'error', footer: 'retry', caption: 'The rows stay. The footer offers a retry, nothing retries alone.' },
  { label: 'end', footer: 'end', caption: 'Last page loaded. A quiet footer, no more requests.' },
] as const;
---

<TokenFrame>
  <div class="grid min-w-[36rem] grid-cols-4 gap-px bg-fd-border">
    {
      states.map(({ label, footer, caption }) => (
        <div class="flex flex-col gap-3 bg-fd-card p-3">
          <div class="relative mx-auto flex h-[9.5rem] w-[104px] flex-col justify-end overflow-hidden rounded-md border bg-fd-card">
            {Array.from({ length: 4 }).map(() => (
              <div class="flex h-7 flex-none items-center gap-2 border-b px-2">
                <span class="size-4 flex-none rounded-[3px] bg-fd-muted" />
                <span class="h-1.5 flex-1 rounded-full bg-fd-muted" />
              </div>
            ))}
            <div class="flex h-9 flex-none items-center justify-center text-[9px] text-fd-muted-foreground">
              {footer === 'spinner' && (
                <span class="size-3 animate-spin rounded-full border-2 border-fd-muted-foreground/25 border-t-fd-foreground motion-reduce:animate-none" />
              )}
              {footer === 'retry' && (
                <span class="flex flex-col items-center leading-tight">
                  <span>Couldn't load</span>
                  <span class="font-semibold text-blue-500">Retry</span>
                </span>
              )}
              {footer === 'end' && (
                <span class="flex w-full items-center gap-1 px-1.5">
                  <span class="h-px flex-1 bg-fd-border" />
                  <span>All caught up</span>
                  <span class="h-px flex-1 bg-fd-border" />
                </span>
              )}
            </div>
          </div>
          <div class="font-mono text-xs">{label}</div>
          <p class="text-xs text-fd-muted-foreground">{caption}</p>
        </div>
      ))
    }
  </div>
</TokenFrame>
