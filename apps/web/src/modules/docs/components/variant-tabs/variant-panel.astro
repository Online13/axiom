---
// Content shown only while its value is selected in the tab list of the same `group`
// (VariantTabs, or the roadmap PhaseTimeline).
interface Props {
  group: string;
  value: string;
  /** The panels of the default variant, visible before any pill is pressed. */
  active?: boolean;
}

const { group, value, active = false } = Astro.props;
---

<div data-variant-panel={group} data-value={value} data-active={active ? '' : undefined}>
  <slot />
</div>

<style is:global>
  [data-variant-panel]:not([data-active]) {
    display: none;
  }
</style>
