---
// Three element sizes and the hitSlop Tappable adds to reach touchTarget on each axis.
// Drawn at twice the size in pt so the slop stays readable.
import TokenFrame from '@docs/components/tokens/token-frame.astro';
import { metrics } from '@docs/lib/tokens';

const scale = 2;
const slop = (size: number) => Math.max(0, (metrics.touchTarget - size) / 2);

const cases = [
  { label: 'Icon', width: 24, height: 24, round: true },
  { label: 'Small chip', width: 64, height: 32, round: false },
  { label: 'Button', width: 96, height: 44, round: false },
].map((c) => ({ ...c, x: slop(c.width), y: slop(c.height) }));
---

<TokenFrame>
  <div class="grid gap-px bg-fd-border sm:grid-cols-3">
    {
      cases.map(({ label, width, height, round, x, y }) => (
        <div class="flex flex-col items-center gap-4 bg-fd-card p-6">
          <div class="flex h-[7.5rem] items-center">
            <div
              class="relative flex items-center justify-center border-[1.5px] border-dashed border-blue-500"
              style={`width:${(width + x * 2) * scale}px;height:${(height + y * 2) * scale}px;border-radius:${round ? '999px' : '6px'}`}
            >
              <div
                class="bg-fd-foreground"
                style={`width:${width * scale}px;height:${height * scale}px;border-radius:${round ? '999px' : '6px'}`}
              />
              {y > 0 && <span class="absolute top-0.5 font-mono text-[10px] text-blue-500">{y}</span>}
              {x > 0 && <span class="absolute left-1 font-mono text-[10px] text-blue-500">{x}</span>}
            </div>
          </div>
          <div class="text-center font-mono text-xs">
            <div>{label} <span class="text-fd-muted-foreground">{width}×{height}</span></div>
            <div class="text-fd-muted-foreground">hitSlop {x === y ? x : `{ x: ${x}, y: ${y} }`}</div>
          </div>
        </div>
      ))
    }
  </div>
</TokenFrame>
