---
// Four frozen frames of B dragged from slot 1 to slot 2 in a list of four 32pt rows.
// The dashed line is the edge between B's slot and C's. `y` is how far the lifted row is from its slot. The target slot is the one under the row's center: round(from + y / height).
import TokenFrame from '@docs/components/tokens/token-frame.astro';
import Glyph from '@docs/components/preview/glyph.astro';

const rowHeight = 32;
const labels = ['A', 'B', 'C', 'D'];
const from = 1;

const states = [
  { label: 'lifted', y: 0, to: 1, caption: 'Handle pressed, or a long press. The row rises.' },
  { label: 'moving', y: 12, to: 1, caption: 'Its center is still in its own slot: nothing else moves.' },
  { label: 'crossed', y: 20, to: 2, caption: 'Its center enters C’s slot: C slides up into the free one.' },
  { label: 'dropped', y: 32, to: 2, caption: 'Released: settles in its slot. onReorder(1, 2).' },
];

const shiftOf = (index: number, to: number) => {
  if (from < to && index > from && index <= to) return -rowHeight;
  if (from > to && index < from && index >= to) return rowHeight;
  return 0;
};
---

<TokenFrame>
  <div class="grid min-w-[36rem] grid-cols-4 gap-px bg-fd-border">
    {
      states.map(({ label, y, to, caption }) => (
        <div class="flex flex-col gap-3 bg-fd-card p-3">
          <div class="relative h-[9rem] overflow-hidden rounded-md border bg-fd-card">
            <div class="relative mt-2">
              {labels.map((name, index) => {
                const active = index === from;
                const lifted = active && label !== 'dropped';
                return (
                  <div
                    class:list={[
                      'absolute inset-x-1 flex items-center gap-2 px-2',
                      lifted ? 'z-10 rounded-md bg-fd-card shadow-lg ring-1 ring-fd-foreground/30' : 'border-b',
                    ]}
                    style={`top:${index * rowHeight}px;height:${rowHeight}px;transform:translateY(${active ? y : shiftOf(index, to)}px)${lifted ? ' scale(1.04)' : ''}`}
                  >
                    <span class="w-3 font-mono text-[10px] text-fd-muted-foreground">{name}</span>
                    <span class:list={['h-1.5 flex-1 rounded-full', active ? 'bg-fd-foreground/60' : 'bg-fd-muted']} />
                    <Glyph name="menu" size={12} class={active ? 'text-fd-foreground' : 'text-fd-muted-foreground'} />
                  </div>
                );
              })}
              {label !== 'dropped' && (
                <span
                  class="absolute inset-x-0 border-t border-dashed border-blue-500"
                  style={`top:${(from + 1) * rowHeight}px`}
                />
              )}
            </div>
          </div>
          <div class="font-mono text-xs">
            <div>{label}</div>
            <div class="text-fd-muted-foreground">y {y} · to {to}</div>
          </div>
          <p class="text-xs text-fd-muted-foreground">{caption}</p>
        </div>
      ))
    }
  </div>
</TokenFrame>
