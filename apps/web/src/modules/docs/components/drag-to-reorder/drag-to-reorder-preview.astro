---
// A playlist driven by the same rules as useDragToReorder.
// Grab a row by its handle (at once) or anywhere else with a long press (300ms). The row lifts and follows the finger;
// once its center enters a neighbour's slot, that neighbour slides into the free one. On release, the row settles
// in its slot and onReorder receives the new order.
import PhonePreview from '@docs/components/preview/phone-preview.astro';
import Glyph from '@docs/components/preview/glyph.astro';

const tracks = [
  { title: 'Blue in Green', artist: 'Miles Davis', length: '5:37', tone: '1' },
  { title: 'Clair de Lune', artist: 'Claude Debussy', length: '5:02', tone: '2' },
  { title: 'Teardrop', artist: 'Massive Attack', length: '5:30', tone: '3' },
  { title: 'Hyperballad', artist: 'Björk', length: '5:21', tone: '4' },
  { title: 'Windowlicker', artist: 'Aphex Twin', length: '6:08', tone: '5' },
  { title: 'Nude', artist: 'Radiohead', length: '4:15', tone: '1' },
];
---

<PhonePreview>
  <div class="dtr" data-drag-to-reorder>
    <div class="ax-appbar" data-border>
      <span class="ax-appbar-slot" />
      <span class="ax-appbar-title">Up next</span>
      <span class="ax-appbar-slot" data-side="end"><span class="ax-icon-btn"><Glyph name="music" /></span></span>
    </div>

    <div class="dtr-list" data-list>
      {
        tracks.map(({ title, artist, length, tone }) => (
          <div class="ax-item dtr-row" data-row data-title={title}>
            <span class="ax-avatar" data-shape="square" data-photo={tone} />
            <div class="ax-item-content">
              <span class="ax-item-title">{title}</span>
              <span class="ax-item-desc">{artist} · {length}</span>
            </div>
            <span class="dtr-handle" data-handle aria-label={`Reorder ${title}`}>
              <Glyph name="menu" size={22} />
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div slot="footer" class="border-t px-4 py-3 font-mono text-xs" data-dtr-readout>
    <span class="text-fd-muted-foreground">from </span><span data-out="from">–</span>
    <span class="text-fd-muted-foreground"> · to </span><span data-out="to">–</span>
    <span class="text-fd-muted-foreground"> · </span><span data-out="event" class="text-fd-muted-foreground">drag a handle, or long press a row</span>
  </div>
</PhonePreview>

<style is:global>
  .dtr {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
  }

  .dtr-list {
    position: relative;
  }

  .dtr-row {
    background: var(--ax-background-default);
    user-select: none;
    touch-action: pan-y;
    -webkit-touch-callout: none;
    transform: translateY(var(--dtr-y, 0px));
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .dtr-row[data-pressing] {
    background: var(--ax-background-subtle);
  }

  /* The lifted row follows the finger with no transition, above the others. */
  .dtr-row[data-lifted] {
    z-index: 2;
    border-radius: 12px;
    background: var(--ax-background-elevated);
    box-shadow: var(--ax-shadow);
    transform: translateY(var(--dtr-y, 0px)) scale(1.03);
    transition:
      box-shadow 150ms ease,
      border-radius 150ms ease;
  }

  .dtr-row[data-lifted]::before,
  .dtr-row[data-lifted] + .dtr-row::before {
    opacity: 0;
  }

  .dtr-row[data-dropping] {
    z-index: 2;
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .dtr-list[data-still] .dtr-row {
    transition: none;
  }

  .dtr-handle {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: var(--ax-content-subtle);
    cursor: grab;
    touch-action: none;
  }

  .dtr-row[data-lifted] .dtr-handle {
    color: var(--ax-content-default);
    cursor: grabbing;
  }

  @media (prefers-reduced-motion: reduce) {
    .dtr-row,
    .dtr-row[data-dropping] {
      transition: none;
    }

    .dtr-row[data-lifted] {
      transform: translateY(var(--dtr-y, 0px));
    }
  }
</style>

<script>
  const LONG_PRESS = 300;
  const SLOP = 8;

  function init() {
    document.querySelectorAll<HTMLElement>('[data-drag-to-reorder]:not([data-ready])').forEach((root) => {
      root.dataset.ready = '';
      const list = root.querySelector<HTMLElement>('[data-list]')!;
      const readout = root.closest('[data-ax-preview]')!.querySelector<HTMLElement>('[data-dtr-readout]')!;
      const out = (key: string) => readout.querySelector<HTMLElement>(`[data-out="${key}"]`)!;

      const rows = () => Array.from(list.querySelectorAll<HTMLElement>('[data-row]'));

      let active: HTMLElement | null = null;
      let pointer: number | null = null;
      let from = 0;
      let to = 0;
      let startY = 0;
      let startX = 0;
      let height = 0;
      let lifted = false;
      let timer = 0;

      const zoomOf = () => list.getBoundingClientRect().height / list.offsetHeight || 1;

      const lift = (row: HTMLElement) => {
        lifted = true;
        delete row.dataset.pressing;
        row.dataset.lifted = '';
        navigator.vibrate?.(10);
        out('from').textContent = String(from);
        out('to').textContent = String(from);
        out('event').textContent = 'lifted';
      };

      const cancelPress = () => {
        clearTimeout(timer);
        active?.removeAttribute('data-pressing');
      };

      const move = (clientY: number) => {
        if (!active) return;
        const all = rows();
        const dy = (clientY - startY) / zoomOf();
        // The lifted row can't leave the list.
        const min = -from * height;
        const max = (all.length - 1 - from) * height;
        const y = Math.min(Math.max(dy, min), max);
        active.style.setProperty('--dtr-y', `${y}px`);

        // The target slot is the one under the row's center.
        const next = Math.min(Math.max(Math.round(from + y / height), 0), all.length - 1);
        if (next !== to) {
          to = next;
          navigator.vibrate?.(5);
          out('to').textContent = String(to);
          out('event').textContent = to === from ? 'back to its slot' : `moving over ${all[to].dataset.title}`;
        }
        // Rows between the origin and the target slide by one slot toward the origin.
        all.forEach((row, index) => {
          if (row === active) return;
          let shift = 0;
          if (from < to && index > from && index <= to) shift = -height;
          if (from > to && index < from && index >= to) shift = height;
          row.style.setProperty('--dtr-y', `${shift}px`);
        });
      };

      const drop = () => {
        const row = active;
        if (!row) return;
        active = null;
        pointer = null;
        lifted = false;
        delete row.dataset.lifted;
        row.dataset.dropping = '';
        row.style.setProperty('--dtr-y', `${(to - from) * height}px`);

        const moved = to !== from;
        const title = row.dataset.title;
        const [a, b] = [from, to];
        setTimeout(() => {
          // Commit the order in the DOM without animating, like a re-render with the new data.
          list.dataset.still = '';
          const all = rows();
          all.forEach((r) => r.style.removeProperty('--dtr-y'));
          delete row.dataset.dropping;
          if (moved) {
            const reference = all.filter((r) => r !== row)[b] ?? null;
            list.insertBefore(row, reference);
          }
          void list.offsetHeight;
          delete list.dataset.still;
        }, 210);

        out('event').textContent = moved ? `onReorder: ${title} ${a} → ${b}` : 'dropped in place, no call';
      };

      list.addEventListener('pointerdown', (event) => {
        if (event.button !== 0 || active) return;
        const row = (event.target as HTMLElement).closest<HTMLElement>('[data-row]');
        if (!row) return;
        active = row;
        pointer = event.pointerId;
        from = rows().indexOf(row);
        to = from;
        startX = event.clientX;
        startY = event.clientY;
        height = row.offsetHeight;

        if ((event.target as HTMLElement).closest('[data-handle]')) {
          // The handle lifts at once: it has no other job.
          event.preventDefault();
          list.setPointerCapture(event.pointerId);
          lift(row);
        } else {
          row.dataset.pressing = '';
          out('event').textContent = 'hold to lift…';
          timer = window.setTimeout(() => {
            if (active !== row) return;
            list.setPointerCapture(pointer!);
            lift(row);
          }, LONG_PRESS);
        }
      });

      list.addEventListener('pointermove', (event) => {
        if (event.pointerId !== pointer || !active) return;
        if (!lifted) {
          // Moving before the delay is a scroll, not a drag.
          const zoom = zoomOf();
          if (Math.hypot(event.clientX - startX, event.clientY - startY) / zoom > SLOP) {
            cancelPress();
            active = null;
            pointer = null;
            out('event').textContent = 'moved before 300ms: scroll';
          }
          return;
        }
        move(event.clientY);
      });

      const release = (event: PointerEvent) => {
        if (event.pointerId !== pointer) return;
        if (!lifted) {
          cancelPress();
          if (active && event.type === 'pointerup') out('event').textContent = `onPress: play ${active.dataset.title}`;
          active = null;
          pointer = null;
          return;
        }
        drop();
      };
      list.addEventListener('pointerup', release);
      list.addEventListener('pointercancel', release);
      list.addEventListener('contextmenu', (event) => event.preventDefault());
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
