---
// Top half of an iPhone that shows only what one color role paints, with a light / dark toggle.
// `role="all"` shows a screen that uses every role together.
// `role="title"` and `role="text"` show the Title and Text components with their variants.
// Every semantic color is exposed as a CSS variable (`--content-muted`); the toggle swaps their values.
import TokenFrame from './token-frame.astro';
import { colorRoles, roleColor, typography, type ColorRole, type ColorScheme } from '@docs/lib/tokens';

interface Props {
  role: ColorRole | 'all' | 'title' | 'text';
}

const { role } = Astro.props;
const schemes: ColorScheme[] = ['light', 'dark'];

const schemeVars = (scheme: ColorScheme) =>
  Object.fromEntries(
    (Object.keys(colorRoles) as ColorRole[]).flatMap((r) =>
      Object.keys(colorRoles[r]).map((key) => [`--${r}-${key}`, roleColor(scheme, r, key as never)]),
    ),
  );

const colors = { light: schemeVars('light'), dark: schemeVars('dark') };
const initialStyle = Object.entries(colors.light)
  .map(([name, value]) => `${name}:${value}`)
  .join(';');

const titleVariants = [
  { variant: 'display', style: typography.largeTitle, label: 'Settings' },
  { variant: 'headingLg', style: typography.title1, label: 'Notifications' },
  { variant: 'heading', style: typography.title2, label: 'Push alerts' },
  { variant: 'headingSm', style: typography.title3, label: 'Quiet hours' },
  { variant: 'subheading', style: typography.headline, label: 'Weekdays' },
];

const textVariants = [
  { variant: 'bodyLg', style: typography.body, color: 'var(--content-default)', label: 'Your changes are saved.' },
  { variant: 'body', style: typography.callout, color: 'var(--content-default)', label: 'Your changes are saved.' },
  { variant: 'bodySm · muted', style: typography.subheadline, color: 'var(--content-muted)', label: 'Push and email' },
  { variant: 'footnote · link', style: typography.footnote, color: 'var(--content-link)', label: 'Privacy policy' },
  { variant: 'footnote · error', style: typography.footnote, color: 'var(--feedback-error)', label: 'Sync failed' },
  { variant: 'caption · subtle', style: typography.caption, color: 'var(--content-subtle)', label: 'Updated 2 minutes ago' },
];

const typeStyle = (style: { fontSize: number; lineHeight: number; fontWeight: string }) =>
  `font-size:${style.fontSize}px;line-height:${style.lineHeight}px;font-weight:${style.fontWeight}`;

const feedbackStates = [
  { key: 'info', label: 'New version available' },
  { key: 'success', label: 'Payment received' },
  { key: 'warning', label: 'Storage almost full' },
  { key: 'error', label: 'Sync failed' },
];
---

<TokenFrame>
  <div class="role-preview" data-colors={JSON.stringify(colors)} style={initialStyle}>
    <div class="flex justify-end border-b px-4 py-3">
      <div class="inline-flex border p-0.5 text-xs" role="group" aria-label="Color scheme">
        {
          schemes.map((scheme) => (
            <button
              type="button"
              class="scheme-button px-3 py-1 capitalize"
              data-scheme-button={scheme}
              aria-pressed={scheme === 'light' ? 'true' : 'false'}
            >
              {scheme}
            </button>
          ))
        }
      </div>
    </div>

    <div class:list={['stage', { 'stage-tall': role === 'all' }]}>
      <div class="phone" aria-hidden="true">
        {
          role === 'all' && (
            <div class="screen" style="background:var(--background-subtle)">
              <div class="flex flex-col gap-3 px-4 pb-4 pt-3" style="background:var(--background-default)">
                <div class="island self-center" />
                <div style="color:var(--content-default);font-size:26px;font-weight:700;line-height:1.1">Settings</div>
                <div class="flex h-10 items-center rounded-[10px] px-3" style="border:1.5px solid var(--border-focus)">
                  <span style="color:var(--content-subtle);font-size:14px">Search</span>
                </div>
              </div>
              <div class="flex flex-col gap-3 p-4">
                <div class="flex flex-col rounded-[14px]" style="background:var(--background-elevated);border:1px solid var(--border-default)">
                  <div class="flex items-center justify-between px-3 py-2.5">
                    <div class="flex flex-col">
                      <span style="color:var(--content-default);font-size:15px">Notifications</span>
                      <span style="color:var(--content-muted);font-size:12px">Push and email</span>
                    </div>
                    <span class="rounded-full px-2 py-0.5" style="background:var(--feedback-successSubtle);color:var(--feedback-success);font-size:11px;font-weight:600">On</span>
                  </div>
                  <div class="ml-3" style="height:1px;background:var(--border-subtle)" />
                  <div class="flex items-center justify-between px-3 py-2.5">
                    <span style="color:var(--content-disabled);font-size:15px">Backup</span>
                    <span class="size-[18px] rounded-[5px]" style="border:1.5px solid var(--border-strong)" />
                  </div>
                  <div class="ml-3" style="height:1px;background:var(--border-subtle)" />
                  <div class="px-3 py-2.5">
                    <span style="color:var(--content-link);font-size:15px">Privacy policy</span>
                  </div>
                </div>
                <div class="rounded-[10px] px-3 py-2" style="background:var(--feedback-errorSubtle);color:var(--feedback-error);font-size:13px">
                  Sync failed. Try again.
                </div>
                <div class="flex items-center justify-between rounded-[10px] px-3 py-2" style="background:var(--highlight-default);color:var(--highlight-on);font-size:13px">
                  <span style="font-weight:600">Upgrade to Pro</span>
                  <span style="opacity:0.7">2 weeks left</span>
                </div>
                <div class="rounded-[10px] px-3 py-2.5" style="background:var(--background-inverse);color:var(--content-inverse);font-size:13px">
                  Changes saved
                </div>
                <div class="flex h-10 items-center justify-center rounded-[10px]" style="background:var(--primary-default);color:var(--primary-on);font-size:14px;font-weight:600">
                  Save
                </div>
              </div>
            </div>
          )
        }

        {
          role === 'title' && (
            <div class="screen" style="background:var(--background-default)">
              <div class="flex justify-center pt-3">
                <div class="island" />
              </div>
              <div class="flex flex-col gap-4 px-5 pt-6">
                {titleVariants.map(({ variant, style, label }) => (
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="truncate" style={`color:var(--content-default);${typeStyle(style)}`}>{label}</span>
                    <span class="shrink-0 font-mono" style="color:var(--content-subtle);font-size:11px">{variant}</span>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        {
          role === 'text' && (
            <div class="screen" style="background:var(--background-default)">
              <div class="flex justify-center pt-3">
                <div class="island" />
              </div>
              <div class="flex flex-col gap-3.5 px-5 pt-6">
                {textVariants.map(({ variant, style, color, label }) => (
                  <div class="flex flex-col gap-0.5">
                    <span class="font-mono" style="color:var(--content-subtle);font-size:11px">{variant}</span>
                    <span style={`color:${color};${typeStyle(style)}`}>{label}</span>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        {
          role === 'background' && (
            <div class="screen" style="background:var(--background-subtle)">
              <div class="flex h-[110px] justify-center pt-3" style="background:var(--background-default)">
                <div class="island" />
              </div>
              <div class="flex flex-col gap-3 p-4">
                <div class="h-14 rounded-[14px]" style="background:var(--background-elevated)" />
                <div class="h-[88px] rounded-[14px]" style="background:var(--background-elevated)" />
                <div class="h-11 rounded-[12px]" style="background:var(--background-inverse)" />
              </div>
            </div>
          )
        }

        {
          role === 'content' && (
            <div class="screen" style="background:var(--background-default)">
              <div class="flex justify-center pt-3">
                <div class="island" />
              </div>
              <div class="flex flex-col gap-3 px-5 pt-6">
                <div style="color:var(--content-default);font-size:28px;font-weight:700;line-height:1.1">Settings</div>
                <div style="color:var(--content-default);font-size:15px;line-height:1.35">
                  Choose which notifications you receive and when.
                </div>
                <div style="color:var(--content-muted);font-size:13px">Updated 2 minutes ago</div>
                <div style="color:var(--content-subtle);font-size:15px">Add a note…</div>
                <div style="color:var(--content-disabled);font-size:15px">Backup unavailable</div>
                <div style="color:var(--content-link);font-size:15px">Privacy policy</div>
                <div class="self-start rounded-full px-3 py-1" style="background:var(--background-inverse);color:var(--content-inverse);font-size:13px">
                  Changes saved
                </div>
              </div>
            </div>
          )
        }

        {
          role === 'border' && (
            <div class="screen" style="background:var(--background-default)">
              <div class="flex justify-center pt-3">
                <div class="island" />
              </div>
              <div class="flex flex-col gap-3 px-4 pt-6">
                <div class="h-11 rounded-[10px]" style="border:1px solid var(--border-default)" />
                <div class="h-11 rounded-[10px]" style="border:2px solid var(--border-focus)" />
                <div class="flex flex-col rounded-[14px]" style="border:1px solid var(--border-default)">
                  {[0, 1, 2].map((i) => (
                    <>
                      {i > 0 && <div class="ml-4" style="height:1px;background:var(--border-subtle)" />}
                      <div class="flex h-12 items-center justify-end px-4">
                        <div class="size-[18px] rounded-[5px]" style="border:1.5px solid var(--border-strong)" />
                      </div>
                    </>
                  ))}
                </div>
                <div class="flex gap-3">
                  <div class="size-5 rounded-full" style="border:1.5px solid var(--border-strong)" />
                  <div class="size-5 rounded-full" style="border:6px solid var(--border-focus)" />
                </div>
              </div>
            </div>
          )
        }

        {
          role === 'primary' && (
            <div class="screen" style="background:var(--background-default)">
              <div class="flex justify-center pt-3">
                <div class="island" />
              </div>
              <div class="flex flex-col gap-3 px-4 pt-6">
                <div class="flex gap-2">
                  <span class="rounded-full px-3 py-1.5" style="background:var(--primary-default);color:var(--primary-on);font-size:13px;font-weight:600">All</span>
                  <span class="rounded-full px-3 py-1.5" style="border:1px solid var(--border-default);color:var(--content-default);font-size:13px">Music</span>
                  <span class="rounded-full px-3 py-1.5" style="border:1px solid var(--border-default);color:var(--content-default);font-size:13px">Podcasts</span>
                </div>
                <div class="flex items-center justify-between rounded-[12px] px-3 py-2.5" style="background:var(--primary-subtle)">
                  <span style="color:var(--content-default);font-size:14px">Download over Wi-Fi</span>
                  <span class="flex h-[22px] w-[38px] items-center justify-end rounded-full p-0.5" style="background:var(--primary-default)">
                    <span class="size-[18px] rounded-full" style="background:var(--background-elevated)" />
                  </span>
                </div>
                <div class="flex items-center gap-2.5 px-1">
                  <span class="flex size-[18px] items-center justify-center rounded-[5px]" style="background:var(--primary-default)">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--primary-on)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                  </span>
                  <span style="color:var(--content-default);font-size:14px">Remember my choice</span>
                </div>
                <div class="mt-1 flex h-11 items-center justify-center rounded-[12px]" style="background:var(--primary-default);color:var(--primary-on);font-size:15px;font-weight:600">
                  Continue
                </div>
                <div class="flex h-11 items-center justify-center rounded-[12px]" style="background:var(--primary-pressed);color:var(--primary-on);font-size:15px;font-weight:600">
                  Continue · pressed
                </div>
              </div>
            </div>
          )
        }

        {
          role === 'highlight' && (
            <div class="screen" style="background:var(--background-default)">
              <div class="flex justify-center pt-3">
                <div class="island" />
              </div>
              <div class="flex flex-col gap-3 px-4 pt-6">
                <div class="flex flex-col gap-1.5 rounded-[18px] p-4" style="background:var(--highlight-default);color:var(--highlight-on)">
                  <span style="font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase">Featured</span>
                  <span style="font-size:20px;font-weight:700;line-height:1.15">Make Time</span>
                  <span style="font-size:13px;opacity:0.7">Jake Knapp</span>
                </div>
                <div class="flex gap-2">
                  <span class="rounded-full px-2.5 py-1" style="background:var(--highlight-default);color:var(--highlight-on);font-size:12px;font-weight:600">8.0</span>
                  <span class="rounded-full px-2.5 py-1" style="background:var(--background-subtle);color:var(--content-muted);font-size:12px">Sci-Fi</span>
                </div>
                <div class="rounded-[12px] px-3 py-2.5" style="background:var(--highlight-subtle);color:var(--content-default);font-size:13px">
                  Two weeks left on your plan.
                </div>
              </div>
            </div>
          )
        }

        {
          role === 'feedback' && (
            <div class="screen" style="background:var(--background-default)">
              <div class="flex justify-center pt-3">
                <div class="island" />
              </div>
              <div class="flex flex-col gap-2.5 px-4 pt-6">
                {feedbackStates.map(({ key, label }) => (
                  <div class="flex items-center gap-2.5 rounded-[12px] px-3 py-3" style={`background:var(--feedback-${key}Subtle)`}>
                    <div class="size-2.5 shrink-0 rounded-full" style={`background:var(--feedback-${key})`} />
                    <span style={`color:var(--feedback-${key});font-size:14px;font-weight:500`}>{label}</span>
                  </div>
                ))}
                <div class="mt-1 flex h-11 items-center justify-center rounded-[12px]" style="background:var(--feedback-error);color:#FFFFFF;font-size:15px;font-weight:600">
                  Delete account
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</TokenFrame>

<style>
  .scheme-button[aria-pressed='true'] {
    background: var(--color-fd-foreground);
    color: var(--color-fd-background);
  }

  .scheme-button[aria-pressed='false'] {
    color: var(--color-fd-muted-foreground);
  }

  /* Only the top of the phone is visible: the stage crops it. */
  .stage {
    display: flex;
    justify-content: center;
    height: 400px;
    padding-top: 32px;
    overflow: hidden;
  }

  /* The overview screen holds every role, so more of the phone is shown. */
  .stage-tall {
    height: 540px;
  }

  .phone {
    width: 300px;
    height: 620px;
    flex-shrink: 0;
    padding: 10px;
    border-radius: 52px;
    background: #1c1c1e;
    box-shadow: 0 0 0 1.5px #3a3a3c;
  }

  .screen {
    height: 100%;
    overflow: hidden;
    border-radius: 42px;
    font-family: system-ui, sans-serif;
    text-align: left;
  }

  .screen,
  .screen * {
    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      color 250ms ease;
  }

  .island {
    width: 96px;
    height: 28px;
    border-radius: 999px;
    background: #000;
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('.role-preview').forEach((preview) => {
      const colors = JSON.parse(preview.dataset.colors ?? '{}') as Record<string, Record<string, string>>;
      const buttons = preview.querySelectorAll<HTMLButtonElement>('[data-scheme-button]');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const scheme = colors[button.dataset.schemeButton ?? 'light'];
          for (const [name, value] of Object.entries(scheme)) preview.style.setProperty(name, value);
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        });
      });
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
