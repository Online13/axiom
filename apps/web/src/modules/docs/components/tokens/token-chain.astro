---
// Traces a few component tokens back through the semantic color to the palette step, in both schemes.
import TokenFrame from './token-frame.astro';
import { colorRoles, resolveColor, type ColorRef, type ColorRole } from '@docs/lib/tokens';

const traces: { path: string; ref: ColorRef }[] = [
  { path: 'badge.highlight.default.background', ref: 'highlight.default' },
  { path: 'input.outline.focused.border', ref: 'border.focus' },
  { path: 'button.solid.default.background', ref: 'primary.default' },
];

const schemes = ['light', 'dark'] as const;

const paletteValue = (ref: ColorRef, scheme: (typeof schemes)[number]) => {
  const [role, key] = ref.split('.') as [ColorRole, string];
  return (colorRoles[role] as Record<string, { light: string; dark: string }>)[key][scheme];
};
---

<TokenFrame>
  <div class="min-w-[40rem] divide-y">
    <div class="grid gap-4 px-4 py-2 font-mono text-[0.7rem] text-fd-muted-foreground" style="grid-template-columns: 1fr 1.2rem 9rem 1.2rem 1fr;">
      <div>palette (light / dark)</div>
      <div></div>
      <div>ThemeColors</div>
      <div></div>
      <div>Components</div>
    </div>
    {
      traces.map(({ path, ref }) => (
        <div class="grid items-center gap-4 px-4 py-3" style="grid-template-columns: 1fr 1.2rem 9rem 1.2rem 1fr;">
          <div class="flex flex-col gap-1.5">
            {schemes.map((scheme) => {
              const value = paletteValue(ref, scheme);
              return (
                <div class="flex items-center gap-2 font-mono text-[0.65rem]">
                  <div class="size-4 shrink-0 border" style={`background:${resolveColor(value as never)}`} />
                  <span>{value}</span>
                  <span class="text-fd-muted-foreground">{scheme}</span>
                </div>
              );
            })}
          </div>
          <div class="text-fd-muted-foreground">→</div>
          <div class="font-mono text-xs">{ref}</div>
          <div class="text-fd-muted-foreground">→</div>
          <div class="font-mono text-xs">{path}</div>
        </div>
      ))
    }
  </div>
</TokenFrame>
