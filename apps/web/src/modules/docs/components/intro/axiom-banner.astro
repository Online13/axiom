---
// Banner for the introduction: the logo and tagline on one side, the system drawn as a stack of layers on the other,
// over the brand ribbons of the landing. Everything is SVG and HTML; the art follows the resolved docs theme.
// Foundations sit at the bottom, Blocks on top, the same order as the proof chain described on the page.
import { Logo } from "../../../brand/Logo";
import Ribbons from "../../../brand/Ribbons.astro";
import { BANNER_HEIGHT, BANNER_WIDTH, bannerRibbons } from "../../../brand/ribbons";

const layers = ["Foundations", "Primitives", "Compositions", "Blocks"];

// One layer is a rhombus seen in isometric view; each layer above sits `gap` units higher.
const gap = 75;
// The stack's height follows the number of layers: the top layer's offset plus one rhombus.
const stackHeight = (layers.length - 1) * gap + 238;
const plane = "0,111 245,0 467,121 223,238";
// Labels run along the front-right edge, from the front corner toward the right corner.
const edgeAngle = (Math.atan2(121 - 238, 467 - 223) * 180) / Math.PI;
---

<figure class="not-prose axb" aria-label="Axiom: build mobile experiences, not isolated components. From foundations to blocks.">
<div class="axb__frame">
	<Ribbons
		id="axb"
		class="axb__ribbons"
		viewBox={`0 0 ${BANNER_WIDTH} ${BANNER_HEIGHT}`}
		preserveAspectRatio="xMidYMid slice"
		ribbons={bannerRibbons}
	/>

	<div class="axb__copy">
		<Logo className="axb__logo" />
		<p class="axb__tagline">Build mobile experiences,<br />not isolated components.</p>
	</div>

	<svg class="axb__stack" viewBox={`-4 -4 475 ${stackHeight + 8}`} aria-hidden="true">
		{
			layers.map((name, i) => {
				const y = (layers.length - 1 - i) * gap;
				return (
					<g transform={`translate(0 ${y})`}>
						<polygon points={plane} class="axb__plane" />
						<text transform={`translate(238 220) rotate(${edgeAngle})`} class="axb__label">
							{name}
						</text>
					</g>
				);
			})
		}
	</svg>
</div>
</figure>

<style>
	.axb {
		--axb-bg: var(--color-fd-background);
		--axb-ink: var(--color-fd-foreground);
		--axb-muted: var(--color-fd-muted-foreground);
		container-type: inline-size;
		margin: 0 0 2.5rem;
		overflow: hidden;
		border: 1px solid var(--color-fd-border);
		border-radius: 0;
		background: var(--axb-bg);
		color: var(--axb-ink);
	}

	.axb__frame {
		position: relative;
		aspect-ratio: 16 / 9;
	}

	.axb :global(.axb__ribbons) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.axb__copy {
		position: absolute;
		left: 15.7%;
		top: 36%;
		display: flex;
		flex-direction: column;
		gap: 2.2cqw;
	}

	.axb__copy :global(.axb__logo) {
		font-size: 7.5cqw;
		color: var(--axb-ink);
	}

	.axb__tagline {
		margin: 0;
		font-family: "Outfit", var(--font-sans);
		font-weight: 300;
		font-size: 2.65cqw;
		line-height: 1.25;
		color: var(--axb-muted);
	}

	.axb__stack {
		position: absolute;
		left: 59.5%;
		top: 25%;
		width: 28.4%;
		overflow: visible;
	}

	.axb__plane {
		fill: var(--axb-bg);
		stroke: color-mix(in srgb, var(--axb-ink) 75%, transparent);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}

	.axb__label {
		font-family: var(--font-sans);
		font-size: 18px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		fill: color-mix(in srgb, var(--axb-ink) 80%, transparent);
	}

	/* Narrow columns: the copy stays readable and the stack moves below it. */
	@container (max-width: 560px) {
		.axb__frame {
			aspect-ratio: auto;
		}

		.axb__copy {
			position: relative;
			left: auto;
			top: auto;
			padding: 2rem 1.5rem 0;
			gap: 0.75rem;
		}

		.axb__copy :global(.axb__logo) {
			font-size: clamp(2rem, 13cqw, 2.75rem);
		}

		.axb__tagline {
			font-size: clamp(0.95rem, 4.5cqw, 1.05rem);
		}

		.axb__stack {
			position: relative;
			left: auto;
			top: auto;
			display: block;
			width: 62%;
			margin: 1.5rem auto 2rem;
		}
	}
</style>
