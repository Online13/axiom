---
// Primitives → Composition → Block, drawn as one real chain: Icon, Switch and Item converge into Settings Item,
// and Settings Items make a Settings Section. Atomic Design stays visible, discreetly, as the way primitives are sorted.
// Wide screens lay the three stages in a row joined by connectors; phones stack them with a down arrow.
// Illustrations use the docs palette only, so they follow the light / dark theme.

const line = 'block h-1 rounded-full bg-fd-muted-foreground/30';
const strong = 'block h-1 rounded-full bg-fd-foreground/70';
const box = 'rounded-[4px] border border-fd-border bg-fd-background';

// Height of the schematic panels, in px. The connectors are drawn for exactly this height.
const panel = 168;
const thirds = [panel / 6, panel / 2, (panel * 5) / 6];
---

<figure class="not-prose my-6" aria-label="Icon, Switch and Item are primitives. Together they make the Settings Item composition. Settings Items make the Settings Section block.">
  <div class="flex flex-col items-stretch sm:flex-row">
    <!-- Primitives -->
    <div class="flex flex-1 flex-col overflow-hidden rounded-lg border bg-fd-card text-fd-card-foreground">
      <div class="border-b px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-fd-muted-foreground">Primitives</div>
      <div class="cl-panel flex flex-col border-b" style={{ height: `${panel}px` }} aria-hidden="true">
        <span class="flex flex-1 items-center gap-3 border-b border-dashed border-fd-border px-3">
          <span class="flex w-14 justify-center">
            <svg width="18" height="18" viewBox="0 0 20 20" class="text-fd-foreground"><path d="M10 3a4.5 4.5 0 00-4.5 4.5c0 4-1.5 5.5-1.5 5.5h12s-1.5-1.5-1.5-5.5A4.5 4.5 0 0010 3zM8.5 16a1.6 1.6 0 003 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="text-xs">Icon</span>
        </span>
        <span class="flex flex-1 items-center gap-3 border-b border-dashed border-fd-border px-3">
          <span class="flex w-14 justify-center">
            <span class="flex h-4 w-7 items-center justify-end rounded-full bg-fd-foreground px-0.5"><span class="size-3 rounded-full bg-fd-background" /></span>
          </span>
          <span class="text-xs">Switch</span>
        </span>
        <span class="flex flex-1 items-center gap-3 px-3">
          <span class={`flex h-6 w-14 items-center gap-1 px-1 ${box}`}>
            <span class="size-2.5 shrink-0 rounded-full bg-fd-muted-foreground/40" />
            <span class={`${line} flex-1`} />
            <svg width="6" height="8" viewBox="0 0 6 10" class="shrink-0 text-fd-muted-foreground"><path d="M1 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </span>
          <span class="text-xs">Item</span>
        </span>
      </div>
      <div class="flex flex-col gap-0.5 p-3">
        <span class="text-sm font-medium leading-5">Icon, Switch, Item</span>
        <span class="text-xs text-fd-muted-foreground">Atoms · Molecules · Organisms · Templates</span>
      </div>
    </div>

    <!-- Primitives converge into the composition -->
    <div class="flex shrink-0 flex-col" aria-hidden="true">
      <span class="hidden h-[31px] sm:block" />
      <svg class="hidden text-fd-muted-foreground sm:block" width="40" height={panel} viewBox={`0 0 40 ${panel}`}>
        {thirds.map((y) => (
          <path d={`M0 ${y} C 20 ${y}, 18 ${panel / 2}, 34 ${panel / 2}`} fill="none" stroke="currentColor" stroke-width="1.2" />
        ))}
        <path d={`M30 ${panel / 2 - 4} L36 ${panel / 2} L30 ${panel / 2 + 4}`} fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <svg class="mx-auto my-1.5 text-fd-muted-foreground sm:hidden" width="16" height="24" viewBox="0 0 16 24">
        <path d="M8 2v18M3 15l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>

    <!-- Composition -->
    <div class="flex flex-1 flex-col overflow-hidden rounded-lg border bg-fd-card text-fd-card-foreground">
      <div class="border-b px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-fd-muted-foreground">Composition</div>
      <div class="cl-panel flex items-center justify-center border-b" style={{ height: `${panel}px` }} aria-hidden="true">
        <span class={`flex h-9 w-[128px] items-center gap-2 px-2 ${box}`}>
          <svg width="14" height="14" viewBox="0 0 20 20" class="shrink-0 text-fd-muted-foreground"><path d="M10 3a4.5 4.5 0 00-4.5 4.5c0 4-1.5 5.5-1.5 5.5h12s-1.5-1.5-1.5-5.5A4.5 4.5 0 0010 3zM8.5 16a1.6 1.6 0 003 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class={`${strong} flex-1`} />
          <span class="flex h-4 w-7 shrink-0 items-center justify-end rounded-full bg-fd-foreground px-0.5"><span class="size-3 rounded-full bg-fd-background" /></span>
        </span>
      </div>
      <div class="flex flex-col gap-0.5 p-3">
        <span class="text-sm font-medium leading-5">Settings Item</span>
        <span class="text-xs text-fd-muted-foreground">One ready-made row, installed with its primitives</span>
      </div>
    </div>

    <!-- Composition feeds the block -->
    <div class="flex shrink-0 flex-col" aria-hidden="true">
      <span class="hidden h-[31px] sm:block" />
      <svg class="hidden text-fd-muted-foreground sm:block" width="28" height={panel} viewBox={`0 0 28 ${panel}`}>
        <path d={`M0 ${panel / 2} H22`} fill="none" stroke="currentColor" stroke-width="1.2" />
        <path d={`M18 ${panel / 2 - 4} L24 ${panel / 2} L18 ${panel / 2 + 4}`} fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <svg class="mx-auto my-1.5 text-fd-muted-foreground sm:hidden" width="16" height="24" viewBox="0 0 16 24">
        <path d="M8 2v18M3 15l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>

    <!-- Block -->
    <div class="flex flex-1 flex-col overflow-hidden rounded-lg border bg-fd-card text-fd-card-foreground">
      <div class="border-b px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-fd-muted-foreground">Block</div>
      <div class="cl-panel flex items-center justify-center border-b" style={{ height: `${panel}px` }} aria-hidden="true">
        <span class="flex w-[128px] flex-col gap-1.5">
          <span class={`${line} ml-1 w-10`} />
          <span class="flex flex-col rounded-[4px] bg-fd-background">
            {['switch', 'chevron', 'chevron'].map((trailing, i) => (
              <span class={`flex h-7 items-center gap-2 px-2 ${i ? 'border-t border-fd-border' : ''}`}>
                <span class="size-3 shrink-0 rounded-full border-[1.5px] border-fd-muted-foreground" />
                <span class={`${line} flex-1`} />
                {trailing === 'switch' ? (
                  <span class="flex h-3 w-5 shrink-0 items-center justify-end rounded-full bg-fd-foreground px-px"><span class="size-2.5 rounded-full bg-fd-background" /></span>
                ) : (
                  <svg width="6" height="8" viewBox="0 0 6 10" class="shrink-0 text-fd-muted-foreground"><path d="M1 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                )}
              </span>
            ))}
          </span>
          <span class={`${line} ml-1 w-20`} />
        </span>
      </div>
      <div class="flex flex-col gap-0.5 p-3">
        <span class="text-sm font-medium leading-5">Settings Section</span>
        <span class="text-xs text-fd-muted-foreground">A titled group of Settings Items</span>
      </div>
    </div>
  </div>
</figure>

<style>
  .cl-panel {
    background-color: color-mix(in oklab, var(--color-fd-muted) 60%, transparent);
    background-image: radial-gradient(currentColor 1px, transparent 1px);
    background-size: 8px 8px;
    background-position: -1px -1px;
    color: color-mix(in oklab, var(--color-fd-muted-foreground) 14%, transparent);
  }

  /* The dotted background sets `color`; the content keeps the card's. */
  .cl-panel > * {
    color: var(--color-fd-card-foreground);
  }
</style>
