---
// A full-height inbox driven by the same logic as useCollapsibleHeader.
// Scroll the list (wheel, trackpad, touch or mouse drag): the header follows the scroll position,
// progress = clamp(offset / (expanded - collapsed), 0, 1). The large title fades out, the compact title fades in,
// and a scroll that stops half-way scrolls to the nearest end. Dragging down at the top stretches the header.
// The footer mirrors what the hook returns: offset, progress and height.
import PhonePreview from '@docs/components/preview/phone-preview.astro';
import Glyph from '@docs/components/preview/glyph.astro';

const expanded = 96;
const collapsed = 44;

const messages = [
  ['Grace Hopper', 'Found the bug. It was a moth.'],
  ['Alan Turing', 'Can a machine think? Lunch first.'],
  ['Katherine Johnson', 'Trajectory numbers attached.'],
  ['Linus Torvalds', 'Just a hobby, won’t be big.'],
  ['Margaret Hamilton', 'Priority alarms are fine.'],
  ['Ada Lovelace', 'Notes on the engine, part G.'],
  ['Dennis Ritchie', 'hello, world'],
  ['Barbara Liskov', 'About that substitution…'],
  ['Edsger Dijkstra', 'Goto considered harmful.'],
  ['Frances Allen', 'The compiler is faster now.'],
  ['Ken Thompson', 'Trust nothing you didn’t compile.'],
  ['Radia Perlman', 'The spanning tree converged.'],
  ['John McCarthy', '(lambda (x) (lunch x))'],
  ['Hedy Lamarr', 'Frequency hopping, patent filed.'],
  ['Tim Berners-Lee', 'Put it on a web page.'],
  ['Donald Knuth', 'Volume 4 is almost ready.'],
];

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .slice(0, 2)
    .join('');
---

<PhonePreview full>
  <div class="chp" data-collapsible-header data-expanded={expanded} data-collapsed={collapsed} style={`--chp-expanded:${expanded}px`}>
    <div class="chp-scroller" data-scroller>
      <div class="ax-list" data-variant="plain" data-inset>
        {
          messages.map(([name, text], index) => (
            <div class="ax-item">
              <span class="ax-avatar" data-photo={String((index % 5) + 1)}>{initials(name)}</span>
              <div class="ax-item-content">
                <span class="ax-item-title">{name}</span>
                <span class="ax-item-desc">{text}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="chp-header" data-header>
      <div class="ax-appbar">
        <span class="ax-appbar-slot"><span class="ax-icon-btn"><Glyph name="filter" /></span></span>
        <span class="ax-appbar-title chp-compact">Inbox</span>
        <span class="ax-appbar-slot" data-side="end"><span class="ax-icon-btn"><Glyph name="edit" /></span></span>
      </div>
      <div class="ax-large-heading chp-large">Inbox</div>
    </div>
  </div>

  <div slot="footer" class="border-t px-4 py-3 font-mono text-xs" data-chp-readout>
    <span class="text-fd-muted-foreground">offset </span><span data-out="offset">0</span>
    <span class="text-fd-muted-foreground"> · progress </span><span data-out="progress">0.00</span>
    <span class="text-fd-muted-foreground"> · height </span><span data-out="height">{expanded}</span>
  </div>
</PhonePreview>

<style is:global>
  .chp {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    --chp-progress: 0;
    --chp-stretch: 0px;
  }

  .chp-scroller {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    cursor: grab;
    padding-top: var(--chp-expanded);
  }

  .chp-scroller::-webkit-scrollbar {
    display: none;
  }

  .chp-scroller > .ax-list {
    transform: translateY(var(--chp-stretch));
  }

  .chp-scroller[data-dragging] {
    cursor: grabbing;
    user-select: none;
  }

  .chp-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: var(--chp-height, var(--chp-expanded));
    overflow: hidden;
    background: var(--ax-background-default);
    border-bottom: 0.5px solid transparent;
  }

  .chp[data-collapsed-state] .chp-header {
    border-bottom-color: var(--ax-border-default);
  }

  .chp-compact {
    opacity: clamp(0, calc((var(--chp-progress) - 0.6) / 0.4), 1);
  }

  .chp-large {
    position: absolute;
    left: 0;
    bottom: 0;
    transform-origin: left bottom;
    opacity: clamp(0, calc(1 - var(--chp-progress) * 1.6), 1);
    transform: scale(calc(1 - var(--chp-progress) * 0.2 + var(--chp-grow, 0)));
  }

  .chp[data-settling] .chp-header,
  .chp[data-settling] .chp-large,
  .chp[data-settling] .chp-scroller > .ax-list {
    transition:
      height 300ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .chp[data-settling] .chp-header,
    .chp[data-settling] .chp-large,
    .chp[data-settling] .chp-scroller > .ax-list {
      transition: none;
    }
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-collapsible-header]:not([data-ready])').forEach((root) => {
      root.dataset.ready = '';
      const expanded = Number(root.dataset.expanded);
      const collapsed = Number(root.dataset.collapsed);
      const range = expanded - collapsed;
      const maxStretch = 120;
      const scroller = root.querySelector<HTMLElement>('[data-scroller]')!;
      const readout = root.closest('[data-ax-preview]')!.querySelector<HTMLElement>('[data-chp-readout]')!;
      const out = (key: string) => readout.querySelector<HTMLElement>(`[data-out="${key}"]`)!;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let stretch = 0;
      let snapTimer = 0;

      const render = () => {
        const offset = stretch > 0 ? -stretch : scroller.scrollTop;
        const progress = Math.min(Math.max(offset / range, 0), 1);
        const height = expanded - progress * range + stretch;
        root.style.setProperty('--chp-progress', String(progress));
        root.style.setProperty('--chp-height', `${height}px`);
        root.style.setProperty('--chp-stretch', `${stretch}px`);
        root.style.setProperty('--chp-grow', String(stretch * 0.0015));
        root.toggleAttribute('data-collapsed-state', progress === 1);
        out('offset').textContent = String(Math.round(offset));
        out('progress').textContent = progress.toFixed(2);
        out('height').textContent = String(Math.round(height));
      };

      // A scroll that stops between the two heights scrolls the list to the nearest end, so header and offset stay in sync.
      const snap = () => {
        const offset = scroller.scrollTop;
        if (offset <= 0 || offset >= range) return;
        scroller.scrollTo({ top: offset < range / 2 ? 0 : range, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      };

      scroller.addEventListener(
        'scroll',
        () => {
          render();
          clearTimeout(snapTimer);
          snapTimer = window.setTimeout(() => scroller.dataset.dragging === undefined && snap(), 160);
        },
        { passive: true },
      );

      // Mouse drag scrolls like a finger. At the top, dragging further down stretches the header (the iOS bounce).
      let startY = 0;
      let startScroll = 0;
      const resist = (drag: number) => (drag * maxStretch) / (drag + maxStretch);

      scroller.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse') return;
        startY = event.clientY;
        startScroll = scroller.scrollTop;
        scroller.dataset.dragging = '';
        delete root.dataset.settling;
        scroller.setPointerCapture(event.pointerId);
      });

      scroller.addEventListener('pointermove', (event) => {
        if (scroller.dataset.dragging === undefined) return;
        const zoom = scroller.getBoundingClientRect().height / scroller.clientHeight || 1;
        const target = startScroll - (event.clientY - startY) / zoom;
        scroller.scrollTop = Math.max(target, 0);
        stretch = target < 0 && !reduceMotion.matches ? resist(-target) : 0;
        render();
      });

      const release = () => {
        if (scroller.dataset.dragging === undefined) return;
        delete scroller.dataset.dragging;
        if (stretch > 0) {
          root.dataset.settling = '';
          stretch = 0;
          render();
          setTimeout(() => delete root.dataset.settling, 320);
        } else {
          snap();
        }
      };

      scroller.addEventListener('pointerup', release);
      scroller.addEventListener('pointercancel', release);

      render();
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
