---
// The five states a loading screen can be in, side by side. Only one is on screen at a time.
import TokenFrame from '@/components/tokens/token-frame.astro';
import Glyph from '@/components/preview/glyph.astro';

const states = [
  { label: 'loading', caption: 'Skeleton rows shaped like the content.' },
  { label: 'content', caption: 'The data. A refresh keeps it visible.' },
  { label: 'empty', icon: 'bag', title: 'No orders yet', action: 'Browse the shop', caption: 'Success with nothing in it. One way forward.' },
  { label: 'error', icon: 'alert', title: "Couldn't load", action: 'Try again', tone: 'error', caption: 'Plain words, no code, a retry.' },
  { label: 'offline', icon: 'wifi-off', title: "You're offline", action: 'Try again', caption: 'The fix is the network. Retries by itself.' },
] as const;
---

<TokenFrame>
  <div class="grid min-w-[44rem] grid-cols-5 gap-px bg-fd-border">
    {
      states.map((state) => (
        <div class="flex flex-col gap-3 bg-fd-card p-3">
          <div class="mx-auto flex h-[9.5rem] w-[104px] flex-col overflow-hidden rounded-md border bg-fd-card">
            <div class="flex h-5 flex-none items-center justify-center border-b text-[8px] font-semibold">Orders</div>
            {state.label === 'loading' &&
              [60, 45, 70, 50, 40].map((w) => (
                <div class="flex h-6 flex-none items-center gap-1.5 px-1.5">
                  <span class="size-3.5 flex-none animate-pulse rounded-[3px] bg-fd-muted" />
                  <span class="h-1.5 animate-pulse rounded-full bg-fd-muted" style={{ width: `${w}%` }} />
                </div>
              ))}
            {state.label === 'content' &&
              [0, 1, 2, 3, 4].map(() => (
                <div class="flex h-6 flex-none items-center gap-1.5 border-b px-1.5">
                  <span class="flex size-3.5 flex-none items-center justify-center rounded-[3px] bg-fd-muted">
                    <Glyph name="bag" size={7} class="text-fd-muted-foreground" />
                  </span>
                  <span class="h-1.5 flex-1 rounded-full bg-fd-foreground/60" />
                </div>
              ))}
            {'icon' in state && (
              <div class="flex flex-1 flex-col items-center justify-center gap-1 px-1 text-center">
                <span class:list={['flex size-5 items-center justify-center rounded-full', 'tone' in state ? 'bg-red-500/15 text-red-500' : 'bg-fd-muted text-fd-muted-foreground']}>
                  <Glyph name={state.icon} size={10} />
                </span>
                <span class="text-[7px] font-semibold">{state.title}</span>
                <span class="rounded-[3px] border px-1 text-[6px]">{state.action}</span>
              </div>
            )}
          </div>
          <div class="font-mono text-xs">{state.label}</div>
          <p class="text-xs text-fd-muted-foreground">{state.caption}</p>
        </div>
      ))
    }
  </div>
</TokenFrame>
