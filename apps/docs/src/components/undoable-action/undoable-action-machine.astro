---
// One pending action at a time. The screen changes at once; the request waits for the snackbar.
import StateMachine, { type StateEdge, type StateNode } from '@/components/state-machine/state-machine.astro';

const nodes: StateNode[] = [
  { id: 'idle', label: 'idle', x: 110, y: 150, caption: 'Nothing pending. The list is what the server has.' },
  { id: 'pending', label: 'pending', x: 360, y: 150, caption: 'The item has left the list and the snackbar shows "Archived · Undo" for 4s. Nothing is sent yet.' },
  { id: 'committed', label: 'committed', x: 610, y: 150, caption: 'The request is sent. The snackbar is gone and the action can no longer be undone.' },
];

const edges: StateEdge[] = [
  { from: 'idle', to: 'pending', label: 'action', via: [235, 80] },
  { from: 'pending', to: 'idle', label: 'Undo · item back', via: [235, 220] },
  { from: 'pending', to: 'committed', label: '4s timeout', via: [485, 80] },
  { from: 'pending', to: 'committed', label: 'leave · background', via: [485, 220] },
  { from: 'pending', to: 'pending', label: 'another action · commits this one', loop: 'above' },
  { from: 'committed', to: 'idle', label: 'request sent', via: [360, 330], labelOffset: [0, 8] },
];
---

<StateMachine nodes={nodes} edges={edges} initial="idle" width={720} height={270} />
