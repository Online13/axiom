---
// Four frozen frames of an undoable archive. The list changes at once; the server only hears about it at the end.
import TokenFrame from '@/components/tokens/token-frame.astro';
import Glyph from '@/components/preview/glyph.astro';

const states = [
  { label: 'idle', rows: [0, 1, 2, 3], snackbar: false, server: '', caption: 'Four rows. The user taps archive on the second.' },
  { label: 'pending', rows: [0, 2, 3], snackbar: true, server: '', caption: 'The row is gone, Undo is offered. Nothing sent yet.' },
  { label: 'undo', rows: [0, 1, 2, 3], snackbar: false, server: 'nothing sent', highlight: 1, caption: 'Undo: the row is back in its place.' },
  { label: 'timeout', rows: [0, 2, 3], snackbar: false, server: 'archive() sent', caption: 'No undo within 4s: the request leaves.' },
];
---

<TokenFrame>
  <div class="grid min-w-[36rem] grid-cols-4 gap-px bg-fd-border">
    {
      states.map(({ label, rows, snackbar, server, highlight, caption }) => (
        <div class="flex flex-col gap-3 bg-fd-card p-3">
          <div class="relative mx-auto flex h-[9.5rem] w-[104px] flex-col overflow-hidden rounded-md border bg-fd-card">
            <div class="flex h-5 flex-none items-center justify-center border-b text-[8px] font-semibold">Notifications</div>
            {rows.map((i) => (
              <div class:list={['flex h-6 flex-none items-center gap-1.5 border-b px-1.5', highlight === i && 'bg-blue-500/10']}>
                <span class="size-3 flex-none rounded-full bg-fd-muted" />
                <span class="h-1.5 flex-1 rounded-full bg-fd-muted" />
                <Glyph name="archive" size={8} class="text-fd-muted-foreground" />
              </div>
            ))}
            {snackbar && (
              <div class="absolute inset-x-1 bottom-1 flex h-4 items-center justify-between rounded-[3px] bg-fd-foreground px-1.5 text-[6.5px] text-fd-background">
                <span>Archived</span>
                <span class="font-semibold text-blue-400">Undo</span>
              </div>
            )}
          </div>
          <div class="font-mono text-xs">
            {label}
            {server && <span class="text-fd-muted-foreground"> · {server}</span>}
          </div>
          <p class="text-xs text-fd-muted-foreground">{caption}</p>
        </div>
      ))
    }
  </div>
</TokenFrame>
