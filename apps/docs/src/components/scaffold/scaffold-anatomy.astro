---
import Glyph from '@/components/preview/glyph.astro';
import PhonePreview from '@/components/preview/phone-preview.astro';

const regions = [
  {
    number: '1',
    name: 'Scaffold.AppBar',
    description: 'Holds navigation, the screen title and contextual actions.',
  },
  {
    number: '2',
    name: 'Scaffold.Content',
    description: 'Takes the available height and owns scrolling by default.',
  },
  {
    number: '3',
    name: 'Scaffold.Footer',
    description: 'Keeps the main action visible below the scrolling content.',
  },
  {
    number: '4',
    name: 'safeAreaEdges',
    description: 'Protect content around the status bar and home indicator.',
  },
];
---

<section class="scaffold-anatomy not-prose" aria-labelledby="scaffold-anatomy-title">
  <h2 id="scaffold-anatomy-title" class="sr-only">Scaffold anatomy</h2>

  <PhonePreview full size="sm">
    <span class="safe-area safe-area-top" aria-hidden="true"></span>
    <span class="safe-area safe-area-bottom" aria-hidden="true"></span>
    <span class="region-marker safe-area-marker" aria-hidden="true">4</span>

    <div class="scaffold-region appbar-region">
      <span class="region-marker" aria-hidden="true">1</span>
      <div class="ax-appbar" data-border>
        <span class="ax-appbar-slot"><span class="ax-icon-btn"><Glyph name="chevron-left" /></span></span>
        <span class="ax-appbar-title">Edit profile</span>
        <span class="ax-appbar-slot"></span>
      </div>
    </div>

    <div class="scaffold-region content-region">
      <span class="region-marker" aria-hidden="true">2</span>
      <div class="ax-body">
        <div class="ax-row" data-justify="center">
          <span class="ax-avatar" data-size="xl" data-photo="3"><span class="ax-avatar-status"><Glyph name="camera" size={12} /></span></span>
        </div>
        <div class="ax-field"><span class="ax-label">Name</span><div class="ax-control"><span class="ax-value">Ada Lovelace</span></div></div>
        <div class="ax-field"><span class="ax-label">Bio</span><div class="ax-textarea"><span>Mathematician and writer.</span></div></div>
      </div>
    </div>

    <div class="scaffold-region footer-region">
      <span class="region-marker" aria-hidden="true">3</span>
      <div class="ax-body footer-content"><span class="ax-btn" data-size="lg" data-block>Save changes</span></div>
    </div>
  </PhonePreview>

  <p class="anatomy-summary"><code>Scaffold</code> fills the screen, then arranges its regions vertically.</p>

  <ol class="anatomy-legend" aria-label="Scaffold regions">
    {regions.map((region) => (
      <li>
        <span class="legend-number" aria-hidden="true">{region.number}</span>
        <span><strong>{region.name}</strong><span>{region.description}</span></span>
      </li>
    ))}
  </ol>
</section>

<style>
  .scaffold-anatomy {
    margin-block: 1.5rem;
  }

  .scaffold-anatomy :global([data-ax-preview]) {
    margin-block: 0;
  }

  .scaffold-region {
    position: relative;
    display: flex;
    flex: none;
    flex-direction: column;
    outline: 2px solid color-mix(in srgb, #8b5cf6 72%, transparent);
    outline-offset: -2px;
  }

  .content-region {
    flex: 1;
    min-height: 0;
    background: color-mix(in srgb, #0ea5e9 7%, transparent);
    outline-color: color-mix(in srgb, #0ea5e9 72%, transparent);
  }

  .footer-region {
    padding-bottom: 28px;
    background: color-mix(in srgb, #f59e0b 8%, transparent);
    outline-color: color-mix(in srgb, #f59e0b 78%, transparent);
  }

  .footer-content {
    padding-bottom: 12px;
  }

  .region-marker {
    position: absolute;
    top: 8px;
    right: 10px;
    z-index: 20;
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 2px solid var(--ax-background-default);
    border-radius: 999px;
    background: #8b5cf6;
    color: white;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
  }

  .content-region > .region-marker {
    background: #0284c7;
  }

  .footer-region > .region-marker {
    top: -14px;
    background: #d97706;
  }

  .safe-area {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 3;
    background: color-mix(in srgb, #10b981 16%, transparent);
    pointer-events: none;
  }

  .safe-area-top {
    top: -44px;
    height: 44px;
    border-bottom: 2px solid color-mix(in srgb, #10b981 75%, transparent);
  }

  .safe-area-bottom {
    bottom: 0;
    height: 28px;
    border-top: 2px solid color-mix(in srgb, #10b981 75%, transparent);
  }

  .safe-area-marker {
    top: auto;
    right: 10px;
    bottom: 2px;
    z-index: 21;
    background: #059669;
  }

  .anatomy-legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 1px;
    border: 1px solid var(--color-fd-border);
    border-top: 0;
    background: var(--color-fd-border);
    list-style: none;
  }

  .anatomy-summary {
    margin: 0;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-fd-border);
    border-top: 0;
    background: var(--color-fd-card);
    color: var(--color-fd-muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .anatomy-summary code {
    color: var(--color-fd-foreground);
    font-weight: 600;
  }

  .anatomy-legend li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    background: var(--color-fd-card);
  }

  .anatomy-legend li > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--color-fd-muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .anatomy-legend strong {
    color: var(--color-fd-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .legend-number {
    display: grid;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border-radius: 999px;
    background: #8b5cf6;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .anatomy-legend li:nth-child(2) .legend-number { background: #0284c7; }
  .anatomy-legend li:nth-child(3) .legend-number { background: #d97706; }
  .anatomy-legend li:nth-child(4) .legend-number { background: #059669; }

  @media (max-width: 640px) {
    .anatomy-legend {
      grid-template-columns: 1fr;
    }
  }
</style>
