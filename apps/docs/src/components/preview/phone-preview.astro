---
// An iPhone 15 used to show a component in context, with a light / dark toggle.
// The screen is laid out in real iOS points (393 wide) and scaled down, so previews use real sizes: 17pt body, 44pt controls.
// `half="top"` shows the status bar and the upper half, `half="bottom"` the lower half with the home indicator.
// `full` shows the complete screen when the relationship between regions matters.
// Colors come from `data-scheme` (see preview-theme.astro); the content draws itself with the `.ax-*` classes of preview.css.

interface Props {
  half?: 'top' | 'bottom';
  full?: boolean;
  size?: 'lg' | 'sm';
  // Paints the screen with background.subtle, for grouped lists and settings screens.
  grouped?: boolean;
  // Vertical alignment of the content inside the visible viewport.
  align?: 'start' | 'center' | 'end';
}

const { half = 'top', full = false, size = 'lg', grouped = false, align } = Astro.props;
const view = full ? 'full' : half;
const justify = align ?? (view === 'bottom' ? 'end' : 'start');
---

<div class="not-prose my-6 border bg-fd-card" data-ax-preview data-scheme="light" data-size={size}>
  <div class="flex items-center justify-end border-b px-3 py-2">
    <div class="inline-flex border p-0.5 text-xs" role="group" aria-label="Color scheme">
      <button type="button" class="ax-toggle px-2.5 py-0.5" data-ax-scheme="light" aria-pressed="true">Light</button>
      <button type="button" class="ax-toggle px-2.5 py-0.5" data-ax-scheme="dark" aria-pressed="false">Dark</button>
    </div>
  </div>

  <div class="ax-stage" data-view={view}>
    <div class="ax-phone">
      <div class="ax-screen" data-grouped={grouped ? 'true' : undefined}>
        {
          view !== 'bottom' && (
            <div class="ax-status" aria-hidden="true">
              <span>9:41</span>
              <span class="ax-island" />
              <svg width="44" height="12" viewBox="0 0 44 12" fill="currentColor">
                <rect x="0" y="7" width="3" height="4" rx="1" />
                <rect x="4.5" y="5" width="3" height="6" rx="1" />
                <rect x="9" y="3" width="3" height="8" rx="1" />
                <rect x="13.5" y="1" width="3" height="10" rx="1" />
                <rect x="21" y="1" width="20" height="10" rx="3" fill="none" stroke="currentColor" stroke-opacity="0.4" />
                <rect x="23" y="3" width="14" height="6" rx="1.5" />
                <rect x="42" y="4" width="1.5" height="4" rx="0.75" opacity="0.4" />
              </svg>
            </div>
          )
        }
        <div class="ax-viewport" data-view={view} data-align={justify}>
          <slot />
        </div>
        {view !== 'top' && <div class="ax-home" aria-hidden="true" />}
      </div>
    </div>
  </div>
  <slot name="footer" />
</div>

<style is:global>
  .ax-toggle[aria-pressed='true'] {
    background: var(--color-fd-foreground);
    color: var(--color-fd-background);
  }

  .ax-toggle[aria-pressed='false'] {
    color: var(--color-fd-muted-foreground);
  }

  [data-ax-preview] {
    --ax-scale: 0.8;
  }

  [data-ax-preview][data-size='sm'] {
    --ax-scale: 0.62;
  }

  /* Half-screen views clip the phone. Full-screen views keep its real ratio. */
  .ax-stage {
    display: flex;
    justify-content: center;
    overflow: hidden;
    padding-inline: 16px;
  }

  .ax-stage[data-view='top'] {
    align-items: flex-start;
    height: calc(438px * var(--ax-scale) + 28px);
    padding-top: 28px;
  }

  /* Taller than the stage and aligned to its end: the top of the phone overflows and is clipped. */
  .ax-stage[data-view='bottom'] {
    align-items: flex-end;
    height: calc(438px * var(--ax-scale) + 28px);
    padding-bottom: 28px;
  }

  .ax-phone {
    flex: none;
    padding: calc(12px * var(--ax-scale));
    border-radius: calc(60px * var(--ax-scale));
    background: #1c1c1e;
    box-shadow:
      inset 0 0 0 1.5px #3a3a3c,
      0 20px 40px -20px rgb(0 0 0 / 0.5);
  }

  .ax-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 393px;
    height: 852px;
    zoom: var(--ax-scale);
    overflow: hidden;
    border-radius: 48px;
    background: var(--ax-background-default);
    color: var(--ax-content-default);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', system-ui, sans-serif;
    font-size: 17px;
    line-height: 22px;
    text-align: left;
    transition: background-color 250ms ease;
  }

  .ax-screen[data-grouped] {
    background: var(--ax-background-subtle);
  }

  /* The visible portion of the screen, where the preview content is laid out. */
  .ax-viewport {
    position: relative;
    display: flex;
    flex: none;
    flex-direction: column;
    height: 382px;
  }

  /* Content taller than the half overflows and is clipped, like a scrolled screen, instead of squeezing. */
  .ax-viewport > * {
    flex-shrink: 0;
  }

  .ax-viewport > .ax-fill,
  .ax-viewport > .ax-center {
    flex-shrink: 1;
  }

  .ax-stage[data-view='bottom'] .ax-viewport {
    height: 426px;
    margin-top: auto;
  }

  .ax-viewport[data-view='full'] {
    flex: 1;
    height: auto;
  }

  .ax-stage[data-view='full'] {
    padding-block: 28px;
  }

  .ax-viewport[data-align='center'] {
    justify-content: center;
  }

  .ax-viewport[data-align='end'] {
    justify-content: flex-end;
  }

  .ax-status {
    position: relative;
    z-index: 5;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    /* iPhone 15 top safe area: keep app chrome below the Dynamic Island. */
    height: 59px;
    padding: 0 28px 0 36px;
    color: var(--ax-content-default);
    font-size: 16px;
    font-weight: 600;
  }

  .ax-island {
    position: absolute;
    top: 11px;
    left: 50%;
    width: 124px;
    height: 36px;
    border-radius: 999px;
    background: #000;
    transform: translateX(-50%);
  }

  .ax-home {
    position: absolute;
    bottom: 8px;
    left: 50%;
    z-index: 30;
    width: 140px;
    height: 5px;
    border-radius: 999px;
    background: var(--ax-content-default);
    transform: translateX(-50%);
  }
</style>

<script>
  // One delegated listener for every preview on every page, so client-side navigation needs no re-init.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-ax-scheme]');
    if (!button) return;
    const preview = button.closest<HTMLElement>('[data-ax-preview]')!;
    preview.dataset.scheme = button.dataset.axScheme;
    preview.querySelectorAll('[data-ax-scheme]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
  });
</script>
