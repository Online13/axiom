---
// Exploded view of an open sheet: the screen, the PortalHost above it, the Overlay, then the sheet.
// Each layer is labeled with the component that renders it.
import TokenFrame from '@/components/tokens/token-frame.astro';

const layers = [
  { name: 'Content', detail: 'BottomSheet.Content, Menu.Content…', kind: 'content' },
  { name: 'Overlay', detail: 'dims and catches presses', kind: 'overlay' },
  { name: 'PortalHost', detail: 'fills the screen, empty = no touches', kind: 'host' },
  { name: 'Screen', detail: 'your navigation stack', kind: 'screen' },
];
---

<TokenFrame>
  <div class="overlay-layers flex flex-col items-center gap-6 px-4 py-8 sm:flex-row sm:justify-center sm:gap-10">
    <div class="stack" aria-hidden="true">
      {
        layers.map(({ kind }, i) => (
          <div class:list={['plane', `plane-${kind}`]} style={`--i:${layers.length - 1 - i}`}>
            {kind === 'screen' && (
              <div class="grid grid-cols-3 gap-1 p-3">
                {Array.from({ length: 9 }).map(() => <div class="aspect-square rounded-[3px] bg-neutral-200" />)}
              </div>
            )}
            {kind === 'content' && <div class="sheet" />}
          </div>
        ))
      }
    </div>

    <ol class="flex flex-col gap-3 text-sm">
      {
        layers.map(({ name, detail }, i) => (
          <li class="flex items-baseline gap-3">
            <span class="w-4 font-mono text-xs text-fd-muted-foreground">{layers.length - i}</span>
            <span>
              <span class="font-medium">{name}</span>
              <span class="block text-xs text-fd-muted-foreground">{detail}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</TokenFrame>

<style>
  .stack {
    position: relative;
    width: 240px;
    height: 340px;
  }

  /* Planes share one tilt, then move up on screen by their index, so the stack reads bottom to top. */
  .plane {
    position: absolute;
    top: 150px;
    left: 50px;
    width: 140px;
    height: 200px;
    border-radius: 14px;
    transform: translateY(calc(var(--i) * -60px)) rotateX(58deg) rotateZ(-40deg);
    overflow: hidden;
  }

  .plane-screen {
    background: #fff;
    box-shadow: 0 0 0 1px #d4d4d4;
  }

  .plane-host {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px #a3a3a3;
    outline: 1.5px dashed #a3a3a3;
    outline-offset: -6px;
  }

  /* Semi-transparent gray with an outline, so the layer reads on both light and dark docs themes. */
  .plane-overlay {
    background: rgb(115 115 115 / 0.55);
    box-shadow: 0 0 0 1.5px #a3a3a3;
  }

  .plane-content {
    background: transparent;
  }

  .sheet {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 45%;
    border-radius: 12px 12px 0 0;
    background: #fff;
    box-shadow: 0 0 0 1px #d4d4d4;
  }
</style>
