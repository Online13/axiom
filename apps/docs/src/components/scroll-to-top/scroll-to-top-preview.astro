---
// A full-height news list driven by the same logic as useScrollToTop.
// Scroll past the threshold (one screen) and the button appears. Tap it: far away, the list first jumps to one screen
// from the top, then animates the rest, so the animation never lasts long. The button hides once the list is back.
// `showOn` switches between showing the button whenever past the threshold, or only while scrolling up.
import PhonePreview from '@/components/preview/phone-preview.astro';
import Glyph from '@/components/preview/glyph.astro';

const titles = [
  'Markets open higher after rate decision',
  'A new bridge for the old harbour',
  'The quiet return of the night train',
  'Inside the lab growing coral reefs',
  'Why cities are painting roofs white',
  'Chess engines and the endgame',
  'The last lighthouse keeper',
  'A rover finds salt on Mars',
  'How bakeries survive the heat',
  'Libraries lend tools, not just books',
  'The comeback of the paper map',
  'Tracking whales with sound',
  'A marathon at sea level',
  'Rebuilding a 1960s synthesizer',
  'Forests that plant themselves',
  'The science of a perfect nap',
  'Tiny homes, big waiting lists',
  'The river that changed course',
  'A museum for lost luggage',
  'Why bees like blue',
  'Fixing phones in the market square',
  'The long history of the umbrella',
  'Solar boats cross the lake',
  'An orchestra of retired robots',
  'The street with no cars',
  'Saving seeds in the Arctic',
  'The mathematics of queues',
  'A school on a train',
  'Night skies are getting brighter',
  'The end of the list',
];
---

<PhonePreview full>
  <div class="stt" data-scroll-to-top data-show-on="always">
    <div class="ax-appbar" data-border>
      <span class="ax-appbar-slot" />
      <span class="ax-appbar-title">News</span>
      <span class="ax-appbar-slot" data-side="end"><span class="ax-icon-btn"><Glyph name="search" /></span></span>
    </div>

    <div class="stt-body">
      <div class="stt-scroller" data-scroller>
        <div class="ax-list" data-variant="plain" data-inset>
          {
            titles.map((title, index) => (
              <div class="ax-item">
                <span class="stt-thumb" data-tone={String(index % 4)} />
                <div class="ax-item-content">
                  <span class="ax-item-title">{title}</span>
                  <span class="ax-item-desc">{index + 1} of {titles.length} · {(index % 9) + 2} min read</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="stt-guide" data-guide aria-hidden="true"><span>threshold</span></div>

      <button type="button" class="stt-button" data-button aria-label="Scroll to top" tabindex="-1">
        <Glyph name="arrow-up" size={22} strokeWidth={2.4} />
      </button>
    </div>
  </div>

  <div slot="footer" class="flex flex-wrap items-center justify-between gap-2 border-t px-4 py-3 font-mono text-xs" data-stt-readout>
    <span>
      <span class="text-fd-muted-foreground">offset </span><span data-out="offset">0</span>
      <span class="text-fd-muted-foreground"> · visible </span><span data-out="visible">false</span>
    </span>
    <span class="inline-flex border p-0.5 font-sans" role="group" aria-label="showOn">
      <button type="button" class="ax-toggle px-2.5 py-0.5" data-show-on-option="always" aria-pressed="true">always</button>
      <button type="button" class="ax-toggle px-2.5 py-0.5" data-show-on-option="scroll-up" aria-pressed="false">scroll-up</button>
    </span>
  </div>
</PhonePreview>

<style is:global>
  .stt {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
  }

  .stt-body {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .stt-scroller {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    cursor: grab;
    padding-bottom: 34px;
  }

  .stt-scroller::-webkit-scrollbar {
    display: none;
  }

  .stt-scroller[data-dragging] {
    cursor: grabbing;
    user-select: none;
  }

  .stt-thumb {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 10px;
    background: linear-gradient(135deg, #a1c4fd, #c2e9fb);
  }

  .stt-thumb[data-tone='1'] { background: linear-gradient(135deg, #fbc2eb, #a6c1ee); }
  .stt-thumb[data-tone='2'] { background: linear-gradient(135deg, #fddb92, #d1fdff); }
  .stt-thumb[data-tone='3'] { background: linear-gradient(135deg, #84fab0, #8fd3f4); }

  /* The threshold line scrolls with the content: it sits one screen below the top of the list. */
  .stt-guide {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--stt-threshold, 700px) - var(--stt-offset, 0px));
    border-top: 1.5px dashed #3b82f6;
    pointer-events: none;
  }

  .stt-guide span {
    position: absolute;
    right: 8px;
    top: 2px;
    font: 11px ui-monospace, monospace;
    color: #3b82f6;
  }

  .stt-button {
    position: absolute;
    right: 20px;
    bottom: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 999px;
    background: var(--ax-background-inverse);
    color: var(--ax-content-inverse);
    box-shadow: var(--ax-shadow);
    cursor: pointer;
    opacity: 0;
    transform: translateY(16px) scale(0.8);
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .stt[data-visible] .stt-button {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .stt-button {
      transition: none;
    }
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-scroll-to-top]:not([data-ready])').forEach((root) => {
      root.dataset.ready = '';
      const scroller = root.querySelector<HTMLElement>('[data-scroller]')!;
      const button = root.querySelector<HTMLButtonElement>('[data-button]')!;
      const readout = root.closest('[data-ax-preview]')!.querySelector<HTMLElement>('[data-stt-readout]')!;
      const out = (key: string) => readout.querySelector<HTMLElement>(`[data-out="${key}"]`)!;
      const options = readout.querySelectorAll<HTMLButtonElement>('[data-show-on-option]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      // One screen of content. Past it, the top of the list is out of reach.
      const threshold = scroller.clientHeight;
      root.style.setProperty('--stt-threshold', `${threshold}px`);

      let previous = 0;
      let returning = false;

      const setVisible = (visible: boolean) => {
        root.toggleAttribute('data-visible', visible);
        out('visible').textContent = String(visible);
      };

      scroller.addEventListener(
        'scroll',
        () => {
          const offset = Math.max(scroller.scrollTop, 0);
          root.style.setProperty('--stt-offset', `${offset}px`);
          out('offset').textContent = String(Math.round(offset));

          if (returning) {
            if (offset === 0) returning = false;
          } else if (offset < threshold) {
            setVisible(false);
          } else if (root.dataset.showOn === 'scroll-up') {
            if (offset < previous) setVisible(true);
            else if (offset > previous) setVisible(false);
          } else {
            setVisible(true);
          }
          previous = offset;
        },
        { passive: true },
      );

      // Far from the top, jump to one screen away first, then animate: the return always takes the same short time.
      let frame = 0;
      button.addEventListener('click', () => {
        returning = true;
        setVisible(false);
        if (reduceMotion.matches) {
          scroller.scrollTop = 0;
          return;
        }
        if (scroller.scrollTop > threshold * 2) scroller.scrollTop = threshold;
        const from = scroller.scrollTop;
        const start = performance.now();
        const step = (now: number) => {
          if (!returning) return;
          const t = Math.min((now - start) / 400, 1);
          scroller.scrollTop = from * (1 - (1 - (1 - t) ** 3));
          if (t < 1) frame = requestAnimationFrame(step);
        };
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(step);
      });

      // A user scroll interrupts the return: the button follows the scroll again.
      const interrupt = () => {
        returning = false;
        cancelAnimationFrame(frame);
      };
      scroller.addEventListener('wheel', interrupt, { passive: true });
      scroller.addEventListener('touchstart', interrupt, { passive: true });
      scroller.addEventListener('pointerdown', interrupt);

      options.forEach((option) =>
        option.addEventListener('click', () => {
          root.dataset.showOn = option.dataset.showOnOption;
          options.forEach((o) => o.setAttribute('aria-pressed', String(o === option)));
          scroller.dispatchEvent(new Event('scroll'));
        }),
      );

      // Mouse drag scrolls like a finger. Touch and wheel already scroll natively.
      let startY = 0;
      let startScroll = 0;
      scroller.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse') return;
        startY = event.clientY;
        startScroll = scroller.scrollTop;
        scroller.dataset.dragging = '';
        scroller.setPointerCapture(event.pointerId);
      });
      scroller.addEventListener('pointermove', (event) => {
        if (scroller.dataset.dragging === undefined) return;
        const zoom = scroller.getBoundingClientRect().height / scroller.clientHeight || 1;
        scroller.scrollTop = startScroll - (event.clientY - startY) / zoom;
      });
      const release = () => delete scroller.dataset.dragging;
      scroller.addEventListener('pointerup', release);
      scroller.addEventListener('pointercancel', release);
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
