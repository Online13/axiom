---
// The five component levels as small schematics, from the smallest piece to a complete screen.
// Each level reuses the one before it, so each schematic contains the shapes of the previous one.
// The level number leads the card as a filled badge in the top-left corner of the schematic panel.
// Illustrations use the docs palette only, so they follow the light / dark theme.

const levels = [
  { id: 'atoms', name: 'Atoms', examples: 'Button, Input, Avatar' },
  { id: 'molecules', name: 'Molecules', examples: 'SearchBar, DatePicker' },
  { id: 'organisms', name: 'Organisms', examples: 'Passcode' },
  { id: 'templates', name: 'Templates', examples: 'Scaffold, AppBar' },
  { id: 'blocks', name: 'Blocks', examples: 'Onboarding, Profile' },
];

const line = 'block h-1 rounded-full bg-fd-muted-foreground/30';
const strong = 'block h-1 rounded-full bg-fd-foreground/70';
const solid = 'rounded-[3px] bg-fd-foreground';
const box = 'rounded-[4px] border border-fd-border bg-fd-background';
const dashed = 'rounded-[3px] border border-dashed border-fd-muted-foreground/50';
const phone = 'flex h-[76px] w-[46px] flex-col gap-1 overflow-hidden rounded-[8px] border border-fd-border bg-fd-background p-1';
---

<ol class="not-prose my-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5" aria-label="Component levels">
  {levels.map((level, index) => (
    <li class="group flex flex-col overflow-hidden rounded-lg border bg-fd-card text-fd-card-foreground">
      <div class="atomic-panel relative flex h-28 items-center justify-center overflow-hidden border-b" aria-hidden="true">
        <span class="absolute left-0 top-0 flex size-8 items-center justify-center rounded-br-lg bg-fd-foreground text-sm font-semibold tabular-nums leading-none text-fd-background">
          {index + 1}
        </span>
        <span class="relative flex h-[76px] w-[76px] items-center justify-center">
          {level.id === 'atoms' && (
            <span class="flex flex-col items-center gap-2">
              <span class="flex items-center gap-1.5">
                <span class="size-4 rounded-full bg-fd-foreground/70" />
                <span class={`flex h-4 w-10 items-center justify-center ${solid}`}><span class="block h-1 w-5 rounded-full bg-fd-background/80" /></span>
              </span>
              <span class={`flex h-4 w-[60px] items-center px-1.5 ${box}`}><span class={`${line} w-5`} /></span>
            </span>
          )}
          {level.id === 'molecules' && (
            <span class={`flex h-7 w-[70px] items-center gap-1.5 px-1.5 ${box}`}>
              <span class="size-3 shrink-0 rounded-full border-[1.5px] border-fd-muted-foreground" />
              <span class={`${line} flex-1`} />
              <span class={`flex h-4 w-5 shrink-0 items-center justify-center ${solid}`}><span class="block h-0.5 w-2.5 rounded-full bg-fd-background/80" /></span>
            </span>
          )}
          {level.id === 'organisms' && (
            <span class={`flex w-[70px] flex-col items-center gap-2 p-2 ${box}`}>
              <span class="flex gap-1">{[0, 1, 2, 3].map((i) => <span class={`size-2 rounded-full ${i < 2 ? 'bg-fd-foreground/70' : 'border border-fd-muted-foreground/60'}`} />)}</span>
              <span class="grid grid-cols-3 gap-1">{Array.from({ length: 9 }).map(() => <span class="block h-2.5 w-3.5 rounded-[2px] bg-fd-muted-foreground/25" />)}</span>
            </span>
          )}
          {level.id === 'templates' && (
            <span class={phone}>
              <span class={`h-2.5 shrink-0 ${dashed}`} />
              <span class={`flex-1 ${dashed}`} />
              <span class={`h-3 shrink-0 ${dashed}`} />
            </span>
          )}
          {level.id === 'blocks' && (
            <span class={phone}>
              <span class="flex h-2.5 shrink-0 items-center justify-center"><span class={`${strong} w-5`} /></span>
              <span class="mx-auto size-4 shrink-0 rounded-full bg-fd-muted-foreground/40" />
              <span class="flex flex-1 flex-col gap-1 px-0.5 pt-0.5"><span class={line} /><span class={`${line} w-2/3`} /></span>
              <span class={`h-3 shrink-0 ${solid}`} />
            </span>
          )}
        </span>
      </div>
      <div class="flex flex-col gap-0.5 p-3">
        <span class="text-sm font-medium leading-5">{level.name}</span>
        <span class="text-xs text-fd-muted-foreground">{level.examples}</span>
      </div>
    </li>
  ))}
</ol>

<style>
  .atomic-panel {
    background-color: color-mix(in oklab, var(--color-fd-muted) 60%, transparent);
    background-image: radial-gradient(
      currentColor 1px,
      transparent 1px
    );
    background-size: 8px 8px;
    background-position: -1px -1px;
    color: color-mix(in oklab, var(--color-fd-muted-foreground) 14%, transparent);
  }
</style>
