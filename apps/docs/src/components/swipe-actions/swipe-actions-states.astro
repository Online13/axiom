---
// Five frozen frames of one row with swipe actions: two trailing actions (48pt here), one leading action (28pt).
// The dashed line is half the trailing width: released past it, the row opens; before it, the row closes.
import TokenFrame from '@/components/tokens/token-frame.astro';

const trailing = 48;
const leading = 28;

const states = [
  { label: 'closed', x: 0, caption: 'At rest. The actions wait under the row.' },
  { label: 'dragging', x: -18, caption: 'Follows the finger. Released here, it closes.' },
  { label: 'open', x: -trailing, caption: 'Past half, or a fast flick: snaps open.' },
  { label: 'over-drag', x: -62, caption: 'Past the actions, it resists. The buttons stretch.' },
  { label: 'leading', x: leading, caption: 'The other way reveals the leading action.' },
] as const;
---

<TokenFrame>
  <div class="grid min-w-[40rem] grid-cols-5 gap-px bg-fd-border">
    {
      states.map(({ label, x, caption }) => (
        <div class="flex flex-col gap-3 bg-fd-card p-3">
          <div class="relative flex h-[9rem] flex-col justify-center overflow-hidden rounded-md border bg-fd-card">
            {[0, 1, 2].map((i) => (
              <div class="relative h-9 overflow-hidden border-b last:border-b-0">
                {i === 1 && x < 0 && (
                  <div class="absolute inset-y-0 right-0 flex" style={`width:${Math.max(trailing, -x)}px`}>
                    <span class="flex-1 bg-amber-500" />
                    <span class="flex-1 bg-purple-500" />
                  </div>
                )}
                {i === 1 && x > 0 && <div class="absolute inset-y-0 left-0 bg-blue-500" style={`width:${Math.max(leading, x)}px`} />}
                <div
                  class:list={['absolute inset-0 flex items-center gap-2 bg-fd-card px-2', i === 1 && x !== 0 && 'shadow-[0_0_0_1px_var(--color-fd-border)]']}
                  style={i === 1 ? `transform:translateX(${x}px)` : undefined}
                >
                  <span class="size-4 flex-none rounded-full bg-fd-muted" />
                  <span class="h-1.5 flex-1 rounded-full bg-fd-muted" />
                </div>
              </div>
            ))}
            <span class="absolute inset-y-0 border-l border-dashed border-blue-500" style={`right:${trailing / 2}px`} />
          </div>
          <div class="font-mono text-xs">
            <div>{label}</div>
            <div class="text-fd-muted-foreground">translateX {x}</div>
          </div>
          <p class="text-xs text-fd-muted-foreground">{caption}</p>
        </div>
      ))
    }
  </div>
</TokenFrame>
