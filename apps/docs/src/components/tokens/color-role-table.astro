---
import TokenFrame from './token-frame.astro';
import { colorRoles, resolveColor, type ColorRole } from '@/lib/tokens';

interface Props {
  role: ColorRole;
}

const { role } = Astro.props;
const schemes = ['light', 'dark'] as const;
---

<TokenFrame>
  <div class="divide-y min-w-[42rem]">
    <div class="grid gap-4 px-4 py-2 font-mono text-[0.7rem] text-fd-muted-foreground" style="grid-template-columns: 11.5rem 1fr 9rem 9rem;">
      <div>key</div>
      <div>usage</div>
      <div>light</div>
      <div>dark</div>
    </div>
    {
      Object.entries(colorRoles[role]).map(([key, entry]) => (
        <div class="grid items-center gap-4 px-4 py-3" style="grid-template-columns: 11.5rem 1fr 9rem 9rem;">
          <div class="font-mono text-xs">{role}.{key}</div>
          <div class="text-sm text-fd-muted-foreground">{entry.usage}</div>
          {schemes.map((scheme) => (
            <div class="flex items-center gap-2">
              <div class="size-8 shrink-0 border" style={`background:${resolveColor(entry[scheme])}`} title={resolveColor(entry[scheme])} />
              <div class="flex flex-col font-mono text-[0.65rem] leading-tight">
                <span>{entry[scheme]}</span>
                {!entry[scheme].startsWith('#') && <span class="text-fd-muted-foreground">{resolveColor(entry[scheme])}</span>}
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</TokenFrame>
