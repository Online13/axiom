---
import TokenFrame from './token-frame.astro';
import { sizes } from '@/lib/tokens';

const shapes: Record<keyof typeof sizes, string> = {
  icon: '',
  avatar: 'rounded-full',
  control: '',
};
---

<TokenFrame>
  <div class="divide-y">
    {
      (Object.keys(sizes) as (keyof typeof sizes)[]).map((group) => (
        <div class="flex flex-wrap items-end gap-8 px-4 py-4">
          <div class="font-mono text-xs w-14 self-center">{group}</div>
          {Object.entries(sizes[group]).map(([key, value]) => (
            <div class="flex flex-col items-center gap-2">
              <div
                class:list={['bg-fd-foreground', shapes[group]]}
                style={group === 'control' ? `height:${value}px;width:${value * 2.5}px` : `height:${value}px;width:${value}px`}
              />
              <div class="font-mono text-xs">
                {key} <span class="text-fd-muted-foreground">{value}</span>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</TokenFrame>
