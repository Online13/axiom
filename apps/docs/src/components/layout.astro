---
import { ClientRouter } from 'astro:transitions';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <!--
      Paints the stored theme before first render so the page never flashes the wrong one.
      next-themes (inside RootProvider) owns the `theme` key once React hydrates; this only
      replays it, and again after each view transition, since a swap resets <html>.
    -->
    <script is:inline>
      (() => {
        const apply = () => {
          const stored = localStorage.getItem('theme');
          const dark =
            stored === 'dark' ||
            (stored !== 'light' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);

          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        };

        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body
    class="flex flex-col min-h-screen"
    transition:persist
    transition:animate="none"
    transition:name="page-layout"
  >
    <slot />
  </body>
</html>
